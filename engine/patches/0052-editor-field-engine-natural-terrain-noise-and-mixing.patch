+int main()
+{
+  TestDeterminism();
+  TestWorldPosition();
+  TestAmplitude();
+  TestMix();
+  TestKeepSide();
+  TestLattice();
+  TestIsotropy();
+  TestFractalOptions();
+  TestLegacyUnchanged();
+  if (gFailures == 0) std::printf("EdLandTest PASS\n");
+  else std::printf("EdLandTest FAIL (%d)\n", gFailures);
+  return gFailures == 0 ? 0 : 1;
+}
