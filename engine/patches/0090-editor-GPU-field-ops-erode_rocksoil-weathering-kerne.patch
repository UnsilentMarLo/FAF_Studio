+NUMTHREADS(16, 16, 1)
+void CSMain(KERNEL_IDS)
+{
+    if (dtid.x >= P.w || dtid.y >= P.h) return;
+    uint i = dtid.y * P.w + dtid.x;
+    float d = P.weather * exp(-soil[i] / P.depth0);
+    rock[i] = rock[i] - d;
+    soil[i] = soil[i] + d;
+}
