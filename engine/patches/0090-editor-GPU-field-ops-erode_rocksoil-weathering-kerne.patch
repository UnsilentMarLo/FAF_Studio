 } // namespace moho::editor::gpu::hk
 
 namespace moho::editor::gpu
@@ -188,10 +190,93 @@ namespace moho::editor::gpu
       return OpResult::Done;
     }
 
+    // ---- erode_rocksoil -----------------------------------------------------------------------------------------------------------------------------
+
+    OpResult OpRockSoilGpu(Executor& ex, const OpArgs& a, Grid& out, std::string& err)
+    {
+      const Grid* src = Source(a);
+      const Grid* soil0 = In(a, "b");
+      if (src == nullptr || (soil0 != nullptr && !soil0->SameShape(*src))) return OpResult::Unsupported;
+      const std::string want = a.p.S("output", "height");
+      if (want != "height" && want != "soil" && want != "rock" && want != "moved") return OpResult::Unsupported;
+      const int iterations = ItersOf(a, 60);
+      if (iterations == 0) return OpResult::Unsupported;
+      const int w = src->w, h = src->h;
+      const std::size_t n = src->Count();
+      if (!Fits(ex, n, 14)) return OpResult::Unsupported;
+      const KernelInfo* kw = FindKernel("field_weather");
+      if (kw == nullptr) { err = "kernel field_weather is missing"; return OpResult::Failed; }
+      const float weather = std::max(0.0f, static_cast<float>(a.p.N("weather", 0.01)));
+      const float depth0 = std::max(1e-3f, static_cast<float>(a.p.N("depth0", 1.0)));
+      const float soilTalus = std::max(0.0f, static_cast<float>(a.p.N("soil_talus", 0.35)));
+      const float rockTalus = std::max(0.0f, static_cast<float>(a.p.N("rock_talus", 1.2)));
+      const int rockEvery = std::max(1, static_cast<int>(a.p.N("rock_every", 4)));
+      const float rate = std::max(0.0f, std::min(1.0f, static_cast<float>(a.p.N("rate", 0.5))));
+      const float vis = std::max(1e-3f, static_cast<float>(a.p.N("rock_vis", 0.4)));
+      const float soilConst = static_cast<float>(a.p.N("soil", 0.8));
+      std::vector<float> soilV(n), rockV(n);
+      for (std::size_t i = 0; i < n; ++i) {
+        soilV[i] = std::max(0.0f, soil0 != nullptr ? soil0->v[i] : soilConst);
+        rockV[i] = src->v[i] - soilV[i];
+      }
+      PingPong soil, rock;
+      Field lost;
+      if (!MakeField(ex, w, h, soil.f[0], err) || !MakeField(ex, w, h, soil.f[1], err) || !MakeField(ex, w, h, rock.f[0], err) || !MakeField(ex, w, h, rock.f[1], err) ||
+          !UploadField(ex, soil.f[0], soilV.data(), err) || !UploadField(ex, rock.f[0], rockV.data(), err) || !MakeField(ex, w, h, lost, err) || !FillBuffer(ex, lost.R(), 0u, err)) {
+        return OpResult::Failed;
+      }
+      Slider onSoil, onRock;   // the soil slides over the rock (surface = rock + soil, capped by the soil), the rock as a layer of its own
+      if (!onSoil.Init(ex, w, h, err) || !onRock.Init(ex, w, h, err)) return OpResult::Failed;
+      onSoil.p.cell = onRock.p.cell = src->cell;
+      onSoil.p.rate = onRock.p.rate = rate;
+      onSoil.p.talus = soilTalus;
+      onSoil.p.hasRock = 1;
+      onSoil.p.hasLost = 1;
+      onSoil.lost = &lost.R();
+      onRock.p.talus = rockTalus;
+      hk::WeatherParams wp{};
+      wp.w = static_cast<std::uint32_t>(w);
+      wp.h = static_cast<std::uint32_t>(h);
+      wp.weather = weather;
+      wp.depth0 = depth0;
+      const bool ok = RunIterations(ex, static_cast<u32>(iterations), 60.0, [&](const u32 it, std::string& e) {
+        Bindings b;
+        b.Uav(0, rock.Src().R()).Uav(1, soil.Src().R());
+        if (!DispatchGrid(ex, *kw, wp.w, wp.h, wp, b, e)) return false;
+        onSoil.rock = &rock.Src().R();
+        if (!onSoil.Step(ex, soil.Src().R(), soil.Dst().R(), e)) return false;
+        soil.Flip();
+        if (rockTalus > 0.0f && (it % static_cast<u32>(rockEvery)) == static_cast<u32>(rockEvery) - 1u) {
+          if (!onRock.Step(ex, rock.Src().R(), rock.Dst().R(), e)) return false;
+          rock.Flip();
+        }
+        return true;
+      }, err);
+      if (!ok) return OpResult::Failed;
+      Grid gSoil = LikeOf(*src), gRock = LikeOf(*src), gLost = LikeOf(*src);
+      if (!DownloadGrid(ex, soil.Src(), gSoil, err) || !DownloadGrid(ex, rock.Src(), gRock, err) || !DownloadGrid(ex, lost, gLost, err)) return OpResult::Failed;
+      std::map<std::string, Grid> all;
+      all["height"] = LikeOf(*src);
+      all["soil"] = LikeOf(*src);
+      all["rock"] = LikeOf(*src);
+      all["moved"] = LikeOf(*src);
+      for (std::size_t i = 0; i < n; ++i) {
+        all["height"].v[i] = gRock.v[i] + gSoil.v[i];
+        all["soil"].v[i] = gSoil.v[i];
+        all["rock"].v[i] = 1.0f - field::t7::SmoothStep(0.0f, vis, gSoil.v[i]);
+        all["moved"].v[i] = Clamp01(gLost.v[i]);
+      }
+      Grid result;
+      if (!Emit(a, result, all, "height")) return OpResult::Unsupported;
+      out = std::move(result);
+      return OpResult::Done;
+    }
+
     struct Registrar
     {
       Registrar()
       {
+        RegisterGpuOp("erode_rocksoil", &OpRockSoilGpu, 16384.0f);
         RegisterGpuOp("settle", &OpSettleGpu, 16384.0f);
         RegisterGpuOp("thermal_map", &OpThermalMapGpu, 16384.0f);
       }
diff --git a/src/sdk/moho/editor/EdGpuShaders.generated.h b/src/sdk/moho/editor/EdGpuShaders.generated.h
index 47386d4..438a876 100644
--- a/src/sdk/moho/editor/EdGpuShaders.generated.h
+++ b/src/sdk/moho/editor/EdGpuShaders.generated.h
@@ -3985,6 +3985,73 @@ void CSMain(KERNEL_IDS)
     dst[i] = c + amt * d;
 }
 
+)HLSL";
+
+  // field_weather: 16x16x1 threads
+  inline constexpr char kSource_field_weather[] =
+    R"HLSL(// HLSL side of the kernel language (docs/projects/editor/GPU_COMPUTE.md). scripts/gen_gpu_shaders.py puts this file in front of every kernel it embeds; the C++ test shim
+// (hlsl_cpp_shim.h) defines the SAME macro names for g++ / MSVC. A kernel therefore never writes cbuffer, register(), StructuredBuffer, [numthreads], SV_ or groupshared itself.
+//
+// Resource slots: constant buffer b0 (one per kernel), shader resource views t0..t15, unordered access views u0..u7, samplers s0 (linear, clamp) and s1 (point, clamp).
+// The SRV slot numbers are shared between buffers and textures (SRV_BUFFER(.., 0) and SRV_TEX(.., 0) would collide), the same for UAVs.
+
+#define CBUFFER(Type, name, slot) cbuffer name##_cb : register(b##slot) { Type name; };
+#define SRV_BUFFER(T, name, slot) StructuredBuffer<T> name : register(t##slot);
+#define UAV_BUFFER(T, name, slot) RWStructuredBuffer<T> name : register(u##slot);
+#define SRV_TEX(name, slot) Texture2D<float> name : register(t##slot);
+#define UAV_TEX(name, slot) RWTexture2D<float> name : register(u##slot);
+#define SAMPLER(name, slot) SamplerState name : register(s##slot);
+#define GROUPSHARED(T, name, n) groupshared T name[n];
+#define NUMTHREADS(x, y, z) [numthreads(x, y, z)]
+#define KERNEL_IDS uint3 dtid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID, uint gidx : SV_GroupIndex
+
+// Kernels with group shared memory split their body into phases at top level: PHASES_BEGIN, code, BARRIER(); code, ..., PHASES_END. Every phase is its own scope (a local does not
+// live across a BARRIER, on the GPU as in the emulation).
+#define PHASES_BEGIN {
+#define BARRIER() GroupMemoryBarrierWithGroupSync(); } {
+#define PHASES_END }
+
+#define UNROLL [unroll]
+#define LOOP [loop]
+#define OUT(T) out T
+#define INOUT(T) inout T
+#define FN
+
+// Op erode_rocksoil (EdFieldEro2.cpp OpRockSoil), the weathering step: d = weather * exp(-soil / depth0); rock -= d; soil += d (in place, one thread per cell).
+// ---- begin field_weather_params.hlsli
+// Constant buffer of field_weather.hlsl (op erode_rocksoil).
+#ifndef GPU_FIELD_WEATHER_PARAMS_HLSLI
+#define GPU_FIELD_WEATHER_PARAMS_HLSLI
+
+struct WeatherParams
+{
+    uint w;
+    uint h;
+    uint pad0;
+    uint pad1;
+    float weather;   // rock weathered per step at no soil cover
+    float depth0;    // soil depth at which the weathering has dropped to 1/e
+    float pad2;
+    float pad3;
+};
+
+#endif
+// ---- end field_weather_params.hlsli
+
+CBUFFER(WeatherParams, P, 0)
+UAV_BUFFER(float, rock, 0)
+UAV_BUFFER(float, soil, 1)
+
+NUMTHREADS(16, 16, 1)
+void CSMain(KERNEL_IDS)
+{
+    if (dtid.x >= P.w || dtid.y >= P.h) return;
+    uint i = dtid.y * P.w + dtid.x;
+    float d = P.weather * exp(-soil[i] / P.depth0);
+    rock[i] = rock[i] - d;
+    soil[i] = soil[i] + d;
+}
+
 )HLSL";
 
   // filt_bilateral: 16x16x1 threads
@@ -8764,6 +8831,7 @@ void CSMain(KERNEL_IDS)
     {"field_slopescan", kSource_field_slopescan, "CSMain", 64u, 1u, 1u, 0x1u, 0x1u, 0x0u, 0x0u, 0x0u, 1u, 0x4DB2A8E0930B861FULL},
     {"field_sub", kSource_field_sub, "CSMain", 16u, 16u, 1u, 0x3u, 0x1u, 0x0u, 0x0u, 0x0u, 1u, 0x101759797F1D7EACULL},
     {"field_unsharp", kSource_field_unsharp, "CSMain", 16u, 16u, 1u, 0x7u, 0x1u, 0x0u, 0x0u, 0x0u, 1u, 0x51536C353B56C1BDULL},
+    {"field_weather", kSource_field_weather, "CSMain", 16u, 16u, 1u, 0x0u, 0x3u, 0x0u, 0x0u, 0x0u, 1u, 0xD84A62CAB2D4E35CULL},
     {"filt_bilateral", kSource_filt_bilateral, "CSMain", 16u, 16u, 1u, 0xEu, 0x1u, 0x0u, 0x0u, 0x0u, 1u, 0x6B226CC7B6F8A9DFULL},
     {"filt_blurdir", kSource_filt_blurdir, "CSMain", 16u, 16u, 1u, 0xEu, 0x1u, 0x0u, 0x0u, 0x0u, 1u, 0x7E0FBD4C9A05041EULL},
     {"filt_diffuse", kSource_filt_diffuse, "CSMain", 16u, 16u, 1u, 0x6u, 0x1u, 0x0u, 0x0u, 0x0u, 1u, 0x40DC1A1D6642A2D3ULL},
@@ -8784,5 +8852,5 @@ void CSMain(KERNEL_IDS)
     {"scale_offset", kSource_scale_offset, "CSMain", 64u, 1u, 1u, 0x1u, 0x1u, 0x0u, 0x0u, 0x0u, 1u, 0x69153DA09D05A533ULL},
     {"tex_resample", kSource_tex_resample, "CSMain", 16u, 16u, 1u, 0x1u, 0x1u, 0x1u, 0x0u, 0x1u, 1u, 0x437363328542E729ULL},
   };
-  inline constexpr int kKernelCount = 45;
+  inline constexpr int kKernelCount = 46;
 } // namespace moho::editor::gpu::shaders
