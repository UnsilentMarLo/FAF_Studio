Subject: [PATCH] editor natives: normal_map field op (the engine's
 CHeightField::GetNormal as three 0..1 fields, shift/span/strength/signed) +
 property tests

Feeds the graph's Height to normal map node and the map-wide normal map texture (maptextures.lua).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01F37er45a7etRuMgEW1q3kY

diff --git a/src/sdk/moho/editor/EdFieldFilt.cpp b/src/sdk/moho/editor/EdFieldFilt.cpp
index 3c65fb3..701ac50 100644
--- a/src/sdk/moho/editor/EdFieldFilt.cpp
+++ b/src/sdk/moho/editor/EdFieldFilt.cpp
@@ -19,6 +19,9 @@
 //                and hi) | twi (raw) | area (log scale of the catchment), smooth (sigma, units).
 //   rockiness    a, optional b (soil thickness, units). Where bare rock shows: slope (slope_lo .. slope_hi degrees), convexity (radius, gain) and thin soil (soil_full units); weights w_slope,
 //                w_convex, w_soil; breakup (noise amplitude), seed.
+//   normal_map   a (heights). The map normal of the engine (CHeightField::GetNormal: (left - right, 1, top - bottom) normalized, the samples half a unit either side) as three fields in the range
+//                0..1 (n * 0.5 + 0.5, what the terrain's own normal map stores): x is the result, y and z come back as the extra outputs. span (units between the two samples of a difference),
+//                strength (scales the slope), shift (units added to the sample positions; the result's origin moves with it: 0.5 puts the samples at the centres of the map squares like the engine's normal map), signed (-1..1 instead).
 //   color_ramp   a (a mask). A gradient map: `stops` = 5 numbers per stop (position, r, g, b, a, all 0..1), positions sorted by the op; lo / hi map the input onto 0..1; interp linear | smooth |
 //                step. The result is the red channel; green, blue and alpha come back as the extra outputs g, b, a.
 //
@@ -560,6 +563,44 @@ namespace moho::editor::field
       return true;
     }
 
+    // ---- normal_map ------------------------------------------------------------------------------------------------------------------------------
+
+    bool OpNormalMap(const OpArgs& a, Grid& out, std::string& err)
+    {
+      const Grid* src = Need(a, "a", err);
+      if (src == nullptr || !MakeOut(a, out, err)) return false;
+      const float span = std::max(0.05f, static_cast<float>(a.p.N("span", 1.0)));
+      const float strength = static_cast<float>(a.p.N("strength", 1.0));
+      const float shiftUnits = static_cast<float>(a.p.N("shift", 0.0));
+      const float shift = shiftUnits / src->cell;
+      out.ox = src->ox + shiftUnits;                   // the result lies where it was computed
+      out.oz = src->oz + shiftUnits;
+      const bool raw = a.p.N("signed", 0.0) != 0.0;
+      const float half = 0.5f * span / src->cell;      // samples either side of the point
+      const float scale = strength / span;             // slope (rise per run) from a difference over `span`
+      Grid Y(out.w, out.h, out.cell, out.ox, out.oz), Z = Y;
+      Rows(out.h, [&](const int z0, const int z1) {
+        for (int z = z0; z < z1; ++z) {
+          for (int x = 0; x < out.w; ++x) {
+            const float fx = static_cast<float>(x) + shift, fz = static_cast<float>(z) + shift;
+            const float left = BilinearC(*src, fx - half, fz), right = BilinearC(*src, fx + half, fz);
+            const float top = BilinearC(*src, fx, fz - half), bottom = BilinearC(*src, fx, fz + half);
+            const float nx = (left - right) * scale, nz = (top - bottom) * scale;
+            const float inv = 1.0f / std::sqrt(nx * nx + 1.0f + nz * nz);
+            const float ex = nx * inv, ey = inv, ez = nz * inv;
+            out.At(x, z) = raw ? ex : ex * 0.5f + 0.5f;
+            Y.At(x, z) = raw ? ey : ey * 0.5f + 0.5f;
+            Z.At(x, z) = raw ? ez : ez * 0.5f + 0.5f;
+          }
+        }
+      });
+      if (a.extra != nullptr) {
+        (*a.extra)["y"] = std::move(Y);
+        (*a.extra)["z"] = std::move(Z);
+      }
+      return true;
+    }
+
     // ---- wetness ---------------------------------------------------------------------------------------------------------------------------------
 
     bool OpWetness(const OpArgs& a, Grid& out, std::string& err)
@@ -728,6 +769,7 @@ namespace moho::editor::field
         RegisterOp("stratify", &OpStratify);
         RegisterOp("occlusion", &OpOcclusion);
         RegisterOp("hillshade", &OpHillshade);
+        RegisterOp("normal_map", &OpNormalMap);
         RegisterOp("wetness", &OpWetness);
         RegisterOp("rockiness", &OpRockiness);
         RegisterOp("color_ramp", &OpColorRamp);
diff --git a/src/sdk/moho/editor/tests/EdT7Properties.inc b/src/sdk/moho/editor/tests/EdT7Properties.inc
index f59f901..1af22e5 100644
--- a/src/sdk/moho/editor/tests/EdT7Properties.inc
+++ b/src/sdk/moho/editor/tests/EdT7Properties.inc
@@ -266,6 +266,45 @@ static void PropAnalysis()
     const GridPtr full = Run("hillshade", "azimuth=300,altitude=35,shadows=1", {{"a", T}});
     CHECK(InRange(*full, 0.0f, 1.0f), "hillshade range");
   }
+  {
+    // normal_map: the engine's GetNormal (left - right, 1, top - bottom) encoded as n * 0.5 + 0.5; flat ground is (0.5, 1, 0.5)
+    std::map<std::string, Grid> ex;
+    const GridPtr flatN = Run("normal_map", "", {{"a", L}}, &ex);
+    CHECK(std::fabs(flatN->At(10, 10) - 0.5f) < 1e-6f && std::fabs(ex["z"].At(10, 10) - 0.5f) < 1e-6f && std::fabs(ex["y"].At(10, 10) - 1.0f) < 1e-6f, "flat normal (%g %g %g)", flatN->At(10, 10), ex["y"].At(10, 10), ex["z"].At(10, 10));
+    // a plane rising 0.5 per unit towards +x: the normal leans towards -x, nx = -0.5 / sqrt(1.25)
+    Grid ramp = *Run("const", "width=65,height=65,value=0");
+    for (int z = 0; z < 65; ++z) for (int x = 0; x < 65; ++x) ramp.At(x, z) = 0.5f * static_cast<float>(x) + 0.25f * static_cast<float>(z);
+    const GridPtr rp = std::make_shared<Grid>(ramp);
+    std::map<std::string, Grid> ex2;
+    const GridPtr nx = Run("normal_map", "", {{"a", rp}}, &ex2);
+    const float len = std::sqrt(0.25f + 1.0f + 0.0625f);
+    CHECK(std::fabs(nx->At(30, 30) - (-0.5f / len * 0.5f + 0.5f)) < 1e-4f, "plane nx %g", nx->At(30, 30));
+    CHECK(std::fabs(ex2["z"].At(30, 30) - (-0.25f / len * 0.5f + 0.5f)) < 1e-4f, "plane nz %g", ex2["z"].At(30, 30));
+    CHECK(std::fabs(ex2["y"].At(30, 30) - (1.0f / len * 0.5f + 0.5f)) < 1e-4f, "plane ny %g", ex2["y"].At(30, 30));
+    // strength scales the slope, signed gives -1..1, the encoded vector is a unit vector
+    std::map<std::string, Grid> ex3;
+    const GridPtr sg = Run("normal_map", "signed=1,strength=2", {{"a", rp}}, &ex3);
+    const float len2 = std::sqrt(1.0f + 1.0f + 0.25f);
+    CHECK(std::fabs(sg->At(30, 30) - (-1.0f / len2)) < 1e-4f, "strength 2 signed nx %g", sg->At(30, 30));
+    const float ux = nx->At(20, 40) * 2.0f - 1.0f, uy = ex2["y"].At(20, 40) * 2.0f - 1.0f, uz = ex2["z"].At(20, 40) * 2.0f - 1.0f;
+    CHECK(std::fabs(ux * ux + uy * uy + uz * uz - 1.0f) < 1e-4f, "unit length (%g)", ux * ux + uy * uy + uz * uz);
+    // span 4 on a plane gives the same slope per unit; the range is 0..1 on rough ground
+    const GridPtr wide = Run("normal_map", "span=4", {{"a", rp}});
+    CHECK(std::fabs(wide->At(30, 30) - nx->At(30, 30)) < 1e-4f, "span does not change a plane (%g vs %g)", wide->At(30, 30), nx->At(30, 30));
+    CHECK(InRange(*Run("normal_map", "shift=0.5", {{"a", T}}), 0.0f, 1.0f), "normal_map range");
+    // shift 0.5 on a plane: the same normal (the plane is linear), on a bump it moves the samples by half a unit
+    const GridPtr sh5 = Run("normal_map", "shift=0.5", {{"a", rp}});
+    CHECK(std::fabs(sh5->At(30, 30) - nx->At(30, 30)) < 1e-4f, "shift on a plane");
+    CHECK(sh5->ox == 0.5f && sh5->oz == 0.5f && nx->ox == 0.0f, "shift moves the origin (%g, %g)", sh5->ox, sh5->oz);
+    // on a bump the shifted result is the unshifted normal sampled half a unit further: nx(x) with shift 0.5 equals the engine's quad normal (h(x) - h(x + 1)) at the square (x, z)
+    Grid bump = *Run("const", "width=33,height=33,value=0");
+    for (int z = 0; z < 33; ++z) for (int x = 0; x < 33; ++x) bump.At(x, z) = 0.1f * static_cast<float>((x - 16) * (x - 16));
+    const GridPtr bp = std::make_shared<Grid>(bump);
+    const GridPtr sq = Run("normal_map", "shift=0.5,signed=1", {{"a", bp}});
+    const float slope = (bump.At(10, 8) + bump.At(10, 9)) * 0.5f - (bump.At(11, 8) + bump.At(11, 9)) * 0.5f;     // left - right over the square (10, 8): both rows are equal here, so the mean of the two rows
+    const float eq = slope / std::sqrt(slope * slope + 1.0f);
+    CHECK(std::fabs(sq->At(10, 8) - eq) < 1e-4f, "square normal %g expected %g", sq->At(10, 8), eq);
+  }
   {
     // wetness: a V valley is wetter along the floor than on its sides, and the catchment grows downhill
     GridPtr v = Run("gradient", "width=65,height=65,angle=0,lo=-1,hi=1");
