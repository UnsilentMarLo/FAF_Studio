+// Stand-alone test of the field engine core (no engine needed).
+//   build + run: python scripts/ed_native_tests.py          (extra arguments after the exe name are passed through by `python scripts/ed_native_tests.py -- <args>`)
+//   EdFieldTest.exe <cases.lua> [--update]      the golden cases live in editor/runtime/lua/editor/selftest_fields_cases.lua (shared with the Lua self test);
+//                                               --update rewrites the golden column from this run
+//   EdFieldTest.exe <cases.lua> --bench         timings on a 1025 x 1025 map
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "moho/editor/EdFieldCore.h"
+
+using namespace moho::editor::field;
+
+static int gFailures = 0;
+static int gDefaultThreads = 1;
+#define CHECK(cond, ...)                               \
+  do {                                                 \
+    if (!(cond)) {                                     \
+      ++gFailures;                                     \
+      std::printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+      std::printf(__VA_ARGS__);                        \
+      std::printf("\n");                               \
+    }                                                  \
+  } while (0)
+
+static std::string Hex(const std::uint64_t v)
+{
+  char b[32];
+  std::snprintf(b, sizeof(b), "%016llx", static_cast<unsigned long long>(v));
+  return b;
+}
+
+// ---- param strings: k=v,k=v ; v is a number, a word, or a list a:b;c:d (flattened) ------------------------------------------------------------------
+
+static std::vector<std::string> Split(const std::string& s, const char sep)
+{
+  std::vector<std::string> out;
+  std::string cur;
+  for (const char c : s) {
+    if (c == sep) {
+      out.push_back(cur);
+      cur.clear();
+    } else {
+      cur.push_back(c);
+    }
+  }
+  out.push_back(cur);
+  return out;
+}
+
+static bool ToNumber(const std::string& s, double& v)
+{
+  if (s.empty()) return false;
+  char* end = nullptr;
+  v = std::strtod(s.c_str(), &end);
+  return end != nullptr && *end == '\0';
+}
+
+static void ParseParams(const std::string& text, Params& p)
+{
+  if (text.empty()) return;
+  for (const std::string& kv : Split(text, ',')) {
+    const std::size_t eq = kv.find('=');
+    if (eq == std::string::npos) continue;
+    const std::string key = kv.substr(0, eq);
+    const std::string val = kv.substr(eq + 1);
+    double n = 0.0;
+    if (val.find(':') != std::string::npos || val.find(';') != std::string::npos) {
+      std::vector<double> flat;
+      for (const std::string& pt : Split(val, ';')) {
+        for (const std::string& c : Split(pt, ':')) {
+          if (ToNumber(c, n)) flat.push_back(n);
+        }
+      }
+      p.arr[key] = flat;
+    } else if (ToNumber(val, n)) {
+      p.num[key] = n;
+    } else {
+      p.str[key] = val;
+    }
+  }
+}
+
+static std::map<std::string, GridPtr> gFix;
+
+static GridPtr Make(const std::string& op, const std::string& params, const std::map<std::string, GridPtr>& in, std::string* err = nullptr)
+{
+  OpArgs a;
+  ParseParams(params, a.p);
+  a.in = in;
+  auto g = std::make_shared<Grid>();
+  std::string e;
+  if (!RunOp(op, a, *g, e)) {
+    if (err) *err = e;
+    else std::printf("op %s(%s) failed: %s\n", op.c_str(), params.c_str(), e.c_str());
+    return nullptr;
+  }
+  return g;
+}
+
+static void BuildFixtures()
+{
+  gFix.clear();
+  gFix["A"] = Make("perlin", "width=33,height=33,seed=7,scale=12,octaves=4", {});
+  gFix["H"] = Make("affine", "mul=40,add=10", {{"a", gFix["A"]}});
+  gFix["M"] = Make("voronoi", "width=33,height=33,scale=10,seed=5", {});
+  gFix["N"] = Make("perlin", "width=33,height=33,seed=9,scale=9,octaves=3", {});
+}
+
+struct Case
+{
+  std::string label, op, params, inputs, golden;
+};
+
+static std::vector<std::string> gLines;   // the whole cases file, to rewrite
+static std::vector<Case> gCases;
+static std::size_t gBegin = 0, gEnd = 0;
+
+static bool LoadCases(const std::string& path)
+{
+  std::ifstream in(path, std::ios::binary);
+  if (!in) return false;
+  std::string line;
+  while (std::getline(in, line)) {
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    gLines.push_back(line);
+  }
+  bool inside = false;
+  for (std::size_t i = 0; i < gLines.size(); ++i) {
+    const std::string& l = gLines[i];
+    if (!inside) {
+      if (l.find("Cases = [[") == 0) {
+        inside = true;
+        gBegin = i + 1;
+      }
+      continue;
+    }
+    if (l.find("]]") == 0) {
+      gEnd = i;
+      break;
+    }
+    if (l.empty() || l[0] == '#') continue;
+    const std::vector<std::string> f = Split(l, '|');
+    if (f.size() < 5) continue;
+    gCases.push_back({f[0], f[1], f[2], f[3], f[4]});
+  }
+  return !gCases.empty();
+}
+
+static std::map<std::string, GridPtr> InputsOf(const std::string& spec)
+{
+  std::map<std::string, GridPtr> in;
+  for (const std::string& kv : Split(spec, ',')) {
+    const std::size_t eq = kv.find('=');
+    if (eq != std::string::npos) in[kv.substr(0, eq)] = gFix[kv.substr(eq + 1)];
+  }
+  return in;
+}
+
+// ---- tests ------------------------------------------------------------------------------------------------------------------------------------------
+
+static void TestGoldens(const bool update)
+{
+  const int orig = Threads();
+  const int counts[] = {1, 2, 3, 5, 8};
+  std::vector<std::string> now;
+  for (const int tc : counts) {
+    SetThreads(tc);
+    BuildFixtures();
+    for (std::size_t i = 0; i < gCases.size(); ++i) {
+      const Case& c = gCases[i];
+      std::string err;
+      const GridPtr g = Make(c.op, c.params, InputsOf(c.inputs), &err);
+      if (!g) {
+        CHECK(false, "case %s: %s", c.label.c_str(), err.c_str());
+        if (tc == counts[0]) now.push_back("0");
+        continue;
+      }
+      const std::string hex = Hex(Checksum(*g));
+      if (tc == counts[0]) {
+        now.push_back(hex);
+      } else {
+        CHECK(hex == now[i], "case %s differs with %d threads (%s vs %s)", c.label.c_str(), tc, hex.c_str(), now[i].c_str());
+      }
+    }
+  }
+  SetThreads(orig);
+  int wrong = 0;
+  for (std::size_t i = 0; i < gCases.size(); ++i) {
+    if (gCases[i].golden != now[i]) {
+      ++wrong;
+      if (!update) std::printf("golden %s: file %s, now %s\n", gCases[i].label.c_str(), gCases[i].golden.c_str(), now[i].c_str());
+    }
+  }
+  if (update) {
+    // rewrite the golden column
+    std::size_t ci = 0;
+    for (std::size_t i = gBegin; i < gEnd; ++i) {
+      std::string& l = gLines[i];
+      if (l.empty() || l[0] == '#') continue;
+      std::vector<std::string> f = Split(l, '|');
+      if (f.size() < 5) continue;
+      f[4] = now[ci++];
+      l = f[0] + "|" + f[1] + "|" + f[2] + "|" + f[3] + "|" + f[4];
+    }
+    std::printf("updated %d goldens\n", wrong);
+  } else {
+    CHECK(wrong == 0, "%d goldens differ (run with --update after checking the change is intended)", wrong);
+  }
+}
+
+static GridPtr Run(const char* op, const char* params, std::map<std::string, GridPtr> in = {})
+{
+  GridPtr g = Make(op, params, in);
+  CHECK(g != nullptr, "op %s failed", op);
+  return g ? g : std::make_shared<Grid>(1, 1, 1.0f, 0.0f, 0.0f);
+}
+
+static void TestThreadsLarge()
+{
+  // a longer pipeline on a bigger grid: the result must not depend on the number of threads
+  std::uint64_t first = 0;
+  for (const int tc : {1, 2, 7}) {
+    SetThreads(tc);
+    const GridPtr n = Run("perlin", "width=257,height=257,seed=3,scale=60,octaves=5");
+    const GridPtr h = Run("affine", "mul=60,add=0", {{"a", n}});
+    const GridPtr b = Run("blur", "radius=3", {{"a", h}});
+    const GridPtr t = Run("thermal", "iterations=12,talus=0.5", {{"a", b}});
+    const GridPtr d = Run("distance", "threshold=40", {{"a", t}});
+    const GridPtr s = Run("slope", "mode=rating,window=2", {{"a", t}});
+    const GridPtr m = Run("blend", "mode=overlay,opacity=0.7", {{"a", d}, {"b", s}});
+    const std::uint64_t cs = Checksum(*m);
+    if (tc == 1) first = cs;
+    CHECK(cs == first, "pipeline differs with %d threads", tc);
+  }
+  SetThreads(gDefaultThreads);
+}
+
+static void TestProperties()
+{
+  SetThreads(gDefaultThreads);
+  BuildFixtures();
+
+  // noise: in range, spread, not constant
+  for (const char* op : {"perlin", "simplex", "ridged", "billow"}) {
+    const GridPtr n = Run(op, "width=129,height=129,seed=11,scale=30,octaves=4");
+    const Stats s = Measure(*n);
+    CHECK(s.min >= 0.0f && s.max <= 1.0f, "%s out of 0..1: %f %f", op, s.min, s.max);
+    CHECK(s.sd > 0.03, "%s too flat: sd %f", op, s.sd);
+    std::printf("  %s: min %.3f max %.3f mean %.3f sd %.3f\n", op, s.min, s.max, s.mean, s.sd);
+  }
+  // seeds differ, the same seed repeats, noise depends on the world position and not on the grid origin
+  {
+    const GridPtr a = Run("perlin", "width=40,height=40,seed=1,scale=10");
+    const GridPtr b = Run("perlin", "width=40,height=40,seed=2,scale=10");
+    const GridPtr c = Run("perlin", "width=40,height=40,seed=1,scale=10");
+    CHECK(Checksum(*a) != Checksum(*b), "seeds give the same field");
+    CHECK(Checksum(*a) == Checksum(*c), "same seed differs");
+    const GridPtr big = Run("perlin", "width=60,height=60,seed=1,scale=10");
+    const GridPtr part = Run("crop", "x0=7,z0=5,x1=46,z1=44", {{"a", big}});
+    const GridPtr shifted = Run("perlin", "width=40,height=40,seed=1,scale=10,ox=7,oz=5");
+    float maxd = 0;
+    for (std::size_t i = 0; i < part->Count(); ++i) maxd = std::max(maxd, std::fabs(part->v[i] - shifted->v[i]));
+    CHECK(maxd == 0.0f, "noise depends on the grid origin: %g", maxd);
+    // a coarse preview samples the same noise: the value at world (8, 8) is the same on a 1 unit grid and on a 4 unit grid
+    const GridPtr coarse = Run("perlin", "width=17,height=17,seed=1,scale=10,cell=4");
+    const GridPtr fine = Run("perlin", "width=65,height=65,seed=1,scale=10,cell=1");
+    CHECK(coarse->At(2, 2) == fine->At(8, 8), "preview grid samples different noise");
+  }
+  // simplex range
+  {
+    float lo = 1e9f, hi = -1e9f;
+    const GridPtr n = Run("simplex", "width=1024,height=1024,seed=5,scale=7,octaves=1");   // 0.5 s + 0.5, clamped
+    for (const float v : n->v) { lo = std::min(lo, v); hi = std::max(hi, v); }
+    std::printf("  simplex single octave (0.5 s + 0.5, clamped): %.4f .. %.4f\n", lo, hi);
+    CHECK(hi > 0.9f && lo < 0.1f, "simplex scale is off");
+  }
+  // const / invert / clamp / affine
+  {
+    const GridPtr c = Run("const", "width=5,height=4,value=0.25");
+    CHECK(c->w == 5 && c->h == 4 && c->v[7] == 0.25f, "const");
+    const GridPtr inv = Run("invert", "", {{"a", c}});
+    CHECK(inv->v[3] == 0.75f, "invert");
+    const GridPtr cl = Run("clamp", "lo=0.3,hi=0.9", {{"a", c}});
+    CHECK(cl->v[0] == 0.3f, "clamp");
+  }
+  // blur: a constant stays, spread falls
+  {
+    const GridPtr c = Run("const", "width=30,height=30,value=0.6");
+    const GridPtr b = Run("blur", "radius=3", {{"a", c}});
+    float maxd = 0;
+    for (const float v : b->v) maxd = std::max(maxd, std::fabs(v - 0.6f));
+    CHECK(maxd < 1e-5f, "blur of a constant moved by %g", maxd);
+    const GridPtr n = gFix["N"];
+    const GridPtr nb = Run("blur", "radius=2", {{"a", n}});
+    CHECK(Measure(*nb).sd < Measure(*n).sd, "blur did not reduce the spread");
+    const GridPtr bx = Run("box", "radius=2", {{"a", n}});
+    CHECK(Measure(*bx).sd < Measure(*n).sd, "box did not reduce the spread");
+  }
+  // distance transform against brute force
+  {
+    const GridPtr base = Run("white", "width=21,height=17,seed=4");
+    const GridPtr d = Run("distance", "threshold=0.93", {{"a", base}});
+    bool any = false;
+    float worst = 0;
+    for (int z = 0; z < 17; ++z) {
+      for (int x = 0; x < 21; ++x) {
+        double best = 1e9;
+        for (int zz = 0; zz < 17; ++zz) {
+          for (int xx = 0; xx < 21; ++xx) {
+            if (base->At(xx, zz) > 0.93f) {
+              any = true;
+              best = std::min(best, std::sqrt(double((x - xx) * (x - xx) + (z - zz) * (z - zz))));
+            }
+          }
+        }
+        if (best < 1e8) worst = std::max(worst, std::fabs(float(best) - d->At(x, z)));
+      }
+    }
+    CHECK(any && worst < 1e-4f, "distance transform differs from brute force by %g", worst);
+    const GridPtr sd = Run("distance", "threshold=0.93,mode=signed", {{"a", base}});
+    CHECK(sd->Count() == base->Count(), "signed distance");
+  }
+  // slope on a ramp: 0.5 units per sample
+  {
+    Grid ramp(16, 16, 1.0f, 0.0f, 0.0f);
+    for (int z = 0; z < 16; ++z) for (int x = 0; x < 16; ++x) ramp.At(x, z) = 0.5f * float(x);
+    auto r = std::make_shared<Grid>(ramp);
+    const GridPtr deg = Run("slope", "mode=degrees", {{"a", r}});
+    CHECK(std::fabs(deg->At(8, 8) - 26.5651f) < 0.01f, "slope degrees %f", deg->At(8, 8));
+    const GridPtr rating = Run("slope", "mode=rating,window=1", {{"a", r}});
+    CHECK(std::fabs(rating->At(8, 8) - 0.5f) < 1e-6f, "slope rating %f", rating->At(8, 8));
+    const GridPtr rating3 = Run("slope", "mode=rating,window=3", {{"a", r}});
+    CHECK(std::fabs(rating3->At(4, 4) - 0.5f) < 1e-6f, "slope rating window 3");
+    const GridPtr var = Run("slope", "mode=variation,window=2", {{"a", r}});
+    CHECK(std::fabs(var->At(4, 4) - 1.0f) < 1e-6f, "slope variation %f", var->At(4, 4));
+    // a cell size of 4 makes the same rise per sample a quarter of the slope per world unit
+    auto coarse = std::make_shared<Grid>(ramp);
+    coarse->cell = 4.0f;
+    const GridPtr cr = Run("slope", "mode=rating", {{"a", coarse}});
+    CHECK(std::fabs(cr->At(8, 8) - 0.125f) < 1e-6f, "rating with cell 4: %f", cr->At(8, 8));
+  }
+  // thermal: keeps the total, lowers the steepest slope, a flat field stays flat
+  {
+    const GridPtr h = gFix["H"];
+    const GridPtr t = Run("thermal", "iterations=40,talus=0.3,rate=0.5", {{"a", h}});
+    const double before = Measure(*h).mean;
+    const double after = Measure(*t).mean;
+    CHECK(std::fabs(before - after) < 1e-4, "thermal changed the mean: %f -> %f", before, after);
+    const GridPtr r0 = Run("slope", "mode=rating", {{"a", h}});
+    const GridPtr r1 = Run("slope", "mode=rating", {{"a", t}});
+    CHECK(Measure(*r1).max < Measure(*r0).max, "thermal did not lower the steepest slope: %f -> %f", Measure(*r0).max, Measure(*r1).max);
+    const GridPtr flat = Run("const", "width=20,height=20,value=7");
+    const GridPtr tf = Run("thermal", "iterations=10", {{"a", flat}});
+    CHECK(Checksum(*tf) == Checksum(*flat), "thermal moved a flat field");
+  }
+  // mirror symmetries
+  {
+    const GridPtr h = gFix["H"];
+    const int n = 33;
+    const GridPtr mx = Run("mirror", "mode=x", {{"a", h}});
+    const GridPtr mz = Run("mirror", "mode=z,side=1", {{"a", h}});
+    const GridPtr mxz = Run("mirror", "mode=xz", {{"a", h}});
+    const GridPtr r2 = Run("mirror", "mode=rot2", {{"a", h}});
+    const GridPtr r2b = Run("mirror", "mode=rot2,side=1", {{"a", h}});
+    const GridPtr r4 = Run("mirror", "mode=rot4", {{"a", h}});
+    const GridPtr r4b = Run("mirror", "mode=rot4,side=1", {{"a", h}});
+    const GridPtr dg = Run("mirror", "mode=diag", {{"a", h}});
+    const GridPtr ad = Run("mirror", "mode=adiag,side=1", {{"a", h}});
+    int bad = 0;
+    for (int z = 0; z < n; ++z) {
+      for (int x = 0; x < n; ++x) {
+        if (mx->At(x, z) != mx->At(n - 1 - x, z)) ++bad;
+        if (mz->At(x, z) != mz->At(x, n - 1 - z)) ++bad;
+        if (mxz->At(x, z) != mxz->At(n - 1 - x, z) || mxz->At(x, z) != mxz->At(x, n - 1 - z)) ++bad;
+        if (r2->At(x, z) != r2->At(n - 1 - x, n - 1 - z)) ++bad;
+        if (r2b->At(x, z) != r2b->At(n - 1 - x, n - 1 - z)) ++bad;
+        if (r4->At(x, z) != r4->At(n - 1 - z, x)) ++bad;      // a quarter turn
+        if (r4b->At(x, z) != r4b->At(n - 1 - z, x)) ++bad;
+        if (dg->At(x, z) != dg->At(z, x)) ++bad;
+        if (ad->At(x, z) != ad->At(n - 1 - z, n - 1 - x)) ++bad;
+      }
+    }
+    CHECK(bad == 0, "%d symmetry violations", bad);
+    CHECK(mx->At(3, 5) == h->At(3, 5) && mx->At(30, 5) == h->At(2, 5), "mirror x master half");
+    CHECK(mz->At(4, 30) == h->At(4, 30), "mirror z side 1 master half");
+  }
+  // remap / levels / terrace
+  {
+    const GridPtr id = Run("remap", "points=0:0;1:1,smooth=0", {{"a", gFix["A"]}});
+    float maxd = 0;
+    for (std::size_t i = 0; i < id->Count(); ++i) maxd = std::max(maxd, std::fabs(id->v[i] - gFix["A"]->v[i]));
+    CHECK(maxd < 1e-6f, "identity remap moved values by %g", maxd);
+    const GridPtr sm = Run("remap", "points=0:0;0.3:0.1;0.7:0.9;1:1,smooth=1", {{"a", gFix["A"]}});
+    CHECK(Measure(*sm).min >= -1e-5f && Measure(*sm).max <= 1.0f + 1e-5f, "monotone cubic overshoots");
+    const GridPtr lv = Run("levels", "in_lo=0.4,in_hi=0.8,out_lo=0,out_hi=1", {{"a", gFix["A"]}});
+    CHECK(Measure(*lv).min == 0.0f, "levels");
+    const GridPtr tr = Run("terrace", "steps=4,sharpness=1", {{"a", gFix["A"]}});
+    std::map<int, int> levels;
+    for (const float v : tr->v) levels[int(std::floor(v * 4.0f * 1000.0f + 0.5f))]++;
+    CHECK(levels.size() <= 6, "terrace made %d distinct levels", int(levels.size()));
+  }
+  // geometry: offset by whole samples, resize shapes, rotate by 0 is identity
+  {
+    const GridPtr a = gFix["A"];
+    const GridPtr off = Run("offset", "move_x=5,move_z=0", {{"a", a}});
+    CHECK(off->At(10, 3) == a->At(5, 3) && off->At(2, 3) == a->At(30, 3), "offset wraps");
+    const GridPtr rot = Run("rotate", "angle=0", {{"a", a}});
+    CHECK(Checksum(*rot) == Checksum(*a), "rotate by 0");
+    const GridPtr rs = Run("resize", "width=17,height=17", {{"a", a}});
+    CHECK(rs->w == 17 && rs->cell == 2.0f && rs->At(16, 16) == a->At(32, 32) && rs->At(8, 8) == a->At(16, 16), "resize");
+    const GridPtr sc = Run("scale", "factor=1", {{"a", a}});
+    CHECK(Checksum(*sc) == Checksum(*a), "scale by 1");
+  }
+  // checksum: -0 equals +0, dimensions count
+  {
+    Grid p(2, 2, 1.0f, 0, 0, 0.0f);
+    Grid q(2, 2, 1.0f, 0, 0, -0.0f);
+    Grid r(4, 1, 1.0f, 0, 0, 0.0f);
+    CHECK(Checksum(p) == Checksum(q), "checksum -0");
+    CHECK(Checksum(p) != Checksum(r), "checksum dims");
+  }
+  // preview downsample of a constant
+  {
+    const GridPtr c = Run("const", "width=33,height=33,value=2");
+    std::vector<float> out;
+    Downsample(*c, 8, 8, out);
+    CHECK(out.size() == 64 && out[10] == 2.0f, "downsample");
+  }
+  // unknown op and missing input are errors, not crashes
+  {
+    std::string err;
+    CHECK(Make("nope", "", {}, &err) == nullptr && !err.empty(), "unknown op");
+    CHECK(Make("blur", "radius=2", {}, &err) == nullptr, "blur without input");
+    CHECK(Make("add", "", {{"a", gFix["A"]}, {"b", Run("const", "width=5,height=5")}}, &err) == nullptr, "add with mismatched sizes");
+    CHECK(OpNames().size() >= 35, "only %d ops", int(OpNames().size()));
+  }
+}
+
+static double Now()
+{
+  return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static void Bench()
+{
+  for (const int tc : {1, gDefaultThreads}) {
+    SetThreads(tc);
+    std::printf("bench, %d thread(s), 1025 x 1025:\n", tc);
+    double t = Now();
+    const GridPtr n = Run("perlin", "width=1025,height=1025,seed=3,scale=120,octaves=5");
+    std::printf("  perlin fBm 5 octaves   %8.1f ms\n", (Now() - t) * 1000);
+    const GridPtr h = Run("affine", "mul=60,add=0", {{"a", n}});
+    t = Now();
+    const GridPtr b = Run("blur", "radius=4", {{"a", h}});
+    std::printf("  gaussian blur sigma 4  %8.1f ms\n", (Now() - t) * 1000);
+    t = Now();
+    const GridPtr th = Run("thermal", "iterations=50,talus=0.5", {{"a", h}});
+    std::printf("  thermal 50 iterations  %8.1f ms\n", (Now() - t) * 1000);
+    t = Now();
+    const GridPtr d = Run("distance", "threshold=30", {{"a", h}});
+    std::printf("  distance field         %8.1f ms\n", (Now() - t) * 1000);
+    t = Now();
+    const GridPtr s = Run("slope", "mode=rating,window=2", {{"a", h}});
+    std::printf("  slope rating window 2  %8.1f ms\n", (Now() - t) * 1000);
+    (void)b; (void)th; (void)d; (void)s;
+  }
+}
+
+int main(int argc, char** argv)
+{
+  gDefaultThreads = Threads();
+  std::printf("EdFieldTest: %d threads, %d ops\n", gDefaultThreads, int(OpNames().size()));
+  const std::string cases = argc > 1 ? argv[1] : "";
+  const bool update = argc > 2 && std::string(argv[2]) == "--update";
+  const bool bench = argc > 2 && std::string(argv[2]) == "--bench";
+  if (!cases.empty() && cases.find("--") != 0) {
+    if (LoadCases(cases)) {
+      TestGoldens(update);
+      if (update) {
+        std::ofstream out(cases, std::ios::binary | std::ios::trunc);
+        for (const std::string& l : gLines) out << l << "\n";
+      }
+    } else {
+      CHECK(false, "cannot read the cases file %s", cases.c_str());
+    }
+  } else {
+    std::printf("(no cases file: goldens skipped)\n");
+  }
+  TestProperties();
+  TestThreadsLarge();
+  if (bench) Bench();
+  std::printf(gFailures == 0 ? "EdFieldTest PASS\n" : "EdFieldTest FAIL (%d)\n", gFailures);
+  return gFailures == 0 ? 0 : 1;
+}
diff --git a/src/sdk/moho/editor/tests/EdInteropTest.cpp b/src/sdk/moho/editor/tests/EdInteropTest.cpp
new file mode 100644
index 0000000..f30b8bb
--- /dev/null
+++ b/src/sdk/moho/editor/tests/EdInteropTest.cpp
@@ -0,0 +1,237 @@
+// Stand-alone test of the interop ops (EdFieldInterop.cpp; no engine needed).
+//   build + run: python scripts/ed_interop_test.py
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "moho/editor/EdFieldCore.h"
+
+using namespace moho::editor::field;
+
+static int gFailures = 0;
+#define CHECK(cond, ...)                               \
+  do {                                                 \
+    if (!(cond)) {                                     \
+      ++gFailures;                                     \
+      std::printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+      std::printf(__VA_ARGS__);                        \
+      std::printf("\n");                               \
+    }                                                  \
+  } while (0)
+
+static GridPtr Make(const int w, const int h, float (*f)(int, int, int, int), const float cell = 1.0f)
+{
+  auto g = std::make_shared<Grid>(w, h, cell, 0.0f, 0.0f);
+  for (int z = 0; z < h; ++z)
+    for (int x = 0; x < w; ++x) g->At(x, z) = f(x, z, w, h);
+  return g;
+}
+
+static bool Run(const char* const op, OpArgs& args, Grid& out)
+{
+  std::string err;
+  const bool ok = RunOp(op, args, out, err);
+  if (!ok) std::printf("op %s: %s\n", op, err.c_str());
+  return ok;
+}
+
+static float Pattern(const int x, const int z, const int, const int) { return static_cast<float>((x * 7 + z * 13) % 101) / 100.0f; }
+static float RampX(const int x, const int, const int w, const int) { return static_cast<float>(x) / static_cast<float>(w - 1); }
+static float Tilt(const int x, const int z, const int, const int) { return 0.25f * x + 0.5f * z; }
+
+int main()
+{
+  const char* const filters[] = {"nearest", "bilinear", "bicubic", "lanczos"};
+
+  // 1. identity: a 65 x 65 image over a 65 x 65 grid with corner alignment is exact for every filter
+  {
+    GridPtr src = Make(65, 65, Pattern);
+    GridPtr like = Make(65, 65, Pattern);
+    for (const char* fname : filters) {
+      OpArgs a;
+      a.in["a"] = src;
+      a.in["like"] = like;
+      a.p.str["align"] = "corner";
+      a.p.str["filter"] = fname;
+      Grid out;
+      if (!Run("img_resample", a, out)) continue;
+      int bad = 0;
+      for (std::size_t i = 0; i < out.v.size(); ++i) bad += out.v[i] != src->v[i];
+      CHECK(bad == 0, "identity %s: %d samples differ", fname, bad);
+    }
+  }
+
+  // 2. cell alignment: a 4 x 4 image over a 5 x 5 grid (4 cells): pixel k is centred on (k + 0.5), so the sample at 2 (the middle) sits between pixels 1 and 2
+  {
+    GridPtr src = Make(4, 4, RampX);   // 0, 1/3, 2/3, 1
+    GridPtr like = std::make_shared<Grid>(5, 5, 1.0f, 0.0f, 0.0f);
+    OpArgs a;
+    a.in["a"] = src;
+    a.in["like"] = like;
+    a.p.str["filter"] = "bilinear";
+    Grid out;
+    Run("img_resample", a, out);
+    CHECK(std::fabs(out.At(2, 2) - 0.5f) < 1e-6f, "cell: middle sample = %f, expected 0.5", out.At(2, 2));
+    CHECK(std::fabs(out.At(0, 0) - 0.0f) < 1e-6f, "cell: first sample clamps to the first pixel (%f)", out.At(0, 0));
+    CHECK(std::fabs(out.At(4, 4) - 1.0f) < 1e-6f, "cell: last sample clamps to the last pixel (%f)", out.At(4, 4));
+    CHECK(std::fabs(out.At(1, 0) - 1.0f / 6.0f) < 1e-6f, "cell: sample 1 = %f", out.At(1, 0));
+  }
+
+  // 3. a linear ramp stays linear for bilinear / bicubic / lanczos (interior samples), also when the image is 2x larger (low pass keeps linear functions)
+  {
+    GridPtr src = Make(129, 129, Tilt);
+    GridPtr like = std::make_shared<Grid>(65, 65, 1.0f, 0.0f, 0.0f);
+    for (const char* fname : {"bilinear", "bicubic", "lanczos"}) {
+      OpArgs a;
+      a.in["a"] = src;
+      a.in["like"] = like;
+      a.p.str["align"] = "corner";
+      a.p.str["filter"] = fname;
+      Grid out;
+      if (!Run("img_resample", a, out)) continue;
+      // output sample i = source coordinate 2 i, value 0.25 * 2 i + 0.5 * 2 j
+      double worst = 0.0;
+      for (int z = 8; z < 57; ++z)
+        for (int x = 8; x < 57; ++x) worst = std::max(worst, static_cast<double>(std::fabs(out.At(x, z) - (0.5f * x + 1.0f * z))));
+      CHECK(worst < 2e-3, "%s keeps a linear ramp when shrinking (worst %g)", fname, worst);
+    }
+  }
+
+  // 4. a constant stays constant (weights are normalised), also in the clamped border
+  {
+    GridPtr src = Make(32, 32, [](int, int, int, int) { return 0.37f; });
+    GridPtr like = std::make_shared<Grid>(129, 129, 1.0f, 0.0f, 0.0f);
+    for (const char* fname : filters) {
+      OpArgs a;
+      a.in["a"] = src;
+      a.in["like"] = like;
+      a.p.str["filter"] = fname;
+      Grid out;
+      if (!Run("img_resample", a, out)) continue;
+      double worst = 0.0;
+      for (float v : out.v) worst = std::max(worst, static_cast<double>(std::fabs(v - 0.37f)));
+      CHECK(worst < 1e-6, "%s keeps a constant (worst %g)", fname, worst);
+    }
+  }
+
+  // 5. region: samples outside the rectangle keep `outside`; the rectangle is filled
+  {
+    GridPtr src = Make(16, 16, [](int, int, int, int) { return 1.0f; });
+    GridPtr like = std::make_shared<Grid>(33, 33, 1.0f, 0.0f, 0.0f);
+    OpArgs a;
+    a.in["a"] = src;
+    a.in["like"] = like;
+    a.p.num["x0"] = 8;
+    a.p.num["z0"] = 4;
+    a.p.num["x1"] = 24;
+    a.p.num["z1"] = 20;
+    a.p.num["outside"] = -5;
+    Grid out;
+    Run("img_resample", a, out);
+    CHECK(out.At(7, 10) == -5.0f && out.At(8, 10) == 1.0f && out.At(24, 20) == 1.0f && out.At(25, 20) == -5.0f && out.At(10, 3) == -5.0f && out.At(10, 4) == 1.0f,
+          "region edges");
+  }
+
+  // 6. thread independence: same result with 1 and 5 threads
+  {
+    GridPtr src = Make(300, 200, Pattern);
+    GridPtr like = std::make_shared<Grid>(129, 97, 1.0f, 0.0f, 0.0f);
+    Grid one, five;
+    SetThreads(1);
+    {
+      OpArgs a;
+      a.in["a"] = src;
+      a.in["like"] = like;
+      a.p.str["filter"] = "lanczos";
+      Run("img_resample", a, one);
+    }
+    SetThreads(5);
+    {
+      OpArgs a;
+      a.in["a"] = src;
+      a.in["like"] = like;
+      a.p.str["filter"] = "lanczos";
+      Run("img_resample", a, five);
+    }
+    CHECK(one.v == five.v, "thread independent");
+  }
+
+  // 7. orientation: transpose, flips; eight combinations are distinct for an asymmetric image
+  {
+    GridPtr src = Make(3, 2, [](int x, int z, int, int) { return static_cast<float>(z * 3 + x); });   // 0 1 2 / 3 4 5
+    OpArgs a;
+    a.in["a"] = src;
+    Grid out;
+    a.p.num["flip_x"] = 1;
+    Run("img_orient", a, out);
+    CHECK(out.w == 3 && out.h == 2 && out.At(0, 0) == 2 && out.At(2, 1) == 3, "flip_x");
+    a.p.num["flip_x"] = 0;
+    a.p.num["flip_z"] = 1;
+    Run("img_orient", a, out);
+    CHECK(out.At(0, 0) == 3 && out.At(2, 1) == 2, "flip_z");
+    a.p.num["flip_z"] = 0;
+    a.p.num["transpose"] = 1;
+    Run("img_orient", a, out);
+    CHECK(out.w == 2 && out.h == 3 && out.At(1, 0) == 3 && out.At(0, 2) == 2, "transpose");
+    a.p.num["flip_x"] = 1;
+    Run("img_orient", a, out);   // a 90 degree turn: rows 3 0 / 4 1 / 5 2
+    CHECK(out.At(0, 0) == 3 && out.At(1, 0) == 0 && out.At(0, 2) == 5 && out.At(1, 2) == 2, "transpose + flip_x");
+    std::vector<float> seen;
+    for (int t = 0; t < 2; ++t)
+      for (int fx = 0; fx < 2; ++fx)
+        for (int fz = 0; fz < 2; ++fz) {
+          OpArgs b;
+          b.in["a"] = src;
+          b.p.num["transpose"] = t;
+          b.p.num["flip_x"] = fx;
+          b.p.num["flip_z"] = fz;
+          Grid o;
+          Run("img_orient", b, o);
+          float key = 0;
+          for (std::size_t i = 0; i < o.v.size(); ++i) key = key * 7.0f + o.v[i] + 1.0f + static_cast<float>(o.w);
+          CHECK(std::find(seen.begin(), seen.end(), key) == seen.end(), "orientation %d%d%d distinct", t, fx, fz);
+          seen.push_back(key);
+        }
+  }
+
+  // 8. rect_mask: hard, feathered inwards, sides left hard
+  {
+    GridPtr like = std::make_shared<Grid>(21, 21, 1.0f, 0.0f, 0.0f);
+    OpArgs a;
+    a.in["like"] = like;
+    a.p.num["x0"] = 4;
+    a.p.num["z0"] = 4;
+    a.p.num["x1"] = 16;
+    a.p.num["z1"] = 16;
+    Grid out;
+    Run("rect_mask", a, out);
+    CHECK(out.At(4, 4) == 1.0f && out.At(16, 16) == 1.0f && out.At(3, 10) == 0.0f && out.At(17, 10) == 0.0f, "hard rectangle");
+    a.p.num["feather"] = 4;
+    Run("rect_mask", a, out);
+    CHECK(out.At(4, 10) == 0.0f && out.At(6, 10) > 0.0f && out.At(6, 10) < 1.0f && out.At(8, 10) == 1.0f && out.At(10, 10) == 1.0f, "feather: 0 at the border, 1 after 4 samples");
+    CHECK(std::fabs(out.At(6, 10) - 0.5f) < 1e-6f, "smoothstep(0.5) = 0.5 (%f)", out.At(6, 10));
+    a.p.num["feather_l"] = 0;
+    Run("rect_mask", a, out);
+    CHECK(out.At(4, 10) == 1.0f && out.At(16, 10) == 0.0f, "a hard left side");
+  }
+
+  // 9. points_mask: a disc with a soft rim, maximum of overlapping points
+  {
+    GridPtr like = std::make_shared<Grid>(41, 41, 1.0f, 0.0f, 0.0f);
+    OpArgs a;
+    a.in["like"] = like;
+    a.p.arr["pts"] = {10, 10, 3, 1, 30, 30, 2, 0.5};
+    a.p.num["feather"] = 4;
+    Grid out;
+    Run("points_mask", a, out);
+    CHECK(out.At(10, 10) == 1.0f && out.At(13, 10) == 1.0f && out.At(15, 10) > 0.0f && out.At(15, 10) < 1.0f && out.At(17, 10) == 0.0f, "disc and rim");
+    CHECK(out.At(30, 30) == 0.5f && out.At(25, 25) == 0.0f, "second point value 0.5");
+  }
+
+  std::printf(gFailures == 0 ? "PASS EdInteropTest\n" : "FAILED %d\n", gFailures);
+  return gFailures == 0 ? 0 : 1;
+}
