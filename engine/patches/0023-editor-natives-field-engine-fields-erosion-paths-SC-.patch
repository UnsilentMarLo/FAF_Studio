+
+  // ---- the local erosion brush ------------------------------------------------------------------------------------------------------------------
+
+  namespace
+  {
+    float RoundWeight(const double dist, const double radius, const double falloff)
+    {
+      if (dist >= radius) return 0.0f;
+      const double f = std::max(0.0, std::min(1.0, falloff));
+      const double width = std::min(radius, std::max(radius * f, 1.0));
+      const double inner = radius - width;
+      if (dist <= inner) return 1.0f;
+      return static_cast<float>(0.5 * (1.0 + std::cos(static_cast<double>(kPi) * (dist - inner) / width)));
+    }
+
+    std::uint16_t Word(const float height)
+    {
+      const float v = std::floor(height * 128.0f + 0.5f);
+      return static_cast<std::uint16_t>(v < 0.0f ? 0.0f : (v > 65535.0f ? 65535.0f : v));
+    }
+  } // namespace
+
+  void ErodeSession::Begin(const int w, const int h, const std::uint16_t* words, const HydroParams& params)
+  {
+    w_ = w;
+    h_ = h;
+    params_ = params;
+    const std::size_t n = static_cast<std::size_t>(w) * static_cast<std::size_t>(h);
+    t_.resize(n);
+    for (std::size_t i = 0; i < n; ++i) t_[i] = static_cast<float>(words[i]) * (1.0f / 128.0f);
+    d_.assign(n, 0.0f);
+    s_.assign(n, 0.0f);
+    for (auto& a : f_) a.assign(n, 0.0f);
+    dx0_ = w;
+    dz0_ = h;
+    dx1_ = -1;
+    dz1_ = -1;
+    active_ = w >= 3 && h >= 3;
+  }
+
+  void ErodeSession::End()
+  {
+    active_ = false;
+    t_.clear();
+    t_.shrink_to_fit();
+    d_.clear();
+    d_.shrink_to_fit();
+    s_.clear();
+    s_.shrink_to_fit();
+    for (auto& a : f_) {
+      a.clear();
+      a.shrink_to_fit();
+    }
+  }
+
+  bool ErodeSession::Dab(const BrushDab& dab, int& x0, int& z0, int& x1, int& z1, std::vector<std::uint16_t>& words)
+  {
+    if (!active_) return false;
+    const double radius = std::max(1.0, dab.radius);
+    double margin = dab.margin;
+    if (margin < 0.0) margin = (dab.mode == 1 ? 0.8 : 0.35) * radius + 3.0;
+    x0 = std::max(0, static_cast<int>(std::floor(dab.cx - radius - margin)) - 1);
+    z0 = std::max(0, static_cast<int>(std::floor(dab.cz - radius - margin)) - 1);
+    x1 = std::min(w_ - 1, static_cast<int>(std::ceil(dab.cx + radius + margin)) + 1);
+    z1 = std::min(h_ - 1, static_cast<int>(std::ceil(dab.cz + radius + margin)) + 1);
+    const int ww = x1 - x0 + 1;
+    const int wh = z1 - z0 + 1;
+    if (ww < 3 || wh < 3) return false;
+    const std::size_t n = static_cast<std::size_t>(ww) * static_cast<std::size_t>(wh);
+    HydroState st;
+    st.w = ww;
+    st.h = wh;
+    st.cell = 1.0f;
+    st.t.resize(n);
+    st.d.resize(n);
+    st.s.resize(n);
+    for (auto& a : st.f) a.resize(n);
+    st.rain_rate.resize(n);
+    st.erode_rate.resize(n);
+    const bool custom = dab.weights.size() == n;
+    for (int z = 0; z < wh; ++z) {
+      for (int x = 0; x < ww; ++x) {
+        const std::size_t i = Ix(x, z, ww);
+        const std::size_t m = Ix(x0 + x, z0 + z, w_);
+        st.t[i] = t_[m];
+        st.d[i] = d_[m];
+        st.s[i] = s_[m];
+        for (int k = 0; k < 4; ++k) st.f[k][i] = f_[k][m];
+        const double ddx = static_cast<double>(x0 + x) - dab.cx;
+        const double ddz = static_cast<double>(z0 + z) - dab.cz;
+        const double dist = std::sqrt(ddx * ddx + ddz * ddz);
+        const float wgt = custom ? dab.weights[i] : RoundWeight(dist, radius, dab.falloff);
+        st.rain_rate[i] = wgt;
+        st.erode_rate[i] = dab.mode == 1 ? RoundWeight(dist, radius + 0.9 * margin, 1.0) : wgt;
+        if (dab.mode == 2 && !(x == 0 || z == 0 || x == ww - 1 || z == wh - 1)) {
+          st.s[i] += static_cast<float>(dab.amount * dab.strength) * wgt;
+        }
+      }
+    }
+    HydroParams p = params_;
+    const float k = static_cast<float>(dab.strength);
+    p.rain *= k;
+    p.erosion = std::min(1.0f, p.erosion * k);
+    p.thermal = std::min(1.0f, p.thermal * k);
+    p.pin_border = true;
+    p.settle = false;
+    p.track = false;
+    if (dab.mode == 2) p.rain *= 0.5f;
+    RunHydro(st, p, std::max(0, dab.iterations));
+    words.resize(n);
+    for (int z = 0; z < wh; ++z) {
+      for (int x = 0; x < ww; ++x) {
+        const std::size_t i = Ix(x, z, ww);
+        const std::size_t m = Ix(x0 + x, z0 + z, w_);
+        t_[m] = st.t[i];
+        d_[m] = st.d[i];
+        s_[m] = st.s[i];
+        for (int q = 0; q < 4; ++q) f_[q][m] = st.f[q][i];
+        words[i] = Word(st.t[i]);
+      }
+    }
+    dx0_ = std::min(dx0_, x0);
+    dz0_ = std::min(dz0_, z0);
+    dx1_ = std::max(dx1_, x1);
+    dz1_ = std::max(dz1_, z1);
+    return true;
+  }
+
+  bool ErodeSession::Finish(int& x0, int& z0, int& x1, int& z1, std::vector<std::uint16_t>& words)
+  {
+    if (!active_ || dx1_ < dx0_ || dz1_ < dz0_) return false;
+    x0 = dx0_;
+    z0 = dz0_;
+    x1 = dx1_;
+    z1 = dz1_;
+    const int ww = x1 - x0 + 1;
+    const int wh = z1 - z0 + 1;
+    words.resize(static_cast<std::size_t>(ww) * static_cast<std::size_t>(wh));
+    for (int z = 0; z < wh; ++z) {
+      for (int x = 0; x < ww; ++x) {
+        const std::size_t m = Ix(x0 + x, z0 + z, w_);
+        t_[m] += s_[m];
+        s_[m] = 0.0f;
+        words[Ix(x, z, ww)] = Word(t_[m]);
+      }
+    }
+    return true;
+  }
+} // namespace moho::editor::field::erosion
diff --git a/src/sdk/moho/editor/EdErosion.h b/src/sdk/moho/editor/EdErosion.h
new file mode 100644
index 0000000..29502bd
--- /dev/null
+++ b/src/sdk/moho/editor/EdErosion.h
@@ -0,0 +1,106 @@
+// EDITOR: the erosion suite of the field engine (docs/projects/editor/TERRAIN_GEN_DESIGN.md, stage T3). Engine independent, tested on its own
+// (editor/tests/EdErosionTest.cpp, scripts/ed_native_tests.py).
+//
+//   ops (registered in the field engine's op table, see EdFieldCore.h):
+//     erode_hydraulic   grid erosion on the pipe / shallow water model (Mei et al.): water, suspended sediment and outflow fluxes per cell; capacity from slope and speed;
+//                       erosion, deposition, evaporation; thermal slides coupled in every few iterations
+//     erode_droplet     particle erosion (Beyer / Lague): droplets with inertia run downhill, pick up and drop sediment; tiled, bit identical for any thread count
+//     erode_stream      stream power incision on a drainage network (pit filled flow routing, implicit solver): river valleys with branching channels
+//   every op returns the new height (`output=height`, the default) or, with `output=` wear | deposit | flow | water | sediment, one of the other results (the editor asks for all at
+//   once through OpArgs::extra). Inputs: a (the height field), mask (erodibility 0..1, optional), like.
+//
+//   ErodeSession: the local erosion brush. It keeps a float copy of the map heights and the water / sediment / flux of the whole map for the length of a stroke; every dab runs a few
+//   iterations of the hydraulic kernels on a window around the brush (border fixed), weighted by the brush falloff, so water keeps flowing from dab to dab.
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+#include "moho/editor/EdFieldCore.h"
+
+namespace moho::editor::field::erosion
+{
+  struct HydroParams
+  {
+    int iterations = 200;
+    float rain = 0.006f;          // water depth added to every cell per iteration (world units)
+    float evaporation = 0.02f;    // fraction of the water that evaporates per iteration
+    float gain = 0.08f;           // pipe gain: outflow flux grows by gain * (water surface difference) per iteration (<= 0.25 keeps the pipes stable)
+    float capacity = 1.0f;        // sediment capacity = capacity * sin(slope) * speed * depth factor
+    float erosion = 0.12f;        // share of the missing sediment that is dissolved per iteration
+    float deposition = 0.06f;      // share of the surplus sediment that settles per iteration
+    float depth_max = 0.05f;      // water depth (world units) at which the capacity saturates (shallow water carries less)
+    float min_slope = 0.02f;      // sin(slope) floor so flat ground still erodes a little
+    float max_speed = 1.0f;       // cells per iteration
+    float cut_limit = 0.5f;       // one step may remove at most this share of the drop to the lowest neighbour (0 = unlimited): erosion never digs pits
+    float talus = 0.8f;           // thermal slide limit (rise per run)
+    float thermal = 0.0f;         // thermal rate 0..1 per slide step (0 = no thermal coupling)
+    int thermal_every = 2;        // a thermal step after this many hydraulic iterations
+    bool pin_border = true;       // the outermost ring keeps its height and drains water (false: closed edges)
+    bool settle = true;           // at the end the remaining sediment settles where it is (conserves mass)
+    bool track = true;            // keep the wear, deposit and flow masks (off: the brush and previews do not need them)
+  };
+
+  /** The state of the grid solver on a rectangle. Arrays are row major w * h; empty optional arrays mean 1. */
+  struct HydroState
+  {
+    int w = 0;
+    int h = 0;
+    float cell = 1.0f;
+    std::vector<float> t;         // terrain height (world units)
+    std::vector<float> d;         // water depth
+    std::vector<float> s;         // suspended sediment (as depth of terrain)
+    std::vector<float> f[4];      // outflow flux to -x, +x, -z, +z
+    std::vector<float> rain_rate; // per cell factor of the rain (brush weight); empty = 1
+    std::vector<float> erode_rate;// per cell factor of erosion and thermal slides (brush weight); empty = 1
+    std::vector<float> rock;      // per cell erodibility; empty = 1
+    std::vector<float> wear;      // accumulated erosion (>= 0), optional
+    std::vector<float> dep;       // accumulated deposition (>= 0), optional
+    std::vector<float> flow;      // accumulated discharge (speed * depth), optional
+
+    void Allocate(int width, int height, float cellSize);
+  };
+
+  /** Runs `iterations` steps. Deterministic for any thread count. */
+  void RunHydro(HydroState& st, const HydroParams& p, int iterations);
+
+  /** One thermal slide step on t (see the `thermal` op); `rate` per cell optional (empty = scalar), the border ring is left alone when pinBorder. */
+  void ThermalStep(std::vector<float>& t, int w, int h, float cell, float talus, float rate, const std::vector<float>& rateMask, bool pinBorder);
+
+  // ---- the local erosion brush --------------------------------------------------------------------------------------------------------------
+
+  struct BrushDab
+  {
+    double cx = 0, cz = 0;        // sample coordinates of the centre
+    double radius = 12;           // samples
+    double falloff = 1.0;         // like the other brushes: share of the radius the edge falls off over
+    int iterations = 8;
+    double strength = 1.0;        // scales the dissolving, rain and thermal rates
+    int mode = 0;                 // 0 erode, 1 rain (water only under the brush, erodes downstream), 2 deposit (sediment dumped under the brush)
+    double margin = -1;           // extra window around the brush (samples); < 0: automatic
+    double amount = 0.5;          // deposit mode: sediment depth dumped at the centre per dab
+    std::vector<float> weights;   // optional brush weights for the window (row major, window size); empty = round falloff
+  };
+
+  class ErodeSession
+  {
+  public:
+    /** Starts a stroke on a map of w x h samples; `words` are the height words (1/128 world unit). */
+    void Begin(int w, int h, const std::uint16_t* words, const HydroParams& params);
+    [[nodiscard]] bool Active() const { return active_; }
+    /** One dab. On success `x0..z1` is the inclusive window and `words` its new height words (row major); returns false when nothing was done. */
+    bool Dab(const BrushDab& dab, int& x0, int& z0, int& x1, int& z1, std::vector<std::uint16_t>& words);
+    /** Settles the remaining sediment into the terrain; returns the changed window like Dab. */
+    bool Finish(int& x0, int& z0, int& x1, int& z1, std::vector<std::uint16_t>& words);
+    void End();
+    [[nodiscard]] HydroParams& Params() { return params_; }
+
+  private:
+    bool active_ = false;
+    int w_ = 0, h_ = 0;
+    HydroParams params_;
+    std::vector<float> t_;                    // float copy of the heights (world units)
+    std::vector<float> d_, s_, f_[4];         // water, sediment, fluxes of the whole map
+    int dx0_ = 0, dz0_ = 0, dx1_ = -1, dz1_ = -1;   // dirty rectangle (where state may be non-zero)
+  };
+} // namespace moho::editor::field::erosion
diff --git a/src/sdk/moho/editor/EdErosionLua.cpp b/src/sdk/moho/editor/EdErosionLua.cpp
new file mode 100644
index 0000000..b0b6d8e
--- /dev/null
+++ b/src/sdk/moho/editor/EdErosionLua.cpp
@@ -0,0 +1,223 @@
+// EDITOR: Lua natives of the local erosion brush (docs/projects/editor/TERRAIN_GEN_DESIGN.md, stage T3; the solver is EdErosion.cpp).
+//
+//   ed_erode_begin([params])                      -> ok | nil, message   starts a stroke session: copies the map heights as floats, water / sediment start empty.
+//                                                 params (all optional numbers): rain evaporation gain capacity erosion deposition depth_max min_slope cut_limit talus thermal thermal_every
+//   ed_erode_window(cx, cz, radius[, {mode, margin}])  -> x0, z0, x1, z1    the inclusive sample window a dab would use (for building shaped brush weights)
+//   ed_erode_dab(cx, cz, radius[, opts])          -> changed, x0, z0, x1, z1   one dab inside the open stroke of the document (ed_cmd_begin): runs the kernels on the window and writes
+//                                                 the new heights. opts: iterations strength falloff margin amount weights (list for the window, row major), mode = 'erode' | 'rain' | 'deposit'
+//   ed_erode_end([settle])                        -> changed, x0, z0, x1, z1   settles the remaining sediment (default) into the terrain, writes it and frees the session
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "lua/LuaPrimitives.h"
+#include "lua/LuaRuntimeTypes.h"
+#include "moho/editor/EdErosion.h"
+#include "moho/editor/EdFieldCore.h"
+#include "moho/editor/EditorDocument.h"
+#include "moho/lua/CScrLuaBinder.h"
+#include "moho/lua/CScrLuaInitForm.h"
+
+namespace
+{
+  namespace er = moho::editor::field::erosion;
+
+  er::ErodeSession gSession;
+
+  int Fail(lua_State* const L, const char* const message)
+  {
+    lua_pushnil(L);
+    lua_pushstring(L, message);
+    return 2;
+  }
+
+  double OptNum(lua_State* const L, const int index, const char* const key, const double fallback)
+  {
+    if (lua_type(L, index) != LUA_TTABLE) {
+      return fallback;
+    }
+    lua_pushstring(L, key);
+    lua_gettable(L, index);
+    double v = fallback;
+    if (lua_type(L, -1) == LUA_TNUMBER) {
+      v = lua_tonumber(L, -1);
+    }
+    lua_settop(L, -2);
+    return v;
+  }
+
+  std::string OptStr(lua_State* const L, const int index, const char* const key, const char* const fallback)
+  {
+    if (lua_type(L, index) != LUA_TTABLE) {
+      return fallback;
+    }
+    lua_pushstring(L, key);
+    lua_gettable(L, index);
+    std::string v = lua_type(L, -1) == LUA_TSTRING ? std::string(lua_tostring(L, -1)) : std::string(fallback);
+    lua_settop(L, -2);
+    return v;
+  }
+
+  er::HydroParams ParamsOf(lua_State* const L, const int index)
+  {
+    er::HydroParams p;
+    p.rain = static_cast<float>(OptNum(L, index, "rain", p.rain));
+    p.evaporation = static_cast<float>(OptNum(L, index, "evaporation", p.evaporation));
+    p.gain = static_cast<float>(OptNum(L, index, "gain", p.gain));
+    p.capacity = static_cast<float>(OptNum(L, index, "capacity", p.capacity));
+    p.erosion = static_cast<float>(OptNum(L, index, "erosion", p.erosion));
+    p.deposition = static_cast<float>(OptNum(L, index, "deposition", p.deposition));
+    p.depth_max = static_cast<float>(OptNum(L, index, "depth_max", p.depth_max));
+    p.min_slope = static_cast<float>(OptNum(L, index, "min_slope", p.min_slope));
+    p.cut_limit = static_cast<float>(OptNum(L, index, "cut_limit", p.cut_limit));
+    p.talus = static_cast<float>(OptNum(L, index, "talus", p.talus));
+    p.thermal = static_cast<float>(OptNum(L, index, "thermal", p.thermal));
+    p.thermal_every = static_cast<int>(OptNum(L, index, "thermal_every", p.thermal_every));
+    p.max_speed = static_cast<float>(OptNum(L, index, "max_speed", p.max_speed));
+    return p;
+  }
+
+  int ModeOf(const std::string& s) { return s == "rain" ? 1 : (s == "deposit" ? 2 : 0); }
+
+  int __cdecl cfunc_Begin(lua_State* const L)
+  {
+    if (!moho::editor::AttachDocument(false)) {
+      return Fail(L, "no terrain");
+    }
+    moho::editor::MapDocument& doc = moho::editor::Document();
+    moho::editor::CellRect all;
+    all.x0 = 0;
+    all.z0 = 0;
+    all.x1 = doc.Width() - 1;
+    all.z1 = doc.Height() - 1;
+    std::vector<std::uint16_t> words;
+    doc.ReadRect(all, words);
+    gSession.Begin(doc.Width(), doc.Height(), words.data(), ParamsOf(L, 1));
+    if (!gSession.Active()) {
+      return Fail(L, "the map is too small");
+    }
+    lua_pushnumber(L, 1);
+    return 1;
+  }
+
+  int __cdecl cfunc_Window(lua_State* const L)
+  {
+    // the window rule of ErodeSession::Dab, without running it
+    const double cx = luaL_checknumber(L, 1), cz = luaL_checknumber(L, 2);
+    const double radius = std::max(1.0, luaL_checknumber(L, 3));
+    const int mode = ModeOf(OptStr(L, 4, "mode", "erode"));
+    double margin = OptNum(L, 4, "margin", -1.0);
+    if (margin < 0.0) margin = (mode == 1 ? 0.8 : 0.35) * radius + 3.0;
+    moho::editor::MapDocument& doc = moho::editor::Document();
+    const int w = doc.Width(), h = doc.Height();
+    lua_pushnumber(L, std::max(0, static_cast<int>(std::floor(cx - radius - margin)) - 1));
+    lua_pushnumber(L, std::max(0, static_cast<int>(std::floor(cz - radius - margin)) - 1));
+    lua_pushnumber(L, std::min(w - 1, static_cast<int>(std::ceil(cx + radius + margin)) + 1));
+    lua_pushnumber(L, std::min(h - 1, static_cast<int>(std::ceil(cz + radius + margin)) + 1));
+    return 4;
+  }
+
+  int WriteBack(lua_State* const L, const int x0, const int z0, const int x1, const int z1, const std::vector<std::uint16_t>& words)
+  {
+    moho::editor::MapDocument& doc = moho::editor::Document();
+    moho::editor::CellRect rect;
+    rect.x0 = x0;
+    rect.z0 = z0;
+    rect.x1 = x1;
+    rect.z1 = z1;
+    const std::size_t changed = doc.EditHeights(rect, words.data());
+    lua_pushnumber(L, static_cast<lua_Number>(changed));
+    lua_pushnumber(L, x0);
+    lua_pushnumber(L, z0);
+    lua_pushnumber(L, x1);
+    lua_pushnumber(L, z1);
+    return 5;
+  }
+
+  int __cdecl cfunc_Dab(lua_State* const L)
+  {
+    if (!gSession.Active() || !moho::editor::AttachDocument(false)) {
+      return Fail(L, "no erosion session (ed_erode_begin)");
+    }
+    er::BrushDab dab;
+    dab.cx = luaL_checknumber(L, 1);
+    dab.cz = luaL_checknumber(L, 2);
+    dab.radius = luaL_checknumber(L, 3);
+    dab.iterations = static_cast<int>(OptNum(L, 4, "iterations", dab.iterations));
+    dab.strength = OptNum(L, 4, "strength", dab.strength);
+    dab.falloff = OptNum(L, 4, "falloff", dab.falloff);
+    dab.margin = OptNum(L, 4, "margin", dab.margin);
+    dab.amount = OptNum(L, 4, "amount", dab.amount);
+    dab.mode = ModeOf(OptStr(L, 4, "mode", "erode"));
+    if (lua_type(L, 4) == LUA_TTABLE) {
+      lua_pushstring(L, "weights");
+      lua_gettable(L, 4);
+      if (lua_type(L, -1) == LUA_TTABLE) {
+        const int t = lua_gettop(L);
+        for (int i = 1;; ++i) {
+          lua_rawgeti(L, t, i);
+          if (lua_type(L, -1) != LUA_TNUMBER) {
+            lua_settop(L, -2);
+            break;
+          }
+          dab.weights.push_back(static_cast<float>(lua_tonumber(L, -1)));
+          lua_settop(L, -2);
+        }
+      }
+      lua_settop(L, -2);
+    }
+    int x0 = 0, z0 = 0, x1 = -1, z1 = -1;
+    std::vector<std::uint16_t> words;
+    if (!gSession.Dab(dab, x0, z0, x1, z1, words)) {
+      lua_pushnumber(L, 0);
+      return 1;
+    }
+    return WriteBack(L, x0, z0, x1, z1, words);
+  }
+
+  int __cdecl cfunc_End(lua_State* const L)
+  {
+    if (!gSession.Active()) {
+      lua_pushnumber(L, 0);
+      return 1;
+    }
+    const bool settle = !(lua_type(L, 1) == LUA_TBOOLEAN && lua_toboolean(L, 1) == 0);
+    int x0 = 0, z0 = 0, x1 = -1, z1 = -1;
+    std::vector<std::uint16_t> words;
+    int results = 1;
+    if (settle && moho::editor::AttachDocument(false) && gSession.Finish(x0, z0, x1, z1, words)) {
+      results = WriteBack(L, x0, z0, x1, z1, words);
+    } else {
+      lua_pushnumber(L, 0);
+    }
+    gSession.End();
+    return results;
+  }
+
+  [[nodiscard]] moho::CScrLuaInitFormSet& UserLuaInitSet()
+  {
+    if (moho::CScrLuaInitFormSet* const set = moho::SCR_FindLuaInitFormSet("User"); set != nullptr) {
+      return *set;
+    }
+    static moho::CScrLuaInitFormSet fallbackSet("User");
+    return fallbackSet;
+  }
+
+  struct EdErosionLuaBootstrap
+  {
+    EdErosionLuaBootstrap()
+    {
+      moho::editor::OnSessionEnd([] { gSession.End(); });   // the session's terrain is gone: drop the working copy
+      auto& set = UserLuaInitSet();
+      const auto bind = [&](const char* name, int (__cdecl* fn)(lua_State*), const char* doc) { (void)new moho::CScrLuaBinder(set, name, fn, nullptr, "<global>", doc); };
+      bind("ed_erode_begin", &cfunc_Begin, "ed_erode_begin([params]) -> ok | nil, message");
+      bind("ed_erode_window", &cfunc_Window, "ed_erode_window(cx, cz, radius[, {mode, margin}]) -> x0, z0, x1, z1");
+      bind("ed_erode_dab", &cfunc_Dab, "ed_erode_dab(cx, cz, radius[, opts]) -> changed, x0, z0, x1, z1");
+      bind("ed_erode_end", &cfunc_End, "ed_erode_end([settle]) -> changed, x0, z0, x1, z1");
+    }
+  };
+
+  const EdErosionLuaBootstrap gEdErosionLuaBootstrap{};
+} // namespace
diff --git a/src/sdk/moho/editor/EdField.cpp b/src/sdk/moho/editor/EdField.cpp
new file mode 100644
index 0000000..92baa0f
--- /dev/null
+++ b/src/sdk/moho/editor/EdField.cpp
@@ -0,0 +1,850 @@
+// EDITOR: Lua natives of the field engine (EdFieldCore.h; docs/projects/editor/TERRAIN_GEN_DESIGN.md stage T1).
+//
+// A field is a float32 grid held in native memory and named in Lua by a number (a handle). Lua never sees the samples except through small reads, previews
+// and the stats. Ops are pure: an op makes a new field from its inputs. Heights are world units (the document's words / 128), masks 0..1.
+//
+//   ed_field_height([step, x0, z0, x1, z1])   -> f      the map's heights (the document's truth); step keeps every step-th sample (cell = step); the rectangle is in map samples
+//   ed_field_stratum(stratum[, raw])           -> f      paint mask of engine stratum 0..7 as 0..1 (the effective value the shader uses) or raw bytes 0..255;
+//                                                       one sample per mask cell, cell = world size of a mask cell
+//   ed_field_tt()                              -> f      the terrain-type grid as TypeCodes (stage T2); ed_field_commit_tt(f[, {mask}]) -> before, changed writes codes back
+//   ed_field_new(w, h, value[, cell, ox, oz])  -> f      constant field
+//   ed_field_from_table(w, h, values[, cell, ox, oz]) -> f
+//   ed_field_image(path[, {as='unit'|'height', width, height, cell}]) -> f   16-bit greyscale image (PNG, TIFF, raw); 'unit' = 0..1 (default), 'height' = words / 128
+//   ed_field_op(name, params)                  -> f | nil, message     params: numbers, strings, booleans, number lists, and the input fields a, b, mask, dx, dz, like
+//   ed_field_ops()                             -> list of op names
+//   ed_field_info(f)                           -> w, h, cell, ox, oz
+//   ed_field_stats(f)                          -> min, max, mean, sd
+//   ed_field_checksum(f)                       -> hex string (FNV-1a of the float bits, bit identical for any thread count)
+//   ed_field_get(f, x, z)                      -> value of one sample (indices)
+//   ed_field_sample(f, wx, wz)                 -> bilinear value at a world position
+//   ed_field_read(f, x0, z0, x1, z1)           -> list of values, row major (at most 65536 samples)
+//   ed_field_preview(f, pw, ph[, {lo, hi, ramp='grey'|'terrain'|'heat'}]) -> rgba list (pw * ph * 4, 0..255), lo, hi    box-average thumbnail
+//   ed_field_commit_height(f[, {label, strength, mask, x0, z0, x1, z1}]) -> changed, x0, z0, x1, z1    writes the field into the map heights as ONE undo step of the document
+//                                              (history.lua's terrain entry and the re-snap are the Lua side's, fields.lua)
+//   ed_field_commit_mask(f, stratum[, {raw, mode='set'|'max', strength, mask}]) -> before, changed    writes the field into a paint mask; `before` is a raw field of the
+//                                              old bytes (ed_field_commit_mask(before, stratum, {raw = true}) restores them: the undo)
+//   ed_field_copy(f)                           -> f2    a second handle on the same samples
+//   ed_field_free(f) / ed_field_free_all()     frees
+//   ed_field_count()                           -> number of fields, bytes
+//   ed_field_threads([n])                      -> threads in use (sets them first when n is given; results never depend on it)
+//   ed_field_clock()                           -> seconds (steady clock, for timings)
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "lua/LuaPrimitives.h"
+#include "lua/LuaRuntimeTypes.h"
+#include "moho/editor/EdFieldCore.h"
+#include "moho/editor/EdStrata.h"
+#include "moho/editor/EdTerrainType.h"
+#include "moho/editor/EditorDocument.h"
+#include "moho/lua/CScrLuaBinder.h"
+#include "moho/lua/CScrLuaInitForm.h"
+
+namespace moho::edfield
+{
+  bool ReadImage16(const std::string& utf8Path, std::vector<std::uint16_t>& out, int& w, int& h);   // EdImageIO.cpp
+}
+
+namespace
+{
+  using moho::editor::field::Grid;
+  using moho::editor::field::GridPtr;
+  namespace fld = moho::editor::field;
+
+  // ---- handles -------------------------------------------------------------------------------------------------------------------------------
+
+  std::map<int, GridPtr> gGrids;
+  int gNextHandle = 1;
+
+  int Store(Grid&& g)
+  {
+    const int id = gNextHandle++;
+    gGrids[id] = std::make_shared<const Grid>(std::move(g));
+    return id;
+  }
+
+  GridPtr Find(const int id)
+  {
+    const auto it = gGrids.find(id);
+    return it != gGrids.end() ? it->second : GridPtr();
+  }
+
+  GridPtr Arg(lua_State* const L, const int index)
+  {
+    GridPtr g = Find(static_cast<int>(luaL_checknumber(L, index)));
+    if (!g) {
+      luaL_error(L, "bad field handle");
+    }
+    return g;
+  }
+
+  int Fail(lua_State* const L, const std::string& message)
+  {
+    lua_pushnil(L);
+    lua_pushstring(L, message.c_str());
+    return 2;
+  }
+
+  [[nodiscard]] std::uint16_t ClampWord(const float value)
+  {
+    const float v = std::floor(value + 0.5f);
+    return static_cast<std::uint16_t>(v < 0.0f ? 0.0f : (v > 65535.0f ? 65535.0f : v));
+  }
+
+  // ---- table reading -------------------------------------------------------------------------------------------------------------------------
+
+  void Flatten(lua_State* const L, const int index, std::vector<double>& out, const int depth)
+  {
+    for (int i = 1;; ++i) {
+      lua_rawgeti(L, index, i);
+      const int t = lua_type(L, -1);
+      if (t == LUA_TNIL) {
+        lua_settop(L, -2);
+        break;
+      }
+      if (t == LUA_TNUMBER) {
+        out.push_back(lua_tonumber(L, -1));
+      } else if (t == LUA_TTABLE && depth < 2) {
+        Flatten(L, lua_gettop(L), out, depth + 1);
+      }
+      lua_settop(L, -2);
+    }
+  }
+
+  bool IsInputKey(const std::string& k)
+  {
+    return k == "a" || k == "b" || k == "mask" || k == "dx" || k == "dz" || k == "like";
+  }
+
+  /** Reads the table at stack index `index` into op arguments (input keys become fields). */
+  bool ReadArgs(lua_State* const L, const int index, fld::OpArgs& args, std::string& err)
+  {
+    if (lua_type(L, index) != LUA_TTABLE) {
+      return true;
+    }
+    lua_pushnil(L);
+    while (lua_next(L, index) != 0) {
+      if (lua_type(L, -2) == LUA_TSTRING) {
+        const std::string key = lua_tostring(L, -2);
+        const int t = lua_type(L, -1);
+        if (IsInputKey(key) && t == LUA_TNUMBER) {
+          const GridPtr g = Find(static_cast<int>(lua_tonumber(L, -1)));
+          if (!g) {
+            err = "input '" + key + "' is not a field";
+            lua_settop(L, -3);
+            return false;
+          }
+          args.in[key] = g;
+        } else if (t == LUA_TNUMBER) {
+          args.p.num[key] = lua_tonumber(L, -1);
+        } else if (t == LUA_TBOOLEAN) {
+          args.p.num[key] = lua_toboolean(L, -1) != 0 ? 1.0 : 0.0;
+        } else if (t == LUA_TSTRING) {
+          args.p.str[key] = lua_tostring(L, -1);
+        } else if (t == LUA_TTABLE) {
+          std::vector<double> flat;
+          Flatten(L, lua_gettop(L), flat, 0);
+          args.p.arr[key] = std::move(flat);
+        }
+      }
+      lua_settop(L, -2);
+    }
+    return true;
+  }
+
+  double OptNum(lua_State* const L, const int index, const double fallback)
+  {
+    return lua_type(L, index) == LUA_TNUMBER ? lua_tonumber(L, index) : fallback;
+  }
+
+  double OptField(lua_State* const L, const int index, const char* const key, const double fallback)
+  {
+    if (lua_type(L, index) != LUA_TTABLE) {
+      return fallback;
+    }
+    lua_pushstring(L, key);
+    lua_gettable(L, index);
+    double v = fallback;
+    if (lua_type(L, -1) == LUA_TNUMBER) {
+      v = lua_tonumber(L, -1);
+    } else if (lua_type(L, -1) == LUA_TBOOLEAN) {
+      v = lua_toboolean(L, -1) != 0 ? 1.0 : 0.0;
+    }
+    lua_settop(L, -2);
+    return v;
+  }
+
+  std::string OptString(lua_State* const L, const int index, const char* const key, const char* const fallback)
+  {
+    if (lua_type(L, index) != LUA_TTABLE) {
+      return fallback;
+    }
+    lua_pushstring(L, key);
+    lua_gettable(L, index);
+    std::string v = lua_type(L, -1) == LUA_TSTRING ? std::string(lua_tostring(L, -1)) : std::string(fallback);
+    lua_settop(L, -2);
+    return v;
+  }
