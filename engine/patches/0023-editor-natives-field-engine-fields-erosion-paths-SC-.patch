+    {
+      Registrar()
+      {
+        RegisterOp("erode_hydraulic", &OpHydraulic);
+        RegisterOp("erode_droplet", &OpDroplet);
+        RegisterOp("erode_stream", &OpStream);
+        RegisterOp("slope_area", &OpSlopeArea);
+        RegisterOp("basin_depth", &OpBasinDepth);
+      }
+    };
