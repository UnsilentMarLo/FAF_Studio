diff --git a/src/sdk/moho/editor/EdPerfPolicy.h b/src/sdk/moho/editor/EdPerfPolicy.h
index 19fa9e9..d3e6b80 100644
--- a/src/sdk/moho/editor/EdPerfPolicy.h
+++ b/src/sdk/moho/editor/EdPerfPolicy.h
@@ -129,4 +129,39 @@ namespace moho::editor::perf
     std::int64_t lastStart_ = 0;
     bool started_ = false;
   };
+
+  /**
+   * Decides whether the periodic forced full collection of a Lua state is worth its pause. The engine forces one every 5 s of frame time in the UI state
+   * (`CUIManager::Frame`) and every 70 ticks in the sim state (`Sim::AdvanceBeat`), whatever the state is doing. A full collection of the editor's UI state (65,000 lines of
+   * modules, catalogs) or of the sim state (every blueprint) stops the thread for as long as the live heap is big, est. tens to hundreds of milliseconds, and an idle editor does
+   * it for nothing. The gate lets it run when the heap grew by `minGrowthKb` since the last forced collection finished (there is garbage to find) or when `maxSeconds` have
+   * passed (native resources held by dead Lua objects, textures, are not in the Lua heap's size and must not wait forever). `minGrowthKb <= 0` = always: the original behaviour.
+   * Lua's own threshold (collect when the heap doubled) stays in force either way.
+   */
+  class GcGate
+  {
+  public:
+    /** `heapKb`: the state's heap now; `dtSeconds`: time since the previous call. true = collect now (and call Done with the heap after it). */
+    [[nodiscard]] bool Due(const long heapKb, const double dtSeconds, const long minGrowthKb, const double maxSeconds) noexcept
+    {
+      if (minGrowthKb <= 0) {
+        return true;
+      }
+      since_ += dtSeconds;
+      if (heapKb < afterKb_) {
+        afterKb_ = heapKb;   // the heap shrank by itself (Lua's own collection): measure growth from there
+      }
+      return heapKb - afterKb_ >= minGrowthKb || since_ >= maxSeconds;
+    }
+
+    void Done(const long heapKbAfter) noexcept
+    {
+      afterKb_ = heapKbAfter;
+      since_ = 0.0;
+    }
+
+  private:
+    long afterKb_ = 0;
+    double since_ = 0.0;
+  };
 } // namespace moho::editor::perf
diff --git a/src/sdk/moho/editor/tests/EdPerfPolicyTest.cpp b/src/sdk/moho/editor/tests/EdPerfPolicyTest.cpp
index e0026b1..4c8d709 100644
--- a/src/sdk/moho/editor/tests/EdPerfPolicyTest.cpp
+++ b/src/sdk/moho/editor/tests/EdPerfPolicyTest.cpp
@@ -173,11 +173,69 @@ static void TestPacer()
   CHECK(Pacer::Period(1.0f) == Pacer::Period(kMinCap), "period is clamped to the minimum cap");
 }
 
+static void TestGcGate()
+{
+  // off (0): every call collects, the original behaviour
+  {
+    GcGate g;
+    CHECK(g.Due(1000, 5.0, 0, 60.0), "gate off: always due");
+    g.Done(1000);
+    CHECK(g.Due(1000, 5.0, 0, 60.0), "gate off: still always due");
+  }
+  // an idle state: heap constant, nothing to find; due only at the time limit
+  {
+    GcGate g;
+    g.Done(100000);   // 100 MB after the last collection
+    int due = 0;
+    double t = 0;
+    for (int i = 0; i < 40; ++i) {   // 40 calls of 5 s = 200 s idle
+      t += 5.0;
+      if (g.Due(100000, 5.0, 8192, 60.0)) {
+        ++due;
+        g.Done(100000);
+      }
+    }
+    CHECK(due == 3, "200 s idle: one collection per 60 s limit (3), got %d", due);
+    (void)t;
+  }
+  // garbage appears: due on the first call after 8 MB of growth
+  {
+    GcGate g;
+    g.Done(100000);
+    CHECK(!g.Due(104000, 5.0, 8192, 60.0), "4 MB of growth: not yet");
+    CHECK(g.Due(108192, 5.0, 8192, 60.0), "8 MB of growth: due");
+    g.Done(101000);
+    CHECK(!g.Due(102000, 5.0, 8192, 60.0), "1 MB after the collection: not due");
+  }
+  // Lua collected on its own (heap shrank): growth is measured from the smaller heap
+  {
+    GcGate g;
+    g.Done(200000);
+    CHECK(!g.Due(120000, 5.0, 8192, 60.0), "shrunk heap: not due");
+    CHECK(!g.Due(125000, 5.0, 8192, 60.0), "5 MB above the new low: not due");
+    CHECK(g.Due(129000, 5.0, 8192, 60.0), "9 MB above the new low: due");
+  }
+  // the time limit counts across skipped calls and restarts after Done
+  {
+    GcGate g;
+    g.Done(1000);
+    bool due = false;
+    for (int i = 0; i < 11 && !due; ++i) {
+      due = g.Due(1000, 5.0, 8192, 60.0);
+    }
+    CHECK(!due, "55 s: not due");
+    CHECK(g.Due(1000, 5.0, 8192, 60.0), "60 s: due");
+    g.Done(1000);
+    CHECK(!g.Due(1000, 5.0, 8192, 60.0), "right after Done: not due");
+  }
+}
+
 int main()
 {
   TestCaps();
   TestStateName();
   TestPacer();
+  TestGcGate();
   std::printf("EdPerfPolicyTest: %d checks, %d failures\n", gChecks, gFailures);
   return gFailures == 0 ? 0 : 1;
 }
