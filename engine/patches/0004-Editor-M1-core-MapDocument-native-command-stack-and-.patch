+      (void)BindSimGlobal("ed_sim_checksum", &cfunc_EdSimChecksum, "ed_sim_checksum(x0, z0, x1, z1) -> hex");
       (void)BindGlobal("ed_decal_count", &cfunc_EdDecalCount, "ed_decal_count(...)");
       (void)BindGlobal("ed_decal_get", &cfunc_EdDecalGet, "ed_decal_get(...)");
       (void)BindGlobal("ed_decal_add", &cfunc_EdDecalAdd, "ed_decal_add(...)");
diff --git a/src/sdk/moho/editor/MapDocument.cpp b/src/sdk/moho/editor/MapDocument.cpp
new file mode 100644
index 0000000..1141549
--- /dev/null
+++ b/src/sdk/moho/editor/MapDocument.cpp
@@ -0,0 +1,552 @@
+// MapDocument and its command stack, see MapDocument.h. Engine independent.
+#include "moho/editor/MapDocument.h"
+
+#include <algorithm>
+#include <cstring>
+#include <map>
+#include <utility>
+
+namespace moho::editor
+{
+  void CellRect::Unite(const CellRect& other) noexcept
+  {
+    if (other.Empty()) {
+      return;
+    }
+    if (Empty()) {
+      *this = other;
+      return;
+    }
+    x0 = std::min(x0, other.x0);
+    z0 = std::min(z0, other.z0);
+    x1 = std::max(x1, other.x1);
+    z1 = std::max(z1, other.z1);
+  }
+
+  namespace
+  {
+    constexpr int kTile = 32;
+    constexpr int kTileCells = kTile * kTile;
+
+    [[nodiscard]] std::uint64_t TileKey(const int tx, const int tz) noexcept
+    {
+      return (static_cast<std::uint64_t>(static_cast<std::uint32_t>(tz)) << 32) | static_cast<std::uint32_t>(tx);
+    }
+
+    // ---- delta packing: zero runs and zigzag varints -------------------------------------------------------
+
+    void PutVarint(std::vector<std::uint8_t>& out, std::uint32_t value)
+    {
+      while (value >= 0x80u) {
+        out.push_back(static_cast<std::uint8_t>(value | 0x80u));
+        value >>= 7;
+      }
+      out.push_back(static_cast<std::uint8_t>(value));
+    }
+
+    [[nodiscard]] std::uint32_t GetVarint(const std::vector<std::uint8_t>& in, std::size_t& at)
+    {
+      std::uint32_t value = 0;
+      int shift = 0;
+      while (at < in.size()) {
+        const std::uint8_t byte = in[at++];
+        value |= static_cast<std::uint32_t>(byte & 0x7Fu) << shift;
+        if ((byte & 0x80u) == 0) {
+          break;
+        }
+        shift += 7;
+      }
+      return value;
+    }
+
+    [[nodiscard]] std::uint32_t ZigZag(const std::int32_t v) noexcept
+    {
+      return (static_cast<std::uint32_t>(v) << 1) ^ static_cast<std::uint32_t>(v >> 31);
+    }
+
+    [[nodiscard]] std::int32_t UnZigZag(const std::uint32_t v) noexcept
+    {
+      return static_cast<std::int32_t>(v >> 1) ^ -static_cast<std::int32_t>(v & 1u);
+    }
+
+    // token 0 + run length = a run of zeros; any other varint is a zigzag-coded non-zero delta
+    std::vector<std::uint8_t> Pack(const std::vector<std::int32_t>& cells)
+    {
+      std::vector<std::uint8_t> out;
+      std::uint32_t run = 0;
+      const auto flush = [&]() {
+        if (run != 0) {
+          PutVarint(out, 0);
+          PutVarint(out, run);
+          run = 0;
+        }
+      };
+      for (const std::int32_t d : cells) {
+        if (d == 0) {
+          ++run;
+        } else {
+          flush();
+          PutVarint(out, ZigZag(d));
+        }
+      }
+      flush();
+      out.shrink_to_fit();
+      return out;
+    }
+
+    void Unpack(const std::vector<std::uint8_t>& in, std::vector<std::int32_t>& cells)
+    {
+      cells.assign(static_cast<std::size_t>(kTileCells), 0);
+      std::size_t at = 0;
+      std::size_t cell = 0;
+      while (at < in.size() && cell < cells.size()) {
+        const std::uint32_t token = GetVarint(in, at);
+        if (token == 0) {
+          cell += GetVarint(in, at);
+        } else {
+          cells[cell++] = UnZigZag(token);
+        }
+      }
+    }
+
+    // ---- the height command -------------------------------------------------------------------------------
+
+    /**
+     * All dabs of one brush stroke (or one single edit): sparse per-tile deltas `after - before`. Undo needs no copy
+     * of the old samples because the stack is strictly last-in first-out, and the checksums prove it.
+     */
+    class HeightStroke final : public Command
+    {
+    public:
+      HeightStroke(const std::uint64_t stroke, std::string label) : mStroke(stroke), mLabel(std::move(label)) {}
+
+      /** `delta` is `after - before` for `rect`, row major. */
+      void AddDab(const CellRect& rect, const std::vector<std::int32_t>& delta)
+      {
+        mBounds.Unite(rect);
+        std::size_t i = 0;
+        for (int z = rect.z0; z <= rect.z1; ++z) {
+          for (int x = rect.x0; x <= rect.x1; ++x, ++i) {
+            const std::int32_t d = delta[i];
+            if (d == 0) {
+              continue;
+            }
+            Tile& tile = mTiles[TileKey(x / kTile, z / kTile)];
+            if (tile.raw.empty()) {
+              tile.raw.assign(static_cast<std::size_t>(kTileCells), 0);
+            }
+            tile.raw[static_cast<std::size_t>((z % kTile) * kTile + (x % kTile))] += d;
+          }
+        }
+      }
+
+      void Do(MapDocument& doc) override { (void)Apply(doc, +1); }
+
+      bool Redo(MapDocument& doc) override
+      {
+        bool ok = true;
+        if (mSealed) {
+          ok = doc.Checksum(mBounds) == mSumBefore;
+        }
+        Apply(doc, +1);
+        if (mSealed) {
+          ok = ok && doc.Checksum(mBounds) == mSumAfter;
+        }
+        return ok;
+      }
+
+      bool Undo(MapDocument& doc) override
+      {
+        bool ok = true;
+        if (mSealed) {
+          ok = doc.Checksum(mBounds) == mSumAfter;
+        }
+        Apply(doc, -1);
+        if (mSealed) {
+          ok = ok && doc.Checksum(mBounds) == mSumBefore;
+        }
+        return ok;
+      }
+
+      bool TryMerge(Command& next) override
+      {
+        auto* const other = dynamic_cast<HeightStroke*>(&next);
+        if (other == nullptr || mSealed || other->mSealed || mStroke == 0 || other->mStroke != mStroke) {
+          return false;
+        }
+        for (auto& [key, tile] : other->mTiles) {
+          Tile& mine = mTiles[key];
+          if (mine.raw.empty()) {
+            mine.raw = std::move(tile.raw);
+          } else {
+            for (std::size_t i = 0; i < mine.raw.size(); ++i) {
+              mine.raw[i] += tile.raw[i];
+            }
+          }
+        }
+        mBounds.Unite(other->mBounds);
+        return true;
+      }
+
+      void Seal(MapDocument& doc) override
+      {
+        if (mSealed) {
+          return;
+        }
+        // the document is in the state after this command: record it, and derive the state before it
+        mSumAfter = doc.Checksum(mBounds);
+        std::vector<std::uint16_t> before;
+        doc.ReadRect(mBounds, before);
+        Accumulate(before, -1);
+        mSumBefore = MapDocument::ChecksumWords(mBounds, before.data());
+        for (auto& [key, tile] : mTiles) {
+          tile.packed = Pack(tile.raw);
+          tile.raw.clear();
+          tile.raw.shrink_to_fit();
+        }
+        mSealed = true;
+      }
+
+      [[nodiscard]] std::string Label() const override { return mLabel; }
+      [[nodiscard]] CellRect Bounds() const override { return mBounds; }
+      [[nodiscard]] std::uint64_t StrokeId() const noexcept override { return mStroke; }
+
+      [[nodiscard]] std::size_t ApproxBytes() const override
+      {
+        std::size_t total = sizeof(*this) + mLabel.size();
+        for (const auto& [key, tile] : mTiles) {
+          (void)key;
+          total += tile.raw.size() * sizeof(std::int32_t) + tile.packed.size() + 48;
+        }
+        return total;
+      }
+
+    private:
+      struct Tile
+      {
+        std::vector<std::int32_t> raw;     // open stroke
+        std::vector<std::uint8_t> packed;  // sealed
+      };
+
+      // buffer = the document's words over mBounds; adds sign * delta to it
+      void Accumulate(std::vector<std::uint16_t>& buffer, const int sign) const
+      {
+        const int width = mBounds.Width();
+        std::vector<std::int32_t> cells;
+        for (const auto& [key, tile] : mTiles) {
+          const int tx = static_cast<int>(key & 0xFFFFFFFFu);
+          const int tz = static_cast<int>(key >> 32);
+          const std::vector<std::int32_t>* source = &tile.raw;
+          if (mSealed) {
+            Unpack(tile.packed, cells);
+            source = &cells;
+          }
+          if (source->empty()) {
+            continue;
+          }
+          for (int cz = 0; cz < kTile; ++cz) {
+            const int z = tz * kTile + cz;
+            if (z < mBounds.z0 || z > mBounds.z1) {
+              continue;
+            }
+            for (int cx = 0; cx < kTile; ++cx) {
+              const int x = tx * kTile + cx;
+              if (x < mBounds.x0 || x > mBounds.x1) {
+                continue;
+              }
+              const std::int32_t d = (*source)[static_cast<std::size_t>(cz * kTile + cx)];
+              if (d == 0) {
+                continue;
+              }
+              std::uint16_t& word = buffer[static_cast<std::size_t>((z - mBounds.z0) * width + (x - mBounds.x0))];
+              const std::int32_t v = static_cast<std::int32_t>(word) + sign * d;
+              word = static_cast<std::uint16_t>(std::clamp(v, 0, 65535));
+            }
+          }
+        }
+      }
+
+      bool Apply(MapDocument& doc, const int sign)
+      {
+        if (mBounds.Empty()) {
+          return true;
+        }
+        std::vector<std::uint16_t> buffer;
+        doc.ReadRect(mBounds, buffer);
+        Accumulate(buffer, sign);
+        doc.CommitHeights(mBounds, buffer.data());
+        return true;
+      }
+
+      std::map<std::uint64_t, Tile> mTiles;
+      CellRect mBounds;
+      std::uint64_t mStroke = 0;
+      std::string mLabel;
+      bool mSealed = false;
+      std::uint64_t mSumBefore = 0;
+      std::uint64_t mSumAfter = 0;
+    };
+  } // namespace
+
+  // ---- MapDocument ---------------------------------------------------------------------------------------------
+
+  MapDocument::MapDocument() = default;
+  MapDocument::~MapDocument() = default;
+
+  void MapDocument::Reset(const int width, const int height, std::vector<std::uint16_t> heights, HeightSink sink)
+  {
+    mStack.clear();
+    mPos = 0;
+    mCleanPos = 0;
+    mStroke = 0;
+    mRevision = 0;
+    mSink = std::move(sink);
+    if (width <= 0 || height <= 0 || heights.size() != static_cast<std::size_t>(width) * static_cast<std::size_t>(height)) {
+      mWidth = 0;
+      mHeight = 0;
+      mHeights.clear();
+      return;
+    }
+    mWidth = width;
+    mHeight = height;
+    mHeights = std::move(heights);
+  }
+
+  std::uint16_t MapDocument::HeightAt(const int x, const int z) const
+  {
+    if (x < 0 || z < 0 || x >= mWidth || z >= mHeight) {
+      return 0;
+    }
+    return mHeights[static_cast<std::size_t>(z) * static_cast<std::size_t>(mWidth) + static_cast<std::size_t>(x)];
+  }
+
+  CellRect MapDocument::Clamp(CellRect rect) const noexcept
+  {
+    if (rect.x0 > rect.x1) {
+      std::swap(rect.x0, rect.x1);
+    }
+    if (rect.z0 > rect.z1) {
+      std::swap(rect.z0, rect.z1);
+    }
+    rect.x0 = std::max(0, rect.x0);
+    rect.z0 = std::max(0, rect.z0);
+    rect.x1 = std::min(mWidth - 1, rect.x1);
+    rect.z1 = std::min(mHeight - 1, rect.z1);
+    return rect;
+  }
+
+  void MapDocument::ReadRect(const CellRect& rect, std::vector<std::uint16_t>& out) const
+  {
+    out.clear();
+    if (rect.Empty() || rect.x0 < 0 || rect.z0 < 0 || rect.x1 >= mWidth || rect.z1 >= mHeight) {
+      return;
+    }
+    out.resize(rect.Count());
+    const std::size_t rowWords = static_cast<std::size_t>(rect.Width());
+    for (int z = rect.z0; z <= rect.z1; ++z) {
+      std::memcpy(
+        out.data() + static_cast<std::size_t>(z - rect.z0) * rowWords,
+        mHeights.data() + static_cast<std::size_t>(z) * static_cast<std::size_t>(mWidth) + static_cast<std::size_t>(rect.x0),
+        rowWords * sizeof(std::uint16_t)
+      );
+    }
+  }
+
+  std::uint64_t MapDocument::ChecksumWords(const CellRect& rect, const std::uint16_t* const words)
+  {
+    std::uint64_t hash = 1469598103934665603ull;
+    const auto mix = [&hash](const std::uint64_t value) {
+      hash ^= value;
+      hash *= 1099511628211ull;
+    };
+    mix(static_cast<std::uint64_t>(rect.Width()));
+    mix(static_cast<std::uint64_t>(rect.Height()));
+    const std::size_t count = rect.Count();
+    for (std::size_t i = 0; i < count; ++i) {
+      mix(words[i]);
+    }
+    return hash;
+  }
+
+  std::uint64_t MapDocument::Checksum(const CellRect& rect) const
+  {
+    std::vector<std::uint16_t> words;
+    ReadRect(rect, words);
+    return ChecksumWords(rect, words.data());
+  }
+
+  void MapDocument::CommitHeights(const CellRect& rect, const std::uint16_t* const words)
+  {
+    if (rect.Empty() || rect.x0 < 0 || rect.z0 < 0 || rect.x1 >= mWidth || rect.z1 >= mHeight) {
+      return;
+    }
+    const std::size_t rowWords = static_cast<std::size_t>(rect.Width());
+    for (int z = rect.z0; z <= rect.z1; ++z) {
+      std::memcpy(
+        mHeights.data() + static_cast<std::size_t>(z) * static_cast<std::size_t>(mWidth) + static_cast<std::size_t>(rect.x0),
+        words + static_cast<std::size_t>(z - rect.z0) * rowWords,
+        rowWords * sizeof(std::uint16_t)
+      );
+    }
+    ++mRevision;
+    if (mSink) {
+      mSink(rect, words);
+    }
+  }
+
+  void MapDocument::WriteExternal(const CellRect& rect, const std::uint16_t* const words)
+  {
+    CommitHeights(rect, words);
+    mStack.clear();
+    mPos = 0;
+    mStroke = 0;
+    mCleanPos = -1;
+  }
+
+  std::size_t MapDocument::EditHeights(const CellRect& rect, const std::uint16_t* const words)
+  {
+    if (rect.Empty() || rect.x0 < 0 || rect.z0 < 0 || rect.x1 >= mWidth || rect.z1 >= mHeight) {
+      return 0;
+    }
+    std::vector<std::int32_t> delta(rect.Count());
+    std::size_t changed = 0;
+    std::size_t i = 0;
+    for (int z = rect.z0; z <= rect.z1; ++z) {
+      for (int x = rect.x0; x <= rect.x1; ++x, ++i) {
+        const std::int32_t d = static_cast<std::int32_t>(words[i]) - static_cast<std::int32_t>(HeightAt(x, z));
+        delta[i] = d;
+        changed += d != 0 ? 1u : 0u;
+      }
+    }
+    if (changed == 0) {
+      return 0;
+    }
+    auto command = std::make_unique<HeightStroke>(mStroke, mStroke != 0 ? mStrokeLabel : std::string("Height edit"));
+    command->AddDab(rect, delta);
+    Execute(std::move(command));
+    return changed;
+  }
+
+  void MapDocument::Execute(std::unique_ptr<Command> command)
+  {
+    command->Do(*this);
+
+    if (mPos < mStack.size()) {
+      // a new edit ends the redo branch
+      if (mCleanPos > static_cast<long>(mPos)) {
+        mCleanPos = -1;
+      }
+      mStack.resize(mPos);
+    }
+    if (mPos > 0 && mStroke != 0 && mStack[mPos - 1]->StrokeId() == mStroke && mStack[mPos - 1]->TryMerge(*command)) {
+      return;
+    }
+    Push(std::move(command));
+  }
+
+  void MapDocument::Push(std::unique_ptr<Command> command)
+  {
+    mStack.push_back(std::move(command));
+    ++mPos;
+    if (mStroke == 0) {
+      mStack.back()->Seal(*this);
+    }
+    Trim();
+  }
+
+  void MapDocument::Trim()
+  {
+    while (mStack.size() > 1 && (mStack.size() > kMaxCommands || HistoryBytes() > kMaxBytes)) {
+      mStack.erase(mStack.begin());
+      if (mPos > 0) {
+        --mPos;
+      }
+      if (mCleanPos >= 0) {
+        --mCleanPos;
+        if (mCleanPos < 0) {
+          mCleanPos = -1;
+        }
+      }
+    }
+  }
+
+  void MapDocument::BeginStroke(const std::string& label)
+  {
+    if (mStroke != 0) {
+      return;
+    }
+    mStroke = mNextStroke++;
+    mStrokeLabel = label;
+  }
+
+  void MapDocument::EndStroke()
+  {
+    if (mStroke == 0) {
+      return;
+    }
+    if (mPos > 0 && mPos == mStack.size() && mStack[mPos - 1]->StrokeId() == mStroke) {
+      mStack[mPos - 1]->Seal(*this);
+    }
+    mStroke = 0;
+  }
+
+  HistoryResult MapDocument::Undo()
+  {
+    EndStroke();
+    HistoryResult result;
+    if (mPos == 0) {
+      return result;
+    }
+    Command& command = *mStack[mPos - 1];
+    result.label = command.Label();
+    result.bounds = command.Bounds();
+    result.verified = command.Undo(*this);
+    result.ok = true;
+    --mPos;
+    return result;
+  }
+
+  HistoryResult MapDocument::Redo()
+  {
+    EndStroke();
+    HistoryResult result;
+    if (mPos >= mStack.size()) {
+      return result;
+    }
+    Command& command = *mStack[mPos];
+    result.label = command.Label();
+    result.bounds = command.Bounds();
+    result.verified = command.Redo(*this);
+    result.ok = true;
+    ++mPos;
+    return result;
+  }
+
+  std::string MapDocument::UndoLabel() const
+  {
+    return mPos > 0 ? mStack[mPos - 1]->Label() : std::string();
+  }
+
+  std::string MapDocument::RedoLabel() const
+  {
+    return mPos < mStack.size() ? mStack[mPos]->Label() : std::string();
+  }
+
+  std::size_t MapDocument::HistoryBytes() const
+  {
+    std::size_t total = 0;
+    for (const auto& command : mStack) {
+      total += command->ApproxBytes();
+    }
+    return total;
+  }
+
+  void MapDocument::ClearHistory()
+  {
+    const bool wasDirty = Dirty();
+    mStack.clear();
+    mPos = 0;
+    mStroke = 0;
+    mCleanPos = wasDirty ? -1 : 0;
+  }
+} // namespace moho::editor
diff --git a/src/sdk/moho/editor/MapDocument.h b/src/sdk/moho/editor/MapDocument.h
new file mode 100644
index 0000000..b990af2
--- /dev/null
+++ b/src/sdk/moho/editor/MapDocument.h
@@ -0,0 +1,180 @@
+// The editor's map document and its command stack (M1, docs/projects/MAP_EDITOR_DESIGN.md rules 1 and 2).
+//
+// MapDocument owns the truth of everything the editor edits (so far the height samples); the engine's height
+// fields, the sim's path caches and the renderer are projections refreshed through one sink. Every edit is a
+// Command on one stack: Do / Undo / TryMerge, a label, a dirty rectangle. Height payloads are stored as sparse
+// per-tile deltas that are packed (zero-run + zigzag varint) when the stroke closes, and carry before / after
+// checksums so undo can prove it restored the exact samples.
+//
+// This file is engine independent (no moho types) so the stack can be tested on its own
+// (editor/tests/MapDocumentTest.cpp). The engine side is EditorDocument.h.
+//
+// Thread rule: a MapDocument is used by one thread only (the UI thread). The sink hands the changed rectangle to the
+// engine glue, which is the only place that touches the sim thread (a queue drained between sim beats).
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace moho::editor
+{
+  /** Inclusive sample rectangle. Empty when x1 < x0 or z1 < z0. */
+  struct CellRect
+  {
+    int x0 = 0;
+    int z0 = 0;
+    int x1 = -1;
+    int z1 = -1;
+
+    [[nodiscard]] bool Empty() const noexcept { return x1 < x0 || z1 < z0; }
+    [[nodiscard]] int Width() const noexcept { return Empty() ? 0 : x1 - x0 + 1; }
+    [[nodiscard]] int Height() const noexcept { return Empty() ? 0 : z1 - z0 + 1; }
+    [[nodiscard]] std::size_t Count() const noexcept
+    {
+      return static_cast<std::size_t>(Width()) * static_cast<std::size_t>(Height());
+    }
+    void Unite(const CellRect& other) noexcept;
+  };
+
+  class MapDocument;
+
+  /** One undoable edit. Commands are executed by MapDocument::Execute, never by the tools directly. */
+  class Command
+  {
+  public:
+    virtual ~Command() = default;
+
+    /** Applies the edit to the document (first execution and every redo). */
+    virtual void Do(MapDocument& doc) = 0;
+
+    /** Takes the edit back. Returns false when the document no longer matched what the command expects. */
+    virtual bool Undo(MapDocument& doc) = 0;
+
+    /** Applies the edit again after an undo; false when the document did not match what the command recorded. */
+    virtual bool Redo(MapDocument& doc)
+    {
+      Do(doc);
+      return true;
+    }
+
+    /** The brush stroke this command belongs to (0 = none: never merged into). */
+    [[nodiscard]] virtual std::uint64_t StrokeId() const noexcept { return 0; }
+
+    /** Absorbs `next`, which was just executed on top of this command (a later dab of the same brush stroke). */
+    virtual bool TryMerge(Command& next)
+    {
+      (void)next;
+      return false;
+    }
+
+    /** Called when no more commands will be merged into this one: pack the payload, record checksums. */
+    virtual void Seal(MapDocument& doc) { (void)doc; }
+
+    [[nodiscard]] virtual std::string Label() const = 0;
+    /** The samples this command changed (for re-snapping units, dirtying path caches ...). */
+    [[nodiscard]] virtual CellRect Bounds() const = 0;
+    [[nodiscard]] virtual std::size_t ApproxBytes() const = 0;
+  };
+
+  struct HistoryResult
+  {
+    bool ok = false;        // a command was undone / redone
+    bool verified = true;   // checksums before and after matched what the command recorded
+    CellRect bounds;        // what changed
+    std::string label;
+  };
+
+  class MapDocument
+  {
+  public:
+    /** Called after the document's heights changed: the rectangle and its words (row major, x fastest). */
+    using HeightSink = std::function<void(const CellRect&, const std::uint16_t*)>;
+
+    static constexpr std::size_t kMaxCommands = 2000;
+    static constexpr std::size_t kMaxBytes = 256u * 1024u * 1024u;
+
+    MapDocument();
+    ~MapDocument();
+    MapDocument(const MapDocument&) = delete;
+    MapDocument& operator=(const MapDocument&) = delete;
+
+    /** Starts a document from `heights` (width * height words); clears the history; the document is clean. */
+    void Reset(int width, int height, std::vector<std::uint16_t> heights, HeightSink sink);
+
+    [[nodiscard]] bool Valid() const noexcept { return mWidth > 0 && mHeight > 0; }
+    [[nodiscard]] int Width() const noexcept { return mWidth; }
+    [[nodiscard]] int Height() const noexcept { return mHeight; }
+    [[nodiscard]] std::uint16_t HeightAt(int x, int z) const;
+    [[nodiscard]] CellRect Clamp(CellRect rect) const noexcept;
+    void ReadRect(const CellRect& rect, std::vector<std::uint16_t>& out) const;
+    /** FNV-1a over the rectangle's words (the rectangle's size is part of the hash). */
+    [[nodiscard]] std::uint64_t Checksum(const CellRect& rect) const;
+    [[nodiscard]] static std::uint64_t ChecksumWords(const CellRect& rect, const std::uint16_t* words);
+
+    // ---- writes ----------------------------------------------------------------------------------------------
+
+    /** For commands only: writes words into the document and the sink, no history. */
+    void CommitHeights(const CellRect& rect, const std::uint16_t* words);
+
+    /** A write that did not come from a command (import, test): applied, history cleared, document dirty. */
+    void WriteExternal(const CellRect& rect, const std::uint16_t* words);
+
+    /**
+     * The undoable height edit tools use: `words` is the new content of `rect` (row major). Samples that do not
+     * change are not recorded; returns the number that did. Inside a stroke the edits merge into one command.
+     */
+    std::size_t EditHeights(const CellRect& rect, const std::uint16_t* words);
+
+    /** Executes a command (Do, merge into the stack top or push). */
+    void Execute(std::unique_ptr<Command> command);
+
+    // ---- strokes ---------------------------------------------------------------------------------------------
+
+    /** Edits until EndStroke form one undo step labelled `label`. Nested calls are ignored. */
+    void BeginStroke(const std::string& label);
+    void EndStroke();
+    [[nodiscard]] bool StrokeOpen() const noexcept { return mStroke != 0; }
+
+    // ---- history ---------------------------------------------------------------------------------------------
+
+    HistoryResult Undo();
+    HistoryResult Redo();
+    [[nodiscard]] std::size_t UndoDepth() const noexcept { return mPos; }
+    [[nodiscard]] std::size_t RedoDepth() const noexcept { return mStack.size() - mPos; }
+    [[nodiscard]] std::string UndoLabel() const;
+    [[nodiscard]] std::string RedoLabel() const;
+    [[nodiscard]] std::size_t HistoryBytes() const;
+    void ClearHistory();
+
+    // ---- dirty tracking --------------------------------------------------------------------------------------
+
+    /** True when the document differs from the last MarkClean (or the start). */
+    [[nodiscard]] bool Dirty() const noexcept { return mCleanPos != static_cast<long>(mPos); }
+    void MarkClean() noexcept { mCleanPos = static_cast<long>(mPos); }
+    /** Increases with every change of the document (edit, undo, redo, external write). */
+    [[nodiscard]] std::uint64_t Revision() const noexcept { return mRevision; }
+
+    [[nodiscard]] std::uint64_t StrokeId() const noexcept { return mStroke; }
+
+  private:
+    void Push(std::unique_ptr<Command> command);
+    void Trim();
+
+    int mWidth = 0;
+    int mHeight = 0;
+    std::vector<std::uint16_t> mHeights;
+    HeightSink mSink;
+
+    std::vector<std::unique_ptr<Command>> mStack;
+    std::size_t mPos = 0;   // commands applied; mStack[mPos..] is the redo branch
+    long mCleanPos = 0;     // value of mPos at the last MarkClean; -1 when that state can no longer be reached
+    std::uint64_t mRevision = 0;
+    std::uint64_t mStroke = 0;
+    std::uint64_t mNextStroke = 1;
+    std::string mStrokeLabel;
+  };
+} // namespace moho::editor
diff --git a/src/sdk/moho/editor/tests/MapDocumentTest.cpp b/src/sdk/moho/editor/tests/MapDocumentTest.cpp
new file mode 100644
index 0000000..9e3077a
--- /dev/null
+++ b/src/sdk/moho/editor/tests/MapDocumentTest.cpp
@@ -0,0 +1,269 @@
+// Stand-alone test of MapDocument / the command stack against a plain-array model (no engine needed).
+//   build + run: python scripts/ed_native_tests.py
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <vector>
+
+#include "moho/editor/MapDocument.h"
+
+using moho::editor::CellRect;
+using moho::editor::MapDocument;
+
+static int gFailures = 0;
+#define CHECK(cond, ...)                               \
+  do {                                                 \
+    if (!(cond)) {                                     \
+      ++gFailures;                                     \
+      std::printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+      std::printf(__VA_ARGS__);                        \
+      std::printf("\n");                               \
+    }                                                  \
+  } while (0)
+
+// The model keeps one full copy of the heights per stack position: states[i] = heights with i commands applied.
+struct Harness
+{
+  int w, h;
+  MapDocument doc;
+  std::vector<std::uint16_t> mirror;               // what the sink saw: must always equal the document
+  std::vector<std::vector<std::uint16_t>> states;
+  std::size_t pos = 0;
+
+  Harness(const int width, const int height, std::mt19937& rng) : w(width), h(height)
+  {
+    std::vector<std::uint16_t> start(static_cast<std::size_t>(w) * h);
+    for (auto& v : start) {
+      v = static_cast<std::uint16_t>(rng() % 65536);
+    }
+    mirror = start;
+    states.push_back(start);
+    doc.Reset(w, h, start, [this](const CellRect& r, const std::uint16_t* words) {
+      std::size_t i = 0;
+      for (int z = r.z0; z <= r.z1; ++z) {
+        for (int x = r.x0; x <= r.x1; ++x, ++i) {
+          mirror[static_cast<std::size_t>(z) * this->w + x] = words[i];
+        }
+      }
+    });
+  }
+
+  std::vector<std::uint16_t> Current() const
+  {
+    std::vector<std::uint16_t> out(static_cast<std::size_t>(w) * h);
+    for (int z = 0; z < h; ++z) {
+      for (int x = 0; x < w; ++x) {
+        out[static_cast<std::size_t>(z) * w + x] = doc.HeightAt(x, z);
+      }
+    }
+    return out;
+  }
+
+  void Verify(const char* what)
+  {
+    const auto cur = Current();
+    CHECK(cur == states[pos], "%s: document differs from the model at stack position %zu", what, pos);
+    CHECK(mirror == cur, "%s: sink projection differs from the document", what);
+    CHECK(doc.UndoDepth() == pos, "%s: undo depth %zu, model %zu", what, doc.UndoDepth(), pos);
+    CHECK(doc.RedoDepth() == states.size() - 1 - pos, "%s: redo depth", what);
+  }
+
+  // One edit through the document. `newCommand` tells the model whether it opens a new stack position (a new
+  // command) or merges into the top command of an open stroke.
+  void Apply(const CellRect& r, const std::vector<std::uint16_t>& words, const bool newCommand)
+  {
+    const std::size_t changed = doc.EditHeights(r, words.data());
+    if (changed == 0) {
+      return;
+    }
+    if (newCommand) {
+      states.resize(pos + 1);   // the redo branch is gone
+      states.push_back(Current());
+      pos = states.size() - 1;
+    } else {
+      states[pos] = Current();
+    }
+  }
+
+  std::vector<std::uint16_t> RandomWords(std::mt19937& rng, const CellRect& r, const bool extreme)
+  {
+    std::vector<std::uint16_t> words;
+    doc.ReadRect(r, words);
+    for (auto& v : words) {
+      const unsigned roll = rng() % 4;
+      if (extreme) {
+        v = (rng() & 1) ? 0 : 65535;
+      } else if (roll == 0) {
+        v = static_cast<std::uint16_t>(rng() % 65536);
+      } else if (roll == 1) {
+        v = static_cast<std::uint16_t>(std::min<int>(65535, v + static_cast<int>(rng() % 300)));
+      }
+    }
+    return words;
+  }
+
+  CellRect RandomRect(std::mt19937& rng)
+  {
+    CellRect r;
+    r.x0 = static_cast<int>(rng() % w);
+    r.z0 = static_cast<int>(rng() % h);
+    r.x1 = std::min(w - 1, r.x0 + static_cast<int>(rng() % 40));
+    r.z1 = std::min(h - 1, r.z0 + static_cast<int>(rng() % 40));
+    return r;
+  }
+};
+
+int main()
+{
+  std::mt19937 rng(12345);
+
+  // 1. random single edits, strokes, undo and redo against the model
+  {
+    Harness t(150, 120, rng);
+    bool strokeOpen = false;
+    bool strokeHasCommand = false;
+    const auto endStroke = [&]() {
+      if (strokeOpen) {
+        t.doc.EndStroke();
+        strokeOpen = false;
+        strokeHasCommand = false;
+      }
+    };
+    for (int step = 0; step < 2500; ++step) {
+      const unsigned op = rng() % 10;
+      if (op < 5) {
+        if (!strokeOpen && rng() % 3 == 0) {
+          t.doc.BeginStroke("stroke");
+          strokeOpen = true;
+        }
+        const CellRect r = t.RandomRect(rng);
+        const auto words = t.RandomWords(rng, r, rng() % 7 == 0);
+        const std::size_t depth = t.doc.UndoDepth();
+        const bool newCommand = !(strokeOpen && strokeHasCommand);
+        t.Apply(r, words, newCommand);
+        if (strokeOpen && t.doc.UndoDepth() != depth) {
+          strokeHasCommand = true;
+        }
+      } else if (op < 6) {
+        endStroke();
+      } else if (op < 8) {
+        endStroke();
+        const auto result = t.doc.Undo();
+        if (t.pos > 0) {
+          CHECK(result.ok && result.verified, "undo not verified at step %d", step);
+          --t.pos;
+        } else {
+          CHECK(!result.ok, "undo at the bottom must report nothing");
+        }
+      } else {
+        endStroke();
+        const auto result = t.doc.Redo();
+        if (t.pos + 1 < t.states.size()) {
+          CHECK(result.ok && result.verified, "redo not verified at step %d", step);
+          ++t.pos;
+        } else {
+          CHECK(!result.ok, "redo at the top must report nothing");
+        }
+      }
+      t.Verify("random walk");
+    }
+    endStroke();
+    // undo everything, then redo everything: exact by checksum all the way
+    while (t.doc.UndoDepth() > 0) {
+      CHECK(t.doc.Undo().verified, "undo to the bottom: checksum mismatch");
+      --t.pos;
+    }
+    t.Verify("fully undone");
+    CHECK(t.Current() == t.states[0], "fully undone differs from the start");
+    while (t.doc.RedoDepth() > 0) {
+      CHECK(t.doc.Redo().verified, "redo to the top: checksum mismatch");
+      ++t.pos;
+    }
+    t.Verify("fully redone");
+  }
+
+  // 2. dirty tracking
+  {
+    Harness t(64, 64, rng);
+    const auto edit = [&]() {
+      const CellRect r = t.RandomRect(rng);
+      auto words = t.RandomWords(rng, r, true);
+      t.Apply(r, words, true);
+    };
+    CHECK(!t.doc.Dirty(), "fresh document is clean");
+    edit();
+    edit();
+    CHECK(t.doc.Dirty(), "dirty after edits");
+    t.doc.MarkClean();
+    CHECK(!t.doc.Dirty(), "clean after MarkClean");
+    t.doc.Undo();
+    CHECK(t.doc.Dirty(), "dirty after undo past the clean point");
+    t.doc.Redo();
+    CHECK(!t.doc.Dirty(), "clean again after redo to the clean point");
+    t.doc.Undo();
+    std::vector<std::uint16_t> w(1, 777);
+    t.doc.EditHeights(CellRect{3, 3, 3, 3}, w.data());   // new edit drops the redo branch holding the clean state
+    CHECK(t.doc.Dirty(), "dirty: the clean state is gone with the redo branch");
+    t.doc.MarkClean();
+    t.doc.ClearHistory();
+    CHECK(!t.doc.Dirty(), "clear history of a clean document stays clean");
+    w[0] = 778;
+    t.doc.EditHeights(CellRect{4, 4, 4, 4}, w.data());
+    t.doc.ClearHistory();
+    CHECK(t.doc.Dirty(), "clear history of a dirty document stays dirty");
+    std::vector<std::uint16_t> ext(4, 9);
+    t.doc.MarkClean();
+    t.doc.WriteExternal(CellRect{0, 0, 1, 1}, ext.data());
+    CHECK(t.doc.Dirty() && t.doc.UndoDepth() == 0, "external write: dirty, history gone");
+  }
+
+  // 3. trim: more than kMaxCommands edits keep the newest ones and stay exact
+  {
+    Harness t(40, 40, rng);
+    std::vector<std::vector<std::uint16_t>> history;
+    history.push_back(t.Current());
+    const int count = static_cast<int>(MapDocument::kMaxCommands) + 150;
+    for (int i = 0; i < count; ++i) {
+      std::vector<std::uint16_t> word(1, static_cast<std::uint16_t>(i + 1));
+      const int x = i % 40;
+      const int z = (i / 40) % 40;
+      t.doc.EditHeights(CellRect{x, z, x, z}, word.data());
+      history.push_back(t.Current());
+    }
+    CHECK(t.doc.UndoDepth() == MapDocument::kMaxCommands, "trim kept %zu commands", t.doc.UndoDepth());
+    for (std::size_t i = 0; i < MapDocument::kMaxCommands; ++i) {
+      CHECK(t.doc.Undo().verified, "trimmed history undo mismatch");
+    }
+    CHECK(t.Current() == history[150], "undoing the whole trimmed history lands on the state 150 edits in");
+  }
+
+  // 4. a stroke across tile borders is one undo step; labels
+  {
+    Harness t(200, 200, rng);
+    t.doc.BeginStroke("raise");
+    for (int i = 0; i < 40; ++i) {
+      const CellRect r{i * 4, i * 4, i * 4 + 11, i * 4 + 11};
+      std::vector<std::uint16_t> words;
+      t.doc.ReadRect(r, words);
+      for (auto& v : words) {
+        v = static_cast<std::uint16_t>(std::min<int>(65535, v + 50));
+      }
+      t.doc.EditHeights(r, words.data());
+    }
+    t.doc.EndStroke();
+    CHECK(t.doc.UndoDepth() == 1, "40 dabs of one stroke are one undo step, got %zu", t.doc.UndoDepth());
+    CHECK(t.doc.UndoLabel() == "raise", "label");
+    CHECK(t.doc.Undo().verified, "stroke undo verified");
+    CHECK(t.Current() == t.states[0], "stroke undo restores the start");
+    CHECK(t.doc.RedoLabel() == "raise", "redo label");
+    CHECK(t.doc.Redo().verified, "stroke redo verified");
+  }
+
+  if (gFailures == 0) {
+    std::printf("PASS MapDocumentTest\n");
+    return 0;
+  }
+  std::printf("%d failure(s)\n", gFailures);
+  return 1;
+}
