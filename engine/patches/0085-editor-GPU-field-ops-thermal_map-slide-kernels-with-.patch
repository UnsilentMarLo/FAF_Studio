+)HLSL";
+
+  // field_slide_a: 16x16x1 threads
+  inline constexpr char kSource_field_slide_a[] =
+    R"HLSL(// HLSL side of the kernel language (docs/projects/editor/GPU_COMPUTE.md). scripts/gen_gpu_shaders.py puts this file in front of every kernel it embeds; the C++ test shim
+// (hlsl_cpp_shim.h) defines the SAME macro names for g++ / MSVC. A kernel therefore never writes cbuffer, register(), StructuredBuffer, [numthreads], SV_ or groupshared itself.
+//
+// Resource slots: constant buffer b0 (one per kernel), shader resource views t0..t15, unordered access views u0..u7, samplers s0 (linear, clamp) and s1 (point, clamp).
+// The SRV slot numbers are shared between buffers and textures (SRV_BUFFER(.., 0) and SRV_TEX(.., 0) would collide), the same for UAVs.
+
+#define CBUFFER(Type, name, slot) cbuffer name##_cb : register(b##slot) { Type name; };
+#define SRV_BUFFER(T, name, slot) StructuredBuffer<T> name : register(t##slot);
+#define UAV_BUFFER(T, name, slot) RWStructuredBuffer<T> name : register(u##slot);
+#define SRV_TEX(name, slot) Texture2D<float> name : register(t##slot);
+#define UAV_TEX(name, slot) RWTexture2D<float> name : register(u##slot);
+#define SAMPLER(name, slot) SamplerState name : register(s##slot);
+#define GROUPSHARED(T, name, n) groupshared T name[n];
+#define NUMTHREADS(x, y, z) [numthreads(x, y, z)]
+#define KERNEL_IDS uint3 dtid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID, uint gidx : SV_GroupIndex
+
+// Kernels with group shared memory split their body into phases at top level: PHASES_BEGIN, code, BARRIER(); code, ..., PHASES_END. Every phase is its own scope (a local does not
+// live across a BARRIER, on the GPU as in the emulation).
+#define PHASES_BEGIN {
+#define BARRIER() GroupMemoryBarrierWithGroupSync(); } {
+#define PHASES_END }
+
+#define UNROLL [unroll]
+#define LOOP [loop]
+#define OUT(T) out T
+#define INOUT(T) inout T
+#define FN
+
+// Slides of a loose layer, pass A (EdFieldEro2.cpp SlideT, first loop): for every cell, the share of its excess over the talus that slides to each lower neighbour (rate * 0.5 * largest
+// excess / sum of the excesses; the drop to a neighbour above the talus of the cell it leaves, rise per run, times cell or cell * sqrt(2)) and the amount that leaves in total. A cell on
+// a rock layer never gives more than its loose layer holds. Pass B collects. The border: a missing neighbour never gives or takes.
+// ---- begin common.hlsli
+// Helpers every kernel may use. Plain functions and constants only (this file is compiled as HLSL and as C++ by the test shim). Include it with #include "common.hlsli".
+#ifndef GPU_COMMON_HLSLI
+#define GPU_COMMON_HLSLI
+
+// Row-major index of sample (x, z) in a field of width w.
+FN uint FieldIndex(uint x, uint z, uint w)
+{
+    return z * w + x;
+}
+
+// Integer clamp of a lookup coordinate to 0..n-1 (the CPU ops' "clamp" edge mode).
+FN int ClampIndex(int i, int n)
+{
+    return max(0, min(n - 1, i));
+}
+
+// 32 bit integer hash (lowbias32): equal bits on the CPU and on the GPU.
+FN uint Hash32(uint x)
+{
+    x ^= x >> 16;
+    x *= 0x7feb352du;
+    x ^= x >> 15;
+    x *= 0x846ca68bu;
+    x ^= x >> 16;
+    return x;
+}
+
+// A hash as a float in 0..1 (24 bit steps, exact in float32).
+FN float HashToUnit(uint h)
+{
+    return float(h >> 8) * (1.0f / 16777216.0f);
+}
+
+#endif
+// ---- end common.hlsli
+// ---- begin field_slide_params.hlsli
+// Constant buffer of field_slide_a.hlsl and field_slide_b.hlsl (ops thermal_map, erode_rocksoil, erode_snow, erode_wind: slides of a loose layer).
+#ifndef GPU_FIELD_SLIDE_PARAMS_HLSLI
+#define GPU_FIELD_SLIDE_PARAMS_HLSLI
+
+struct SlideParams
+{
+    uint w;
+    uint h;
+    uint hasRock;     // 1 = the loose layer lies on a rock layer (surface = rock + loose; a cell never gives more than its loose layer holds)
+    uint hasMap;      // 1 = a talus value per cell (a buffer), 0 = the constant `talus`
+    uint hasMask;     // 1 = a rate factor per cell (a buffer)
+    uint hasGain;     // 1 = what arrived is added to the `gain` buffer
+    uint hasLost;     // 1 = what left is added to the `lost` buffer
+    uint pad0;
+    float cell;
+    float talus;      // rise per run
+    float rate;
+    float pad1;
+};
+
+#endif
+// ---- end field_slide_params.hlsli
+
+CBUFFER(SlideParams, P, 0)
+SRV_BUFFER(float, loose, 0)
+SRV_BUFFER(float, rock, 1)
+SRV_BUFFER(float, tmap, 2)
+SRV_BUFFER(float, rmask, 3)
+UAV_BUFFER(float, share, 0)
+UAV_BUFFER(float, moved, 1)
+
+static const int kSlideDx[8] = {-1, 1, 0, 0, -1, 1, -1, 1};
+static const int kSlideDz[8] = {0, 0, -1, 1, -1, -1, 1, 1};
+
+FN float Surf(uint j)
+{
+    if (P.hasRock != 0u) return rock[j] + loose[j];
+    return loose[j];
+}
+
+NUMTHREADS(16, 16, 1)
+void CSMain(KERNEL_IDS)
+{
+    if (dtid.x >= P.w || dtid.y >= P.h) return;
+    int x = int(dtid.x);
+    int z = int(dtid.y);
+    int w = int(P.w);
+    int h = int(P.h);
+    uint i = dtid.y * P.w + dtid.x;
+    float talus = P.talus;
+    if (P.hasMap != 0u) talus = tmap[i];
+    float c = Surf(i);
+    float tA = talus * P.cell;
+    float tD = talus * P.cell * 1.41421356f;
+    float maxEx = 0.0f;
+    float sumEx = 0.0f;
+    UNROLL for (int k = 0; k < 8; ++k)
+    {
+        int nx = x + kSlideDx[k];
+        int nz = z + kSlideDz[k];
+        if (nx >= 0 && nz >= 0 && nx < w && nz < h)
+        {
+            float thr = tA;
+            if (k >= 4) thr = tD;
+            float ex = (c - Surf(uint(nz) * P.w + uint(nx))) - thr;
+            if (ex > 0.0f)
+            {
+                sumEx += ex;
+                maxEx = max(maxEx, ex);
+            }
+        }
+    }
+    float s = 0.0f;
+    float mv = 0.0f;
+    if (sumEx > 0.0f)
+    {
+        float r = P.rate;
+        if (P.hasMask != 0u) r *= saturate(rmask[i]);
+        s = r * 0.5f * maxEx / sumEx;
+        mv = s * sumEx;
+        if (P.hasRock != 0u && mv > loose[i])
+        {
+            float f = 0.0f;
+            if (loose[i] > 0.0f) f = loose[i] / mv;
+            s *= f;
+            mv = loose[i];
+        }
+    }
+    share[i] = s;
+    moved[i] = mv;
+}
+
+)HLSL";
+
+  // field_slide_b: 16x16x1 threads
+  inline constexpr char kSource_field_slide_b[] =
+    R"HLSL(// HLSL side of the kernel language (docs/projects/editor/GPU_COMPUTE.md). scripts/gen_gpu_shaders.py puts this file in front of every kernel it embeds; the C++ test shim
+// (hlsl_cpp_shim.h) defines the SAME macro names for g++ / MSVC. A kernel therefore never writes cbuffer, register(), StructuredBuffer, [numthreads], SV_ or groupshared itself.
+//
+// Resource slots: constant buffer b0 (one per kernel), shader resource views t0..t15, unordered access views u0..u7, samplers s0 (linear, clamp) and s1 (point, clamp).
+// The SRV slot numbers are shared between buffers and textures (SRV_BUFFER(.., 0) and SRV_TEX(.., 0) would collide), the same for UAVs.
+
+#define CBUFFER(Type, name, slot) cbuffer name##_cb : register(b##slot) { Type name; };
+#define SRV_BUFFER(T, name, slot) StructuredBuffer<T> name : register(t##slot);
+#define UAV_BUFFER(T, name, slot) RWStructuredBuffer<T> name : register(u##slot);
+#define SRV_TEX(name, slot) Texture2D<float> name : register(t##slot);
+#define UAV_TEX(name, slot) RWTexture2D<float> name : register(u##slot);
+#define SAMPLER(name, slot) SamplerState name : register(s##slot);
+#define GROUPSHARED(T, name, n) groupshared T name[n];
+#define NUMTHREADS(x, y, z) [numthreads(x, y, z)]
+#define KERNEL_IDS uint3 dtid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID, uint gidx : SV_GroupIndex
+
+// Kernels with group shared memory split their body into phases at top level: PHASES_BEGIN, code, BARRIER(); code, ..., PHASES_END. Every phase is its own scope (a local does not
+// live across a BARRIER, on the GPU as in the emulation).
+#define PHASES_BEGIN {
+#define BARRIER() GroupMemoryBarrierWithGroupSync(); } {
+#define PHASES_END }
+
+#define UNROLL [unroll]
+#define LOOP [loop]
+#define OUT(T) out T
+#define INOUT(T) inout T
+#define FN
+
+// Slides of a loose layer, pass B (EdFieldEro2.cpp SlideT, second loop): next = loose - what the cell gave away + what its higher neighbours give it; `gain` / `lost` (optional) add what
+// arrived / left.
+// ---- begin common.hlsli
+// Helpers every kernel may use. Plain functions and constants only (this file is compiled as HLSL and as C++ by the test shim). Include it with #include "common.hlsli".
+#ifndef GPU_COMMON_HLSLI
+#define GPU_COMMON_HLSLI
+
+// Row-major index of sample (x, z) in a field of width w.
+FN uint FieldIndex(uint x, uint z, uint w)
+{
+    return z * w + x;
+}
+
+// Integer clamp of a lookup coordinate to 0..n-1 (the CPU ops' "clamp" edge mode).
+FN int ClampIndex(int i, int n)
+{
+    return max(0, min(n - 1, i));
+}
+
+// 32 bit integer hash (lowbias32): equal bits on the CPU and on the GPU.
+FN uint Hash32(uint x)
+{
+    x ^= x >> 16;
+    x *= 0x7feb352du;
+    x ^= x >> 15;
+    x *= 0x846ca68bu;
+    x ^= x >> 16;
+    return x;
+}
+
+// A hash as a float in 0..1 (24 bit steps, exact in float32).
+FN float HashToUnit(uint h)
+{
+    return float(h >> 8) * (1.0f / 16777216.0f);
+}
+
+#endif
+// ---- end common.hlsli
+// ---- begin field_slide_params.hlsli
+// Constant buffer of field_slide_a.hlsl and field_slide_b.hlsl (ops thermal_map, erode_rocksoil, erode_snow, erode_wind: slides of a loose layer).
+#ifndef GPU_FIELD_SLIDE_PARAMS_HLSLI
+#define GPU_FIELD_SLIDE_PARAMS_HLSLI
+
+struct SlideParams
+{
+    uint w;
+    uint h;
+    uint hasRock;     // 1 = the loose layer lies on a rock layer (surface = rock + loose; a cell never gives more than its loose layer holds)
+    uint hasMap;      // 1 = a talus value per cell (a buffer), 0 = the constant `talus`
+    uint hasMask;     // 1 = a rate factor per cell (a buffer)
+    uint hasGain;     // 1 = what arrived is added to the `gain` buffer
+    uint hasLost;     // 1 = what left is added to the `lost` buffer
+    uint pad0;
+    float cell;
+    float talus;      // rise per run
+    float rate;
+    float pad1;
+};
+
+#endif
+// ---- end field_slide_params.hlsli
+
+CBUFFER(SlideParams, P, 0)
+SRV_BUFFER(float, loose, 0)
+SRV_BUFFER(float, rock, 1)
+SRV_BUFFER(float, tmap, 2)
+SRV_BUFFER(float, share, 3)
+SRV_BUFFER(float, moved, 4)
+UAV_BUFFER(float, nxt, 0)
+UAV_BUFFER(float, gain, 1)
+UAV_BUFFER(float, lost, 2)
+
+static const int kSlideDx[8] = {-1, 1, 0, 0, -1, 1, -1, 1};
+static const int kSlideDz[8] = {0, 0, -1, 1, -1, -1, 1, 1};
+
+FN float Surf(uint j)
+{
+    if (P.hasRock != 0u) return rock[j] + loose[j];
+    return loose[j];
+}
+
+NUMTHREADS(16, 16, 1)
+void CSMain(KERNEL_IDS)
+{
+    if (dtid.x >= P.w || dtid.y >= P.h) return;
+    int x = int(dtid.x);
+    int z = int(dtid.y);
+    int w = int(P.w);
+    int h = int(P.h);
+    uint i = dtid.y * P.w + dtid.x;
+    float c = Surf(i);
+    float got = 0.0f;
+    UNROLL for (int k = 0; k < 8; ++k)
+    {
+        int nx = x + kSlideDx[k];
+        int nz = z + kSlideDz[k];
+        if (nx >= 0 && nz >= 0 && nx < w && nz < h)
+        {
+            uint j = uint(nz) * P.w + uint(nx);
+            float tj = P.talus;
+            if (P.hasMap != 0u) tj = tmap[j];
+            float f = 1.0f;
+            if (k >= 4) f = 1.41421356f;
+            float ex = (Surf(j) - c) - tj * P.cell * f;
+            if (ex > 0.0f) got += share[j] * ex;
+        }
+    }
+    nxt[i] = loose[i] - moved[i] + got;
+    if (P.hasGain != 0u) gain[i] = gain[i] + got;
+    if (P.hasLost != 0u) lost[i] = lost[i] + moved[i];
+}
+
 )HLSL";
 
