From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marlo <Plays.xenon@yahoo.de>
Date: Sun, 18 Oct 2026 01:10:57 +0200
Subject: [PATCH] Editor: rebuild the water surface quad after the water switch
 / elevations change; ed_world_set raises the render-context rebuild flag

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/src/sdk/moho/editor/EdWorld.cpp b/src/sdk/moho/editor/EdWorld.cpp
index 529e82f..49db1ff 100644
--- a/src/sdk/moho/editor/EdWorld.cpp
+++ b/src/sdk/moho/editor/EdWorld.cpp
@@ -25,7 +25,9 @@
 #include "moho/sim/CWldMap.h"
 #include "moho/sim/CWldSession.h"
 #include "moho/sim/STIMap.h"
+#include "moho/terrain/splat/CWldSplat.h"
 #include "moho/terrain/water/CWaterShaderProperties.h"
+#include "moho/terrain/water/WaterFactory.h"
 
 namespace
 {
@@ -148,6 +150,12 @@ namespace
     lua_settop(L, -2);
     if (lua_toboolean(L, 2) != 0) {
       t->UpdateWaterMap();
+      moho::EdRefreshWaterSurfaces(t);
+    }
+    // The renderer re-reads the numbers only when it rebuilds its render context, which it does when the camera moved, the terrain is in edit
+    // mode or the decal manager has pending changes (HighFidelityTerrain::UpdateRenderContext): with a still camera a change would not show.
+    if (moho::IDecalManager* const decals = t->GetDecalManager(); decals != nullptr) {
+      decals->MarkPendingChanges();
     }
     lua_pushboolean(L, 1);
     return 1;
diff --git a/src/sdk/moho/terrain/HighFidelityTerrain.cpp b/src/sdk/moho/terrain/HighFidelityTerrain.cpp
index f233388..1b072e5 100644
--- a/src/sdk/moho/terrain/HighFidelityTerrain.cpp
+++ b/src/sdk/moho/terrain/HighFidelityTerrain.cpp
@@ -1846,4 +1846,14 @@ namespace moho
     }
     return object;
   }
+
+  // EDITOR: the water quad is built once at map load, at the water elevation of that moment (far below the map when the map has no water), so the
+  // editor rebuilds it after the water switch or an elevation changed.
+  void EdRefreshWaterSurfaceHigh(IWldTerrainRes* terrainResource)
+  {
+    if (sHighFidelityWaterSurface != nullptr) {
+      (void)sHighFidelityWaterSurface->InitVerts(terrainResource);
+    }
+  }
+
 } // namespace moho
diff --git a/src/sdk/moho/terrain/LowFidelityTerrain.cpp b/src/sdk/moho/terrain/LowFidelityTerrain.cpp
index 4fc7914..2c69fa2 100644
--- a/src/sdk/moho/terrain/LowFidelityTerrain.cpp
+++ b/src/sdk/moho/terrain/LowFidelityTerrain.cpp
@@ -1198,4 +1198,14 @@ namespace moho
       mTerrainIndexSheet->Unlock();
     }
   }
+
+  // EDITOR: the water quad is built once at map load, at the water elevation of that moment (far below the map when the map has no water), so the
+  // editor rebuilds it after the water switch or an elevation changed.
+  void EdRefreshWaterSurfaceLow(IWldTerrainRes* terrainResource)
+  {
+    if (sTerrainWaterSurface != nullptr) {
+      (void)sTerrainWaterSurface->InitVerts(terrainResource);
+    }
+  }
+
 } // namespace moho
diff --git a/src/sdk/moho/terrain/MediumFidelityTerrain.cpp b/src/sdk/moho/terrain/MediumFidelityTerrain.cpp
index c8d9d00..b1c5aa7 100644
--- a/src/sdk/moho/terrain/MediumFidelityTerrain.cpp
+++ b/src/sdk/moho/terrain/MediumFidelityTerrain.cpp
@@ -1758,4 +1758,14 @@ namespace moho
     }
     return object;
   }
+
+  // EDITOR: the water quad is built once at map load, at the water elevation of that moment (far below the map when the map has no water), so the
+  // editor rebuilds it after the water switch or an elevation changed.
+  void EdRefreshWaterSurfaceMedium(IWldTerrainRes* terrainResource)
+  {
+    if (sMediumFidelityWaterSurface != nullptr) {
+      (void)sMediumFidelityWaterSurface->InitVerts(terrainResource);
+    }
+  }
+
 } // namespace moho
diff --git a/src/sdk/moho/terrain/water/WaterFactory.cpp b/src/sdk/moho/terrain/water/WaterFactory.cpp
index c9f4f52..3f2b394 100644
--- a/src/sdk/moho/terrain/water/WaterFactory.cpp
+++ b/src/sdk/moho/terrain/water/WaterFactory.cpp
@@ -71,4 +71,15 @@ namespace moho
     }
     return result;
   }
+
+  void EdRefreshWaterSurfaceHigh(IWldTerrainRes* terrainResource);
+  void EdRefreshWaterSurfaceMedium(IWldTerrainRes* terrainResource);
+  void EdRefreshWaterSurfaceLow(IWldTerrainRes* terrainResource);
+
+  void EdRefreshWaterSurfaces(IWldTerrainRes* const terrainResource)
+  {
+    EdRefreshWaterSurfaceHigh(terrainResource);
+    EdRefreshWaterSurfaceMedium(terrainResource);
+    EdRefreshWaterSurfaceLow(terrainResource);
+  }
 } // namespace moho
diff --git a/src/sdk/moho/terrain/water/WaterFactory.h b/src/sdk/moho/terrain/water/WaterFactory.h
index 0205e08..2c02d10 100644
--- a/src/sdk/moho/terrain/water/WaterFactory.h
+++ b/src/sdk/moho/terrain/water/WaterFactory.h
@@ -12,4 +12,9 @@ namespace moho
    * logs the selected path, and initializes water render sheets.
    */
   [[nodiscard]] WaterSurface* CreateWaterFidelity(IWldTerrainRes* terrainResource);
+
+  /**
+   * EDITOR: rebuilds the water surface quad of every fidelity that exists, from the terrain's current water switch and elevation.
+   */
+  void EdRefreshWaterSurfaces(IWldTerrainRes* terrainResource);
 } // namespace moho
