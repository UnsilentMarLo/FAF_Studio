From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marlo <Plays.xenon@yahoo.de>
Date: Mon, 19 Oct 2026 02:44:45 +0200
Subject: [PATCH] editor mesh terrain: range ring and vision volumes cover the
 mesh height band


diff --git a/src/sdk/moho/editor/EdMeshDraw.cpp b/src/sdk/moho/editor/EdMeshDraw.cpp
index c1a31b0..7f47840 100644
--- a/src/sdk/moho/editor/EdMeshDraw.cpp
+++ b/src/sdk/moho/editor/EdMeshDraw.cpp
@@ -26,6 +26,8 @@
 #include "moho/render/Shadow.h"
 #include "moho/render/camera/GeomCamera3.h"
 #include "moho/render/d3d/CD3DDevice.h"
+#include "moho/misc/StartupHelpers.h"
+#include "moho/render/WRenViewport.h"
 #include "moho/render/d3d/CD3DRenderTarget.h"
 #include "moho/sim/STIMap.h"
 #include "moho/terrain/water/CWaterShaderProperties.h"
@@ -560,6 +562,23 @@ float4 PS() : COLOR {
       ReleaseAll();
     }
 
+    void ApplyHeightBands()
+    {
+      float low = 0.0f, high = 0.0f;
+      if (!gMap.Loaded() || !gMap.HeightRange(32.0f, low, high)) {
+        return;
+      }
+      // (the engine's names are swapped: `patch_maxMapHeight` holds the bottom of the band, `patch_minMapHeight` its top, see Sim_Create_exxt)
+      moho::patch_maxMapHeight = std::min(moho::patch_maxMapHeight, low - 5.0f);
+      moho::patch_minMapHeight = std::max(moho::patch_minMapHeight, high + 30.0f);
+      if (CD3DDevice* const device = D3D_GetDevice(); device != nullptr) {
+        if (WRenViewport* const viewport = device->GetViewport(); viewport != nullptr) {
+          viewport->mRangeRenderer.Init();
+          viewport->mVisionRenderer.Init();
+        }
+      }
+    }
+
     // ---- the surface pass -----------------------------------------------------------------------------------------------------------
 
     bool DrawSurface(const GeomCamera3& camera, Shadow* const shadow, const CWaterShaderProperties* const water)
diff --git a/src/sdk/moho/editor/EdMeshLua.cpp b/src/sdk/moho/editor/EdMeshLua.cpp
index 0d563cf..e49bcb0 100644
--- a/src/sdk/moho/editor/EdMeshLua.cpp
+++ b/src/sdk/moho/editor/EdMeshLua.cpp
@@ -51,6 +51,7 @@ namespace
       lua_pushstring(L, moho::edmesh::Map().error.c_str());
       return 2;
     }
+    moho::edmesh::ApplyHeightBands();
     lua_pushboolean(L, 1);
     return 1;
   }
diff --git a/src/sdk/moho/editor/EdMeshTerrain.h b/src/sdk/moho/editor/EdMeshTerrain.h
index 582d1b0..06c479c 100644
--- a/src/sdk/moho/editor/EdMeshTerrain.h
+++ b/src/sdk/moho/editor/EdMeshTerrain.h
@@ -50,6 +50,10 @@ namespace moho
     /// The ray under a pixel of the world view (`px`, `py` from the view's top left, `vw` x `vh` its size): origin and unit direction. False before the first frame.
     bool CameraRay(float px, float py, float vw, float vh, float origin[3], float dir[3]);
 
+    /// Widens the height band of the range ring and vision volumes to the mesh (lowest vertex in the playable area - 5 .. highest + 30; the retail patch does
+    /// the same with the manifest's ground_low / mesh_high) and rebuilds those volumes. They read the height field's range once, when the sim is created.
+    void ApplyHeightBands();
+
     /// Frees the GPU copies (map unload, device reset).
     void ReleaseGpu();
 
