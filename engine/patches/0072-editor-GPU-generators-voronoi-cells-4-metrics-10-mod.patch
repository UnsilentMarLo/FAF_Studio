+    if (P.outKind == 1u)
+    {
+        r = 1.0f - SmoothStep(1.0f - P.edge, 1.0f, q);
+    }
+    else if (P.outKind == 2u)
+    {
+        r = saturate(1.0f - q);
+    }
+    else
+    {
+        float land = 1.0f - SmoothStep(1.0f - P.edge, 1.0f, q);
+        r = land * pow(saturate(1.0f - q * 0.9f), P.power);
+    }
+    dst[row * P.w + dtid.x] = r;
