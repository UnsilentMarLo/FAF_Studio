+        RegisterGpuOp("cracks", &OpCracksGpu);
+        RegisterGpuOp("craters", &OpCratersGpu);
+        RegisterGpuOp("dunes", &OpDunesGpu);
+        RegisterGpuOp("island", &OpIslandGpu);
       }
     };
     const Registrar gRegistrar;
