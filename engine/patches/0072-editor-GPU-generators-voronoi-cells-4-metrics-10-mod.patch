+
+struct IslandParams
+{
+    uint w;
+    uint z0;
+    uint rows;
+    uint seed;
+    uint outKind;      // 0 height, 1 mask, 2 distance
+    uint pad0;
+    uint pad1;
+    uint pad2;
+    float u0;         // position relative to the centre, turned and squashed: u = u0 + ua x + ub z, v = v0 + va x + vb z (world units)
