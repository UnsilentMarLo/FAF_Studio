+int main()
+{
+  TestShim();
+  TestKernelTable();
+  TestScaleOffset();
+  TestReduceBarriers();
+  TestBlurKernelsDirect();
+  TestPolicyAndFallback();
+  TestThreads();
+  TestSelfTestFirst();
+  TestSelfTestOnEmulator();
+  TestIterations();
+  TestFieldHelpers();
+  TestCoreHooks();
+  TestRealBackend();
+  std::printf("EdGpuTest: %d checks, %d failures\n", gChecks, gFailures);
+  return gFailures == 0 ? 0 : 1;
