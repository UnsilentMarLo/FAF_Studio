+#define CHECK(cond, ...)                               \
+  do {                                                 \
+    ++gChecks;                                         \
+    if (!(cond)) {                                     \
+      ++gFailures;                                     \
+      std::printf("FAIL %s:%d: ", __FILE__, __LINE__); \
