@@ -0,0 +1,261 @@
+// EDITOR GPU compute backend (docs/projects/editor/GPU_COMPUTE.md). A SEPARATE Direct3D 11 device with compute shaders (cs_5_0) next to the game's Direct3D 9 renderer: the field
+// engine's heavy ops (erosion, generators, filters) can run there and fall back to the CPU ops on any problem.
+//
+// This header is plain C++ (no Windows, no Direct3D): the kernels, the op glue and the tests use it, only EdGpu.cpp knows Direct3D 11. The pieces:
+//
+//   KernelInfo      one compute shader: name, HLSL source (embedded by scripts/gen_gpu_shaders.py from gpu/<name>.hlsl), thread group size, which slots it uses.
+//   Resource        a structured buffer (element count x stride) or an R32_FLOAT 2D texture on the device. Made by an Executor, owned by the caller (unique_ptr).
+//   Executor        what runs kernels: the Direct3D 11 one (EdGpu.cpp) or the CPU emulator of the tests (tests/EdGpuEmu.h). Create / Upload / Download / Dispatch / Sync.
+//   Backend, Lease  the process-wide access: `Lease lease; if (!lease) { /* CPU */ } Executor& ex = *lease;` takes the one lock, creates the device on first use, never throws.
+//   Field, PingPong helpers for fields (w * h floats) and double buffering; DispatchGrid for a kernel over a 2D grid; RunIterations for long loops in time-limited submissions.
+//
+// Rules for everything that runs on an Executor (the full text is in the document): bool results with `err` set, never an exception through the API, never a wait without a limit,
+// resources must not outlive the Lease they were made under, and an op that fails leaves its output untouched so the CPU op can run instead.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+#include "moho/editor/EdFieldCore.h"
+
+namespace moho::editor::gpu
+{
+  using u32 = std::uint32_t;
+  using u64 = std::uint64_t;
+
+  inline constexpr u32 kMaxSrv = 16;
+  inline constexpr u32 kMaxUav = 8;
+  inline constexpr u32 kMaxSamplers = 2;       // s0 linear + clamp, s1 point + clamp
+  inline constexpr u32 kMaxGroups = 65535;     // per dimension (cs_5_0)
+
+  // ---- kernels -------------------------------------------------------------------------------------------------------------------------------
+
+  /** One compute shader. The table kKernels (EdGpuShaders.generated.h) is generated; a kernel is found by name with FindKernel. */
+  struct KernelInfo
+  {
+    const char* name;      // the file name without .hlsl
+    const char* source;    // the complete HLSL text (prelude + kernel + inlined includes)
+    const char* entry;     // "CSMain"
+    u32 tx, ty, tz;        // threads per group (NUMTHREADS)
+    u32 srvMask;           // bit s = the kernel reads slot t<s>
+    u32 uavMask;           // bit s = the kernel writes slot u<s>
+    u32 srvTexMask;        // the slots of srvMask that are textures (the others are structured buffers)
+    u32 uavTexMask;
+    u32 samplerMask;
+    u32 hasCb;             // 1 = constant buffer b0
+    u64 hash;              // FNV-1a of source: the key of the compiled-shader caches
+  };
+
+  /** The generated kernel `name`, or null. */
+  [[nodiscard]] const KernelInfo* FindKernel(const char* name);
+  /** Number of generated kernels. */
+  [[nodiscard]] int KernelCount();
+  [[nodiscard]] const KernelInfo& KernelAt(int index);
+
+  // ---- resources -----------------------------------------------------------------------------------------------------------------------------
+
+  /** A buffer or texture on the device. The fields are read-only for everyone but the Executor that made it. */
+  class Resource
+  {
+  public:
+    enum class Kind { Buffer, Texture2D };
+    virtual ~Resource() = default;
+    Kind kind = Kind::Buffer;
+    u32 count = 0;     // buffer: elements
+    u32 stride = 4;    // buffer: bytes per element
+    u32 w = 0;         // texture: size
+    u32 h = 0;
+    [[nodiscard]] std::size_t Bytes() const { return kind == Kind::Buffer ? static_cast<std::size_t>(count) * stride : static_cast<std::size_t>(w) * h * 4u; }
+  };
+
+  /** The resources of one dispatch by slot (null = unbound). A resource must not appear as SRV and UAV of the same dispatch. */
+  struct Bindings
+  {
+    const Resource* srv[kMaxSrv] = {};
+    const Resource* uav[kMaxUav] = {};
+    Bindings& Srv(const u32 slot, const Resource& r) { if (slot < kMaxSrv) srv[slot] = &r; return *this; }
+    Bindings& Uav(const u32 slot, const Resource& r) { if (slot < kMaxUav) uav[slot] = &r; return *this; }
+  };
+
+  struct Groups
+  {
+    u32 x = 1, y = 1, z = 1;
+  };
+
+  /**
+   * Runs kernels. All calls come from the thread that holds the Lease. Every method returns false with `err` set instead of throwing. Resource contents are undefined after
+   * CreateBuffer / CreateTexture (a recycled buffer is not cleared): Upload or write them before reading.
+   */
+  class Executor
+  {
+  public:
+    virtual ~Executor() = default;
+    [[nodiscard]] virtual const char* Name() const = 0;
+    /** A structured buffer of `count` elements of `stride` bytes (a multiple of 4). */
+    virtual std::unique_ptr<Resource> CreateBuffer(u32 count, u32 stride, std::string& err) = 0;
+    /** An R32_FLOAT texture, shader resource and unordered access. */
+    virtual std::unique_ptr<Resource> CreateTexture(u32 w, u32 h, std::string& err) = 0;
+    virtual bool Upload(Resource& r, const void* data, std::size_t bytes, std::string& err) = 0;
+    /** Waits for the device (with a time limit) and copies the resource into `data` (bytes <= r.Bytes()). */
+    virtual bool Download(Resource& r, void* data, std::size_t bytes, std::string& err) = 0;
+    /** `cb`/`cbBytes`: the constant buffer b0 (bytes a multiple of 16, at most 4096; null when the kernel has none). */
+    virtual bool Dispatch(const KernelInfo& k, Groups groups, const void* cb, u32 cbBytes, const Bindings& b, std::string& err) = 0;
+    /** Submits everything queued and waits for it (with a time limit). `gpuMs` (may be null) = device time of the work since the last Sync, or the wall time when unknown. */
+    virtual bool Sync(double* gpuMs, std::string& err) = 0;
+    /** Largest total size of resources one op may hold (a fraction of the video memory). */
+    [[nodiscard]] virtual u64 MaxBytes() const = 0;
+    [[nodiscard]] virtual bool SupportsTextures() const { return true; }
+    /** True once the device was removed / reset / timed out: the caller reports it with Lease::Fail and stops using the GPU. */
+    [[nodiscard]] virtual bool DeviceLost() const { return false; }
+  };
+
+  // ---- backend -------------------------------------------------------------------------------------------------------------------------------
+
+  struct BackendInfo
+  {
+    bool compiledIn = false;      // false: built without Direct3D 11 (tests on other systems)
+    bool tried = false;           // device creation was attempted
+    bool available = false;       // a device exists and works
+    bool failed = false;          // marked unavailable for the rest of the session (error, device removed, timeout)
+    bool textures = false;
+    std::string adapter;
+    std::string featureLevel;
+    std::string compiler;         // d3dcompiler_47.dll ...
+    std::string lastError;
+    u64 vramMB = 0;
+    u64 maxBytes = 0;
+  };
+
+  class Backend
+  {
+  public:
+    virtual ~Backend() = default;
+    /** What is known now; `probe` = try to create the device first when that has not been tried (blocks while another thread uses the device). */
+    virtual BackendInfo Info(bool probe) = 0;
+    /** false when the backend is known not to work (not compiled in, creation failed, marked failed): ops skip the GPU without taking the lock. */
+    virtual bool MayWork() = 0;
+    /** Takes the lock and returns the executor (creating the device on first use), or null (busy / unavailable; `err` says why). Pair with Release(). */
+    virtual Executor* Acquire(bool wait, bool& busy, std::string& err) = 0;
+    virtual void Release() = 0;
+    /** The device is unusable: every later Acquire returns null until Reset. Does not release the device objects (they may be stuck). */
+    virtual void MarkFailed(const std::string& why) = 0;
+    /** Forgets a failure and the device so the next use creates a new one. */
+    virtual void Reset() = 0;
+  };
+
+  /** Where the backend writes its log lines (shader compile errors, device creation, failures). EdGpuLua.cpp points it at the engine's log; null = no log. */
+  using LogFn = void (*)(const char* line);
+  void SetLogSink(LogFn fn);
+
+  /** The process-wide backend (Direct3D 11 on Windows). */
+  [[nodiscard]] Backend& CurrentBackend();
+  /** Tests: use `b` instead (null restores the real one). */
+  void SetBackendForTest(Backend* b);
+  /** The adapter the game's Direct3D 9 device runs on (0 = unknown): the backend prefers the same vendor / device. Call from the thread that owns the D3D9 device. */
+  void SetPreferredAdapter(u32 vendorId, u32 deviceId);
+
+  /** RAII access to the backend: holds its lock while alive. Not copyable. A thread that already holds a Lease gets none (no nested use). */
+  class Lease
+  {
+  public:
+    explicit Lease(bool wait = false);
+    ~Lease();
+    Lease(const Lease&) = delete;
+    Lease& operator=(const Lease&) = delete;
+    explicit operator bool() const noexcept { return ex_ != nullptr; }
+    [[nodiscard]] Executor& operator*() const noexcept { return *ex_; }
+    [[nodiscard]] Executor* operator->() const noexcept { return ex_; }
+    [[nodiscard]] bool Busy() const noexcept { return busy_; }
+    [[nodiscard]] const std::string& Error() const noexcept { return err_; }
+    /** Reports a failure the device is to blame for (device removed, timeout): the backend stays off for the session. */
+    void Fail(const std::string& why);
+
+  private:
+    Executor* ex_ = nullptr;
+    Backend* backend_ = nullptr;
+    bool busy_ = false;
+    std::string err_;
+  };
+
+  // ---- helpers on top of an Executor ---------------------------------------------------------------------------------------------------------
+
+  /** w * h floats on the device. */
+  struct Field
+  {
+    std::unique_ptr<Resource> buf;
+    int w = 0;
+    int h = 0;
+    [[nodiscard]] explicit operator bool() const { return buf != nullptr; }
+    [[nodiscard]] const Resource& R() const { return *buf; }
+    [[nodiscard]] Resource& R() { return *buf; }
+  };
+
+  [[nodiscard]] bool MakeField(Executor& ex, int w, int h, Field& out, std::string& err);
+  /** Uploads w * h floats. */
+  [[nodiscard]] bool UploadField(Executor& ex, Field& f, const float* data, std::string& err);
+  [[nodiscard]] bool DownloadField(Executor& ex, Field& f, float* data, std::string& err);
+  /** MakeField + UploadField of a grid. */
+  [[nodiscard]] bool UploadGrid(Executor& ex, const field::Grid& g, Field& out, std::string& err);
+  /** Downloads into `g`, which must have the field's size. */
+  [[nodiscard]] bool DownloadGrid(Executor& ex, Field& f, field::Grid& g, std::string& err);
+  /** A buffer of floats / uints (weights, counters): count elements of 4 bytes. */
+  [[nodiscard]] bool MakeBuffer(Executor& ex, u32 count, std::unique_ptr<Resource>& out, std::string& err);
+  [[nodiscard]] bool UploadBuffer(Executor& ex, Resource& r, const void* data, std::size_t bytes, std::string& err);
+  /** Sets every 4 byte word of a buffer to `pattern` (0 = zero floats / zero counters; uploads a host array: for set-up between iterations, not for use inside a loop). */
+  [[nodiscard]] bool FillBuffer(Executor& ex, Resource& r, u32 pattern, std::string& err);
+  /** An R32_FLOAT texture holding a field (copied on the device with the buf_to_tex kernel). */
+  [[nodiscard]] bool MakeTextureFromField(Executor& ex, const Field& f, std::unique_ptr<Resource>& tex, std::string& err);
+
+  /** Two fields of one size; kernels read Src() and write Dst(), Flip() swaps them. */
+  struct PingPong
+  {
+    Field f[2];
+    int cur = 0;   // f[cur] is the source
+    [[nodiscard]] bool Make(Executor& ex, int w, int h, std::string& err) { return MakeField(ex, w, h, f[0], err) && MakeField(ex, w, h, f[1], err); }
+    [[nodiscard]] Field& Src() { return f[cur]; }
+    [[nodiscard]] Field& Dst() { return f[1 - cur]; }
+    void Flip() { cur = 1 - cur; }
+  };
+
+  /** Groups needed to cover w x h (x, y) threads with kernel k; false when that is more than the hardware's group count. */
+  [[nodiscard]] bool GroupsFor(const KernelInfo& k, u32 w, u32 h, Groups& g, std::string& err);
+
+  /** Dispatches kernel k over a w x h grid with the constant buffer `params` (a struct of 4 byte members, size a multiple of 16). */
+  template <class T>
+  [[nodiscard]] bool DispatchGrid(Executor& ex, const KernelInfo& k, u32 w, u32 h, const T& params, const Bindings& b, std::string& err)
+  {
+    static_assert(sizeof(T) % 16 == 0, "constant buffer structs are padded to 16 bytes");
+    static_assert(std::is_trivially_copyable_v<T>, "constant buffer structs are plain data");
+    Groups g;
+    return GroupsFor(k, w, h, g, err) && ex.Dispatch(k, g, &params, static_cast<u32>(sizeof(T)), b, err);
+  }
+
+  /** A dispatch of a kernel without a constant buffer. */
+  [[nodiscard]] bool DispatchGridNoCb(Executor& ex, const KernelInfo& k, u32 w, u32 h, const Bindings& b, std::string& err);
+
+  struct IterStats
+  {
+    u32 iterations = 0;
+    u32 submits = 0;
+    double totalMs = 0.0;
+    double maxSubmitMs = 0.0;
+    u32 largestBatch = 0;
+  };
+
+  /**
+   * Runs step(0) ... step(count - 1) (each one a short sequence of dispatches) in submissions that take about `targetMs` each (0 = 60): after every batch the work is submitted and
+   * waited for (Sync), the time it took sets the size of the next batch. This keeps one submission far below the 2 second limit after which Windows resets the driver (TDR). The
+   * first batch is one iteration. If one iteration alone is slower than the target it still runs as one batch (it cannot be split); `stats->maxSubmitMs` shows it.
+   * false when a step or a Sync fails (`err` set); the iterations done are in stats.
+   */
+  [[nodiscard]] bool RunIterations(Executor& ex, u32 count, double targetMs, const std::function<bool(u32 iteration, std::string& err)>& step, std::string& err, IterStats* stats = nullptr);
+
+  /** Next batch size from the batch just measured (exposed for the test): `ms` for `batch` iterations, target `targetMs`, `remaining` iterations left. */
+  [[nodiscard]] u32 NextBatch(u32 batch, double ms, double targetMs, u32 remaining);
+
+} // namespace moho::editor::gpu
diff --git a/src/sdk/moho/editor/EdGpuLua.cpp b/src/sdk/moho/editor/EdGpuLua.cpp
new file mode 100644
index 0000000..5bd4c59
--- /dev/null
+++ b/src/sdk/moho/editor/EdGpuLua.cpp
@@ -0,0 +1,287 @@
+// EDITOR GPU compute: console variables and Lua natives (docs/projects/editor/GPU_COMPUTE.md). The backend itself is EdGpu.cpp, the op registry and the self test EdGpuOps.cpp.
+//
+// Console variables:
+//   ed_gpu_compute      1        field ops that have a GPU version (blur, box ...) run on the GPU when a Direct3D 11 compute device is available; 0 = always the CPU
+//   ed_gpu_selftest_first 1      the self test runs once before the first real GPU op of a session; a device that fails it is switched off for the session
+//   ed_gpu_min_cells    65536    fields smaller than this stay on the CPU (upload and download cost more than the op)
+// Lua natives (all run on the UI thread):
+//   ed_gpu_info([probe])        -> { compiledIn, tried, available, enabled, active, failed, selfTestPassed, adapter, vramMB, maxMB, featureLevel, compiler, textures, lastError, lastOpError, minCells, ops = { names } }
+//                                  probe (default true) tries to create the device when that has not been tried yet (a few hundred ms once); the perf report passes false
+//   ed_gpu_enable(on[, reset])  -> enabled     the same switch as ed_gpu_compute; reset = true forgets a failure and lets the next op create a new device
+//   ed_gpu_selftest()           -> { ok, texturesOk, ms, error, parts = { { name, ok, detail, ms }, ... } }     scale + offset, group shared memory reduction, blur against the CPU op, texture sampling
+//   ed_gpu_stats([reset])       -> { enabled, ops = { name = { cpu, cpuMs, gpu, gpuMs, fallbacks } }, cpu, cpuMs, gpu, gpuMs, fallbacks }     per-op counters since start (or the last reset)
+//
+// Threads: the natives run on the UI thread. The D3D9 adapter lookup is done only there. Log lines of the backend can come from any thread that runs an op: they are queued and
+// written by the UI thread (the engine log is not known to be thread safe).
+#include "moho/editor/EdGpu.h"
+#include "moho/editor/EdGpuOps.h"
+
+#include <Windows.h>
+#include <d3d9.h>
+
+#include <deque>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "gpg/core/utils/Logging.h"
+#include "gpg/gal/backends/d3d9/DeviceD3D9.hpp"
+#include "lua/LuaPrimitives.h"
+#include "lua/LuaRuntimeTypes.h"
+#include "moho/console/CConCommand.h"
+#include "moho/lua/CScrLuaBinder.h"
+#include "moho/lua/CScrLuaInitForm.h"
+#include "moho/render/d3d/CD3DDevice.h"
+
+namespace moho::editor::gpu
+{
+  namespace
+  {
+    const DWORD gMainThread = GetCurrentThreadId();   // static initialisation runs on the main thread
+
+    TConVar<bool> gConCompute("ed_gpu_compute", "Editor: 1 = field ops with a GPU version (blur, box ...) run on a Direct3D 11 compute device when one is available, 0 = always on the CPU (default 1)", &GetPolicy().enabled);
+    TConVar<bool> gConSelfTestFirst("ed_gpu_selftest_first", "Editor: 1 = the GPU self test runs once before the first real GPU op of a session, and a device that fails it is switched off (default 1)", &GetPolicy().selfTestFirst);
+    TConVar<float> gConMinCells("ed_gpu_min_cells", "Editor: fields with fewer samples than this stay on the CPU even when the GPU is on (default 65536 = 256 x 256)", &GetPolicy().minCells);
+
+    // ---- log -----------------------------------------------------------------------------------------------------------------------------------
+
+    std::mutex gLogMutex;
+    std::deque<std::string> gLogLines;
+
+    void QueueLog(const char* const line)
+    {
+      const std::lock_guard<std::mutex> lock(gLogMutex);
+      if (gLogLines.size() < 200) {
+        gLogLines.emplace_back(line != nullptr ? line : "");
+      }
+    }
+
+    /** Writes the queued lines to the engine log; only on the main thread. */
+    void DrainLog()
+    {
+      if (GetCurrentThreadId() != gMainThread) {
+        return;
+      }
+      std::deque<std::string> lines;
+      {
+        const std::lock_guard<std::mutex> lock(gLogMutex);
+        lines.swap(gLogLines);
+      }
+      for (const std::string& l : lines) {
+        gpg::Logf("EDITOR %s", l.c_str());
+      }
+    }
+
+    // ---- the adapter of the game's Direct3D 9 device ----------------------------------------------------------------------------------------------
+
+    bool FindD3D9Adapter(UINT& vendorId, UINT& deviceId)
+    {
+      CD3DDevice* const device = D3D_GetDevice();
+      if (device == nullptr || device->GetGalDevice() == nullptr) {
+        return false;
+      }
+      IDirect3DDevice9* const dev = static_cast<gpg::gal::DeviceD3D9*>(device->GetGalDevice())->mDevice;
+      if (dev == nullptr) {
+        return false;
+      }
+      D3DDEVICE_CREATION_PARAMETERS cp = {};
+      if (FAILED(dev->GetCreationParameters(&cp))) {
+        return false;
+      }
+      IDirect3D9* d3d = nullptr;
+      if (FAILED(dev->GetDirect3D(&d3d)) || d3d == nullptr) {
+        return false;
+      }
+      D3DADAPTER_IDENTIFIER9 id = {};
+      const HRESULT hr = d3d->GetAdapterIdentifier(cp.AdapterOrdinal, 0, &id);
+      d3d->Release();
+      if (FAILED(hr)) {
+        return false;
+      }
+      vendorId = id.VendorId;
+      deviceId = id.DeviceId;
+      return true;
+    }
+
+    /** TryRun's hook and the natives' entry: true once the preferred adapter is known (or cannot be found any more). */
+    bool BeforeUse()
+    {
+      DrainLog();
+      if (GetCurrentThreadId() != gMainThread) {
+        return false;   // another thread: not allowed to touch the D3D9 device; the next call on the main thread does it
+      }
+      static int attempts = 0;       // main thread only
+      static bool known = false;
+      if (known || attempts >= 20) {
+        return true;
+      }
+      ++attempts;
+      UINT vendor = 0;
+      UINT device = 0;
+      if (FindD3D9Adapter(vendor, device)) {
+        SetPreferredAdapter(vendor, device);
+        known = true;
+      }
+      return true;
+    }
+
+    // ---- Lua helpers ----------------------------------------------------------------------------------------------------------------------------
+
+    void SetNumber(lua_State* const L, const char* const key, const double value)
+    {
+      lua_pushstring(L, key);
+      lua_pushnumber(L, value);
+      lua_settable(L, -3);
+    }
+
+    void SetString(lua_State* const L, const char* const key, const std::string& value)
+    {
+      lua_pushstring(L, key);
+      lua_pushstring(L, value.c_str());
+      lua_settable(L, -3);
+    }
+
+    void SetBool(lua_State* const L, const char* const key, const bool value)
+    {
+      lua_pushstring(L, key);
+      lua_pushboolean(L, value ? 1 : 0);
+      lua_settable(L, -3);
+    }
+
+    // ed_gpu_info([probe])
+    int __cdecl cfunc_GpuInfo(lua_State* const L)
+    {
+      const bool probe = lua_gettop(L) < 1 || lua_toboolean(L, 1) != 0;
+      BeforeUse();
+      const BackendInfo info = CurrentBackend().Info(probe);
+      const Policy& policy = GetPolicy();
+      DrainLog();
+      lua_newtable(L);
+      SetBool(L, "compiledIn", info.compiledIn);
+      SetBool(L, "tried", info.tried);
+      SetBool(L, "available", info.available);
+      SetBool(L, "enabled", policy.enabled);
+      SetBool(L, "active", policy.enabled && info.available);
+      SetBool(L, "failed", info.failed);
+      SetBool(L, "selfTestPassed", SelfTestPassed());
+      SetString(L, "adapter", info.adapter);
+      SetNumber(L, "vramMB", static_cast<double>(info.vramMB));
+      SetNumber(L, "maxMB", static_cast<double>(info.maxBytes >> 20));
+      SetString(L, "featureLevel", info.featureLevel);
+      SetString(L, "compiler", info.compiler);
+      SetBool(L, "textures", info.textures);
+      SetString(L, "lastError", info.lastError);
+      SetString(L, "lastOpError", LastOpError());
+      SetNumber(L, "minCells", policy.minCells);
+      lua_pushstring(L, "ops");
+      lua_newtable(L);
+      int i = 1;
+      for (const std::string& n : GpuOpNames()) {
+        lua_pushnumber(L, i++);
+        lua_pushstring(L, n.c_str());
+        lua_settable(L, -3);
+      }
+      lua_settable(L, -3);
+      return 1;
+    }
+
+    // ed_gpu_enable(on[, reset]) -> enabled
+    int __cdecl cfunc_GpuEnable(lua_State* const L)
+    {
+      GetPolicy().enabled = lua_toboolean(L, 1) != 0;
+      if (lua_toboolean(L, 2) != 0) {
+        CurrentBackend().Reset();
+        ResetSelfTestState();
+      }
+      lua_pushboolean(L, GetPolicy().enabled ? 1 : 0);
+      return 1;
+    }
+
+    // ed_gpu_selftest()
+    int __cdecl cfunc_GpuSelfTest(lua_State* const L)
+    {
+      BeforeUse();
+      const SelfTestReport rep = RunSelfTest();
+      DrainLog();
+      lua_newtable(L);
+      SetBool(L, "ok", rep.ok);
+      SetBool(L, "texturesOk", rep.texturesOk);
+      SetNumber(L, "ms", rep.ms);
+      SetString(L, "error", rep.error);
+      lua_pushstring(L, "parts");
+      lua_newtable(L);
+      int i = 1;
+      for (const SelfTestPart& p : rep.parts) {
+        lua_pushnumber(L, i++);
+        lua_newtable(L);
+        SetString(L, "name", p.name);
+        SetBool(L, "ok", p.ok);
+        SetString(L, "detail", p.detail);
+        SetNumber(L, "ms", p.ms);
+        lua_settable(L, -3);
+      }
+      lua_settable(L, -3);
+      return 1;
+    }
+
+    // ed_gpu_stats([reset])
+    int __cdecl cfunc_GpuStats(lua_State* const L)
+    {
+      const std::map<std::string, field::OpStat> stats = field::OpStats(lua_toboolean(L, 1) != 0);
+      double cpu = 0, cpuMs = 0, gpu = 0, gpuMs = 0, fallbacks = 0;
+      lua_newtable(L);
+      SetBool(L, "enabled", GetPolicy().enabled);
+      lua_pushstring(L, "ops");
+      lua_newtable(L);
+      for (const auto& kv : stats) {
+        lua_pushstring(L, kv.first.c_str());
+        lua_newtable(L);
+        SetNumber(L, "cpu", static_cast<double>(kv.second.cpuCalls));
+        SetNumber(L, "cpuMs", kv.second.cpuMs);
+        SetNumber(L, "gpu", static_cast<double>(kv.second.gpuCalls));
+        SetNumber(L, "gpuMs", kv.second.gpuMs);
+        SetNumber(L, "fallbacks", static_cast<double>(kv.second.fallbacks));
+        lua_settable(L, -3);
+        cpu += static_cast<double>(kv.second.cpuCalls);
+        cpuMs += kv.second.cpuMs;
+        gpu += static_cast<double>(kv.second.gpuCalls);
+        gpuMs += kv.second.gpuMs;
+        fallbacks += static_cast<double>(kv.second.fallbacks);
+      }
+      lua_settable(L, -3);
+      SetNumber(L, "cpu", cpu);
+      SetNumber(L, "cpuMs", cpuMs);
+      SetNumber(L, "gpu", gpu);
+      SetNumber(L, "gpuMs", gpuMs);
+      SetNumber(L, "fallbacks", fallbacks);
+      return 1;
+    }
+
+    [[nodiscard]] CScrLuaInitFormSet& UserLuaInitSet()
+    {
+      if (CScrLuaInitFormSet* const set = SCR_FindLuaInitFormSet("User"); set != nullptr) {
+        return *set;
+      }
+      static CScrLuaInitFormSet fallbackSet("User");
+      return fallbackSet;
+    }
+
+    struct EdGpuLuaBootstrap
+    {
+      EdGpuLuaBootstrap()
+      {
+        SetLogSink(&QueueLog);
+        SetBeforeUseHook(&BeforeUse);
+        Install();   // the field engine's interceptor
+        auto& set = UserLuaInitSet();
+        (void)new CScrLuaBinder(set, "ed_gpu_info", &cfunc_GpuInfo, nullptr, "<global>",
+                                "ed_gpu_info([probe]) -> { available, enabled, active, adapter, vramMB, featureLevel, textures, lastError, lastOpError, ops, ... } (see EdGpuLua.cpp)");
+        (void)new CScrLuaBinder(set, "ed_gpu_enable", &cfunc_GpuEnable, nullptr, "<global>", "ed_gpu_enable(on[, reset]) -> enabled; reset = true forgets a failure so the next op creates a new device");
+        (void)new CScrLuaBinder(set, "ed_gpu_selftest", &cfunc_GpuSelfTest, nullptr, "<global>", "ed_gpu_selftest() -> { ok, texturesOk, ms, error, parts = { { name, ok, detail, ms } } }");
+        (void)new CScrLuaBinder(set, "ed_gpu_stats", &cfunc_GpuStats, nullptr, "<global>", "ed_gpu_stats([reset]) -> { enabled, ops = { name = { cpu, cpuMs, gpu, gpuMs, fallbacks } }, cpu, cpuMs, gpu, gpuMs, fallbacks }");
+      }
+    };
+
+    const EdGpuLuaBootstrap gEdGpuLuaBootstrap{};
+  } // namespace
+} // namespace moho::editor::gpu
diff --git a/src/sdk/moho/editor/EdGpuOps.cpp b/src/sdk/moho/editor/EdGpuOps.cpp
new file mode 100644
index 0000000..2e39706
--- /dev/null
+++ b/src/sdk/moho/editor/EdGpuOps.cpp
@@ -0,0 +1,522 @@
+// EDITOR GPU compute: GPU implementations of field ops, the policy and the self test. See EdGpuOps.h and docs/projects/editor/GPU_COMPUTE.md.
+//
+// THE TEMPLATE FOR A NEW GPU OP is OpBlurGpu below (and gpu/blur_pass.hlsl, gpu/blur_params.hlsli): read the inputs, refuse what the GPU version does not handle with
+// Unsupported, upload, dispatch kernels, download into a LOCAL grid, and only then move it into `out`.
+#pragma fp_contract(off)
+
+#include "moho/editor/EdGpuOps.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <exception>
+#include <memory>
+#include <string>
+#include <vector>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <mutex>
+
+// constant buffer structs of the kernels: the very files the kernels include (so the layouts cannot differ); inside a namespace that has the HLSL scalar type names
+namespace moho::editor::gpu::hk
+{
+  using uint = std::uint32_t;
+#include "moho/editor/gpu/blur_params.hlsli"
+#include "moho/editor/gpu/field_params.hlsli"
+#include "moho/editor/gpu/reduce_params.hlsli"
+#include "moho/editor/gpu/scale_params.hlsli"
+} // namespace moho::editor::gpu::hk
+
+namespace moho::editor::gpu
+{
+  using field::Grid;
+  using field::GridPtr;
+  using field::OpArgs;
+
+  // ---- registry, policy, statistics ------------------------------------------------------------------------------------------------------------
+
+  namespace
+  {
+    std::mutex gRegistryMutex;
+    std::map<std::string, GpuOpFn>& Ops()
+    {
+      static std::map<std::string, GpuOpFn> ops;
+      return ops;
+    }
+    std::atomic<bool> gSelfTestPassed{false};
+    std::atomic<BeforeUseFn> gHook{nullptr};
+    std::atomic<bool> gHookDone{false};
+    std::mutex gErrorMutex;
+    std::string gLastError;
+
+    double MsSince(const std::chrono::steady_clock::time_point t0)
+    {
+      return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+    }
+  } // namespace
+
+  Policy& GetPolicy()
+  {
+    static Policy policy;
+    return policy;
+  }
+
+  void RegisterGpuOp(const char* const name, const GpuOpFn fn)
+  {
+    const std::lock_guard<std::mutex> lock(gRegistryMutex);
+    Ops()[name] = fn;
+  }
+
+  std::vector<std::string> GpuOpNames()
+  {
+    const std::lock_guard<std::mutex> lock(gRegistryMutex);
+    std::vector<std::string> names;
+    for (const auto& kv : Ops()) {
+      names.push_back(kv.first);
+    }
+    return names;
+  }
+
+  bool SelfTestPassed() { return gSelfTestPassed.load(); }
+  void ResetSelfTestState() { gSelfTestPassed.store(false); }
+
+  void SetBeforeUseHook(const BeforeUseFn fn)
+  {
+    gHook.store(fn);
+    gHookDone.store(false);
+  }
+
+  std::string LastOpError()
+  {
+    const std::lock_guard<std::mutex> lock(gErrorMutex);
+    return gLastError;
+  }
+
+  void SetLastOpError(const std::string& text)
+  {
+    const std::lock_guard<std::mutex> lock(gErrorMutex);
+    gLastError = text;
+  }
+
+  double CellsOf(const OpArgs& args)
+  {
+    const auto pick = [&](const char* key) -> const Grid* {
+      const auto it = args.in.find(key);
+      return it != args.in.end() ? it->second.get() : nullptr;
+    };
+    if (const Grid* g = pick("a"); g != nullptr) {
+      return static_cast<double>(g->w) * static_cast<double>(g->h);
+    }
+    if (const Grid* g = pick("like"); g != nullptr) {
+      return static_cast<double>(g->w) * static_cast<double>(g->h);
+    }
+    return args.p.N("width", 0.0) * args.p.N("height", 0.0);
+  }
+
+  bool TryRun(const std::string& name, const OpArgs& args, Grid& out)
+  {
+    try {
+      GpuOpFn fn = nullptr;
+      {
+        const std::lock_guard<std::mutex> lock(gRegistryMutex);
+        const auto it = Ops().find(name);
+        if (it == Ops().end()) {
+          return false;
+        }
+        fn = it->second;
+      }
+      const Policy& policy = GetPolicy();
+      if (!policy.enabled || CellsOf(args) < static_cast<double>(policy.minCells)) {
+        return false;
+      }
+      Backend& backend = CurrentBackend();
+      if (!backend.MayWork()) {
+        return false;
+      }
+      if (!gHookDone.load()) {
+        const BeforeUseFn hook = gHook.load();
+        if (hook == nullptr || hook()) {
+          gHookDone.store(true);
+        }
+      }
+      Lease lease(false);
+      if (!lease) {
+        if (!lease.Busy() && !lease.Error().empty()) {
+          SetLastOpError(name + ": " + lease.Error());
+        }
+        return false;
+      }
+      if (policy.selfTestFirst && !gSelfTestPassed.load()) {
+        // the first real use on this device: prove that the kernels compile and give the CPU's results; a device that does not is switched off for the session
+        const SelfTestReport rep = RunSelfTest(*lease);
+        if (!rep.ok) {
+          std::string why = "GPU self test failed: " + (rep.error.empty() ? std::string("a kernel gave different results than the CPU") : rep.error);
+          for (const SelfTestPart& p : rep.parts) {
+            if (!p.ok) {
+              why += "; " + p.name + ": " + p.detail;
+              break;
+            }
+          }
+          SetLastOpError(name + ": " + why);
+          lease.Fail(why);
+          return false;
+        }
+        gSelfTestPassed.store(true);
+      }
+      const auto t0 = std::chrono::steady_clock::now();
+      Grid result;
+      std::string err;
+      OpResult r = OpResult::Failed;
+      try {
+        r = fn(*lease, args, result, err);
+      } catch (const std::exception& e) {
+        r = OpResult::Failed;
+        err = std::string("exception: ") + e.what();
+      } catch (...) {
+        r = OpResult::Failed;
+        err = "exception";
+      }
+      if (r == OpResult::Done) {
+        out = std::move(result);
+        field::NoteOpGpu(name, MsSince(t0));
+        return true;
+      }
+      if (r == OpResult::Failed) {
+        field::NoteOpFallback(name);
+        SetLastOpError(name + ": " + err);
+        if (lease->DeviceLost()) {
+          lease.Fail(err);
+        }
+      }
+      return false;
+    } catch (...) {
+      return false;
+    }
+  }
+
+  void Install()
+  {
+    field::SetOpInterceptor(&TryRun);
+  }
+
+  // ---- the template op: blur / box ---------------------------------------------------------------------------------------------------------------
+
+  namespace
+  {
+    /** One-sided kernel k[0..r] of a symmetric normalised kernel: a private copy of MakeKernel in EdFieldCore.cpp (same arithmetic, so the weights are the same bits). */
+    std::vector<float> MakeKernel(const bool gauss, const double sigmaOrRadius, int& r)
+    {
+      std::vector<float> k;
+      if (gauss) {
+        r = std::max(1, static_cast<int>(std::ceil(3.0 * sigmaOrRadius)));
+        std::vector<double> d(static_cast<std::size_t>(r) + 1);
+        double sum = 0.0;
+        for (int i = 0; i <= r; ++i) {
+          d[static_cast<std::size_t>(i)] = std::exp(-0.5 * static_cast<double>(i) * static_cast<double>(i) / (sigmaOrRadius * sigmaOrRadius));
+          sum += (i == 0 ? 1.0 : 2.0) * d[static_cast<std::size_t>(i)];
+        }
+        for (const double v : d) {
+          k.push_back(static_cast<float>(v / sum));
+        }
+      } else {
+        r = std::max(1, static_cast<int>(std::floor(sigmaOrRadius + 0.5)));
+        k.assign(static_cast<std::size_t>(r) + 1, static_cast<float>(1.0 / (2.0 * r + 1.0)));
+      }
+      return k;
+    }
+
+    const Grid* InputOf(const OpArgs& a, const char* const key)
+    {
+      const auto it = a.in.find(key);
+      return it != a.in.end() ? it->second.get() : nullptr;
+    }
+
+    OpResult OpBlurGpu(Executor& ex, const OpArgs& a, const bool gauss, Grid& out, std::string& err)
+    {
+      // 1. what the GPU version does not handle goes back to the CPU op (which also reports bad inputs with its own messages)
+      const Grid* src = InputOf(a, "a");
+      if (src == nullptr || src->w < 1 || src->h < 1) {
+        return OpResult::Unsupported;
+      }
+      if (const Grid* like = InputOf(a, "like"); like != nullptr && !like->SameShape(*src)) {
+        return OpResult::Unsupported;
+      }
+      if (InputOf(a, "mask") != nullptr) {
+        return OpResult::Unsupported;   // the masked blend is not ported; the CPU op does it
+      }
+      const double radius = a.p.N("radius", 4.0) / static_cast<double>(src->cell);   // world units -> samples, as on the CPU
+      if (radius <= 1e-6) {
+        return OpResult::Unsupported;
+      }
+      int r = 0;
+      const std::vector<float> weights = MakeKernel(gauss, radius, r);
+      const double work = 2.0 * static_cast<double>(src->w) * static_cast<double>(src->h) * (2.0 * r + 1.0);
+      if (r > 8192 || work > 3.0e10) {
+        return OpResult::Unsupported;   // one dispatch this long could hit the 2 second driver reset: the CPU does it
+      }
+      const std::uint64_t bytes = 2ull * src->Count() * 4ull + weights.size() * 4ull;
+      if (bytes > ex.MaxBytes()) {
+        return OpResult::Unsupported;
+      }
+      const KernelInfo* kernel = FindKernel("blur_pass");
+      if (kernel == nullptr) {
+        err = "kernel blur_pass is missing";
+        return OpResult::Failed;
+      }
+
+      // 2. upload, two passes (x then z) over a ping-pong pair, download into a local grid
+      PingPong pp;
+      std::unique_ptr<Resource> kbuf;
+      if (!UploadGrid(ex, *src, pp.f[0], err) || !MakeField(ex, src->w, src->h, pp.f[1], err) ||
+          !MakeBuffer(ex, static_cast<u32>(weights.size()), kbuf, err) || !UploadBuffer(ex, *kbuf, weights.data(), weights.size() * 4, err)) {
+        return OpResult::Failed;
+      }
+      hk::BlurParams params{};
+      params.w = static_cast<std::uint32_t>(src->w);
+      params.h = static_cast<std::uint32_t>(src->h);
+      params.radius = static_cast<std::uint32_t>(r);
+      for (std::uint32_t pass = 0; pass < 2; ++pass) {
+        params.vertical = pass;
+        Bindings b;
+        b.Srv(0, pp.Src().R()).Srv(1, *kbuf).Uav(0, pp.Dst().R());
+        if (!DispatchGrid(ex, *kernel, params.w, params.h, params, b, err)) {
+          return OpResult::Failed;
+        }
+        pp.Flip();
+      }
+      Grid result(src->w, src->h, src->cell, src->ox, src->oz);
+      if (!DownloadGrid(ex, pp.Src(), result, err)) {
+        return OpResult::Failed;
+      }
+      out = std::move(result);
+      return OpResult::Done;
+    }
+
+    OpResult OpBlurGaussGpu(Executor& ex, const OpArgs& a, Grid& out, std::string& err) { return OpBlurGpu(ex, a, true, out, err); }
+    OpResult OpBlurBoxGpu(Executor& ex, const OpArgs& a, Grid& out, std::string& err) { return OpBlurGpu(ex, a, false, out, err); }
+
+    struct BuiltinOps
+    {
+      BuiltinOps()
+      {
+        RegisterGpuOp("blur", &OpBlurGaussGpu);
+        RegisterGpuOp("box", &OpBlurBoxGpu);
+      }
+    };
+    const BuiltinOps gBuiltinOps;
+  } // namespace
+
+  // ---- self test ---------------------------------------------------------------------------------------------------------------------------------
+
+  namespace
+  {
+    std::string Fmt(const char* const f, const double a, const double b = 0.0, const double c = 0.0)
+    {
+      char buf[160];
+      std::snprintf(buf, sizeof(buf), f, a, b, c);
+      return buf;
+    }
+
+    SelfTestPart PartScaleOffset(Executor& ex)
+    {
+      SelfTestPart part;
+      part.name = "scale + offset (64 x 64)";
+      const auto t0 = std::chrono::steady_clock::now();
+      std::string err;
+      do {
+        const KernelInfo* k = FindKernel("scale_offset");
+        if (k == nullptr) { err = "kernel scale_offset is missing"; break; }
+        const std::uint32_t n = 64 * 64;
+        std::vector<float> in(n), res(n);
+        for (std::uint32_t i = 0; i < n; ++i) in[i] = static_cast<float>(i % 97) * 0.25f - 3.0f;
+        std::unique_ptr<Resource> a, b;
+        if (!MakeBuffer(ex, n, a, err) || !MakeBuffer(ex, n, b, err) || !UploadBuffer(ex, *a, in.data(), n * 4, err)) break;
+        hk::ScaleParams p{};
+        p.count = n;
+        p.scale = 1.5f;
+        p.offset = -0.75f;
+        Bindings bind;
+        bind.Srv(0, *a).Uav(0, *b);
+        if (!DispatchGrid(ex, *k, n, 1, p, bind, err)) break;
+        if (!ex.Download(*b, res.data(), n * 4, err)) break;
+        double worst = 0.0;
+        for (std::uint32_t i = 0; i < n; ++i) worst = std::max(worst, static_cast<double>(std::fabs(res[i] - (in[i] * 1.5f - 0.75f))));
+        part.ok = worst <= 1e-5;
+        part.detail = Fmt("largest difference %g", worst);
+      } while (false);
+      if (!err.empty()) part.detail = err;
+      part.ms = MsSince(t0);
+      return part;
+    }
+
+    SelfTestPart PartReduce(Executor& ex)
+    {
+      SelfTestPart part;
+      part.name = "group shared memory reduction (10000 values)";
+      const auto t0 = std::chrono::steady_clock::now();
+      std::string err;
+      do {
+        const KernelInfo* k = FindKernel("reduce_sum");
+        if (k == nullptr) { err = "kernel reduce_sum is missing"; break; }
+        const std::uint32_t n = 10000;
+        const std::uint32_t groups = (n + 255) / 256;
+        std::vector<float> in(n), res(groups);
+        for (std::uint32_t i = 0; i < n; ++i) in[i] = static_cast<float>(i % 7);   // small integers: exact sums in any order
+        std::unique_ptr<Resource> a, b;
+        if (!MakeBuffer(ex, n, a, err) || !MakeBuffer(ex, groups, b, err) || !UploadBuffer(ex, *a, in.data(), n * 4, err)) break;
+        hk::ReduceParams p{};
+        p.count = n;
+        Bindings bind;
+        bind.Srv(0, *a).Uav(0, *b);
+        Groups g;
+        g.x = groups;
+        if (!ex.Dispatch(*k, g, &p, static_cast<u32>(sizeof(p)), bind, err)) break;
+        if (!ex.Download(*b, res.data(), groups * 4, err)) break;
+        std::uint32_t wrong = 0;
+        for (std::uint32_t gi = 0; gi < groups; ++gi) {
+          float expect = 0.0f;
+          for (std::uint32_t i = gi * 256; i < std::min(n, gi * 256 + 256); ++i) expect += in[i];
+          if (res[gi] != expect) ++wrong;
+        }
+        part.ok = wrong == 0;
+        part.detail = wrong == 0 ? std::string("all sums equal") : Fmt("%g of %g sums differ", wrong, groups);
+      } while (false);
+      if (!err.empty()) part.detail = err;
+      part.ms = MsSince(t0);
+      return part;
+    }
+
+    SelfTestPart PartBlur(Executor& ex)
+    {
+      SelfTestPart part;
+      part.name = "gaussian blur (96 x 80) against the CPU op";
+      const auto t0 = std::chrono::steady_clock::now();
+      std::string err;
+      do {
+        auto in = std::make_shared<Grid>(96, 80, 2.0f, 10.0f, -4.0f);
+        for (std::size_t i = 0; i < in->v.size(); ++i) {
+          std::uint32_t h = static_cast<std::uint32_t>(i) * 2654435761u;
+          h ^= h >> 15;
+          h *= 2246822519u;
+          h ^= h >> 13;
+          in->v[i] = static_cast<float>(h >> 8) * (1.0f / 16777216.0f) * 100.0f;
+        }
+        OpArgs args;
+        args.in["a"] = in;
+        args.p.num["radius"] = 6.0;
+        Grid gpuOut, cpuOut;
+        if (OpBlurGpu(ex, args, true, gpuOut, err) != OpResult::Done) {
+          if (err.empty()) err = "the GPU op refused the self test input";
+          break;
+        }
+        std::string cpuErr;
+        if (!field::RunOpCpu("blur", args, cpuOut, cpuErr)) { err = "CPU op failed: " + cpuErr; break; }
+        double worst = 0.0;
+        for (std::size_t i = 0; i < cpuOut.v.size(); ++i) worst = std::max(worst, static_cast<double>(std::fabs(gpuOut.v[i] - cpuOut.v[i])));
+        part.ok = gpuOut.SameShape(cpuOut) && worst <= 1e-3;   // values are up to 100: a few float32 steps
+        part.detail = Fmt("largest difference %g (values up to 100)", worst);
+      } while (false);
+      if (!err.empty()) part.detail = err;
+      part.ms = MsSince(t0);
+      return part;
+    }
+
+    SelfTestPart PartTexture(Executor& ex)
+    {
+      SelfTestPart part;
+      part.name = "texture sampling (32 x 24 to 64 x 48)";
+      const auto t0 = std::chrono::steady_clock::now();
+      std::string err;
+      do {
+        if (!ex.SupportsTextures()) { err = "textures are not supported by this device"; break; }
+        const KernelInfo* k = FindKernel("tex_resample");
+        if (k == nullptr) { err = "kernel tex_resample is missing"; break; }
+        const int sw = 32, sh = 24, dw = 64, dh = 48;
+        std::vector<float> in(static_cast<std::size_t>(sw) * sh);
+        for (int z = 0; z < sh; ++z)
+          for (int x = 0; x < sw; ++x) in[static_cast<std::size_t>(z) * sw + x] = static_cast<float>((x * 7 + z * 13) % 31) / 31.0f;
+        Field f;
+        std::unique_ptr<Resource> tex;
+        if (!MakeField(ex, sw, sh, f, err) || !UploadField(ex, f, in.data(), err) || !MakeTextureFromField(ex, f, tex, err)) break;
+        Field out;
+        if (!MakeField(ex, dw, dh, out, err)) break;
+        hk::FieldParams p{};
+        p.w = dw;
+        p.h = dh;
+        p.srcW = sw;
+        p.srcH = sh;
+        Bindings bind;
+        bind.Srv(0, *tex).Uav(0, out.R());
+        if (!DispatchGrid(ex, *k, dw, dh, p, bind, err)) break;
+        std::vector<float> res(static_cast<std::size_t>(dw) * dh);
+        if (!DownloadField(ex, out, res.data(), err)) break;
+        double worst = 0.0;
+        const auto texel = [&](int x, int z) { return in[static_cast<std::size_t>(std::min(sh - 1, std::max(0, z))) * sw + static_cast<std::size_t>(std::min(sw - 1, std::max(0, x)))]; };
+        for (int z = 0; z < dh; ++z) {
+          for (int x = 0; x < dw; ++x) {
+            const float fx = (static_cast<float>(x) + 0.5f) / static_cast<float>(dw) * static_cast<float>(sw) - 0.5f;
+            const float fz = (static_cast<float>(z) + 0.5f) / static_cast<float>(dh) * static_cast<float>(sh) - 0.5f;
+            const int x0 = static_cast<int>(std::floor(fx));
+            const int z0 = static_cast<int>(std::floor(fz));
+            const float tx = fx - static_cast<float>(x0);
+            const float tz = fz - static_cast<float>(z0);
+            const float top = texel(x0, z0) + (texel(x0 + 1, z0) - texel(x0, z0)) * tx;
+            const float bottom = texel(x0, z0 + 1) + (texel(x0 + 1, z0 + 1) - texel(x0, z0 + 1)) * tx;
+            const float expect = top + (bottom - top) * tz;
+            worst = std::max(worst, static_cast<double>(std::fabs(res[static_cast<std::size_t>(z) * dw + x] - expect)));
+          }
+        }
+        part.ok = worst <= 0.01;   // hardware filtering uses 8 bit weights: up to ~0.004 for values in 0..1
+        part.detail = Fmt("largest difference %g (values 0..1, hardware filtering allows ~0.004)", worst);
+      } while (false);
+      if (!err.empty()) part.detail = err;
+      part.ms = MsSince(t0);
+      return part;
+    }
+  } // namespace
+
+  SelfTestReport RunSelfTest(Executor& ex)
+  {
+    SelfTestReport rep;
+    const auto t0 = std::chrono::steady_clock::now();
+    try {
+      rep.parts.push_back(PartScaleOffset(ex));
+      rep.parts.push_back(PartReduce(ex));
+      rep.parts.push_back(PartBlur(ex));
+      rep.parts.push_back(PartTexture(ex));
+    } catch (const std::exception& e) {
+      rep.error = std::string("exception: ") + e.what();
+    } catch (...) {
+      rep.error = "exception";
+    }
+    std::string syncErr;
+    double dummy = 0.0;
+    if (!ex.Sync(&dummy, syncErr) && rep.error.empty()) {
+      rep.error = syncErr;
+    }
+    rep.ok = rep.error.empty() && rep.parts.size() == 4 && rep.parts[0].ok && rep.parts[1].ok && rep.parts[2].ok;
+    rep.texturesOk = rep.parts.size() == 4 && rep.parts[3].ok;
+    rep.ms = MsSince(t0);
+    return rep;
+  }
+
+  SelfTestReport RunSelfTest()
+  {
+    SelfTestReport rep;
+    Lease lease(true);
+    if (!lease) {
+      rep.error = lease.Error().empty() ? "the GPU backend is not available" : lease.Error();
+      return rep;
+    }
+    rep = RunSelfTest(*lease);
+    if (rep.ok) {
+      gSelfTestPassed.store(true);
+    }
+    if (lease->DeviceLost()) {
+      lease.Fail(rep.error.empty() ? "device lost during the self test" : rep.error);
+    }
+    return rep;
+  }
+} // namespace moho::editor::gpu
