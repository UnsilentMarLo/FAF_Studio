From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marlo <Plays.xenon@yahoo.de>
Date: Sat, 17 Oct 2026 17:10:16 +0200
Subject: [PATCH] Prop-scale compat layer: CWldProps keeps per-prop scale
 (Load/Save), sim applies it like MapPropScale, ed_prop_get/add/scale carry
 it; Save writes the exact inverse of the loader's rotation conversion

Round trip checked against the Python .scmap reader (scripts/ed_prop_roundtrip.py).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/src/sdk/moho/editor/EditorLua.cpp b/src/sdk/moho/editor/EditorLua.cpp
index 75dddc1..cece964 100644
--- a/src/sdk/moho/editor/EditorLua.cpp
+++ b/src/sdk/moho/editor/EditorLua.cpp
@@ -35,8 +35,11 @@
 // Props of the map file (the list the .scmap save writes; the simulation's own prop entities are created by
 // the sim callbacks in editor/runtime/schook/lua/SimCallbacks.lua):
 //   ed_prop_count()                      -> n
-//   ed_prop_get(i)                       -> blueprint, x, y, z, qw, qx, qy, qz        (i = 1..n)
-//   ed_prop_add(blueprint, x, y, z, heading) -> new index   (heading in radians about the up axis)
+//   ed_prop_get(i)                       -> blueprint, x, y, z, qw, qx, qy, qz, sx, sy, sz   (i = 1..n)
+//   ed_prop_add(blueprint, x, y, z, heading [, sx [, sy, sz]]) -> new index
+//                                           (heading in radians about the up axis; one scale value = uniform;
+//                                            the scale is kept in the map file's per-prop scale lanes)
+//   ed_prop_scale(i, sx [, sy, sz])      -> bool   (map data only; the sim entity is rescaled by the caller)
 //   ed_prop_move(i, x, y, z)             -> bool
 //   ed_prop_remove(i)                    -> bool
 //
@@ -524,7 +527,24 @@ namespace
     lua_pushnumber(state, e.mTransform.orient_.x);
     lua_pushnumber(state, e.mTransform.orient_.y);
     lua_pushnumber(state, e.mTransform.orient_.z);
-    return 8;
+    lua_pushnumber(state, e.mScale.x);
+    lua_pushnumber(state, e.mScale.y);
+    lua_pushnumber(state, e.mScale.z);
+    return 11;
+  }
+
+  // Scale arguments starting at `first`: none = (1,1,1), one = uniform, three = per axis.
+  [[nodiscard]] Wm3::Vec3f ScaleArgs(lua_State* const state, const int first)
+  {
+    if (lua_gettop(state) < first) {
+      return Wm3::Vec3f(1.0f, 1.0f, 1.0f);
+    }
+    const float sx = static_cast<float>(luaL_checknumber(state, first));
+    if (lua_gettop(state) < first + 2) {
+      return Wm3::Vec3f(sx, sx, sx);
+    }
+    return Wm3::Vec3f(
+      sx, static_cast<float>(luaL_checknumber(state, first + 1)), static_cast<float>(luaL_checknumber(state, first + 2)));
   }
 
   int __cdecl cfunc_EdPropAdd(lua_State* const state)
@@ -543,6 +563,7 @@ namespace
     entry.mBlueprintPath = msvc8::string(blueprint);
     entry.mTransform.pos_ = Wm3::Vec3f(x, y, z);
     entry.mTransform.orient_ = Wm3::Quatf(std::cos(heading * 0.5f), 0.0f, std::sin(heading * 0.5f), 0.0f);
+    entry.mScale = ScaleArgs(state, 6);
     props->mEntries.push_back(entry);
     lua_pushnumber(state, static_cast<lua_Number>(props->mEntries.size()));
     return 1;
@@ -565,6 +586,19 @@ namespace
     return 1;
   }
 
+  int __cdecl cfunc_EdPropScale(lua_State* const state)
+  {
+    moho::CWldProps* const props = LiveProps();
+    const int index = static_cast<int>(luaL_checknumber(state, 1)) - 1;
+    if (props == nullptr || index < 0 || static_cast<std::size_t>(index) >= props->mEntries.size()) {
+      lua_pushboolean(state, 0);
+      return 1;
+    }
+    props->mEntries[static_cast<std::size_t>(index)].mScale = ScaleArgs(state, 2);
+    lua_pushboolean(state, 1);
+    return 1;
+  }
+
   int __cdecl cfunc_EdPropRemove(lua_State* const state)
   {
     moho::CWldProps* const props = LiveProps();
@@ -790,6 +824,7 @@ namespace
       (void)BindGlobal("ed_prop_add", &cfunc_EdPropAdd, "ed_prop_add(...)");
       (void)BindGlobal("ed_prop_move", &cfunc_EdPropMove, "ed_prop_move(...)");
       (void)BindGlobal("ed_prop_remove", &cfunc_EdPropRemove, "ed_prop_remove(...)");
+      (void)BindGlobal("ed_prop_scale", &cfunc_EdPropScale, "ed_prop_scale(...)");
       (void)BindGlobal("ed_decal_count", &cfunc_EdDecalCount, "ed_decal_count(...)");
       (void)BindGlobal("ed_decal_get", &cfunc_EdDecalGet, "ed_decal_get(...)");
       (void)BindGlobal("ed_decal_add", &cfunc_EdDecalAdd, "ed_decal_add(...)");
diff --git a/src/sdk/moho/sim/CWldMap.cpp b/src/sdk/moho/sim/CWldMap.cpp
index 44467f8..d9d8ee0 100644
--- a/src/sdk/moho/sim/CWldMap.cpp
+++ b/src/sdk/moho/sim/CWldMap.cpp
@@ -386,16 +386,19 @@ namespace
     const float wy2 = 2.0f * w * y;
     const float wz2 = 2.0f * w * z;
 
+    // EDITOR DIVERGENCE: this was the transpose of what QuaternionFromMatrixRows reads, so a map saved by the engine
+    // came back rotated the opposite way round (found by scripts/ed_prop_roundtrip.py). It is now the exact inverse
+    // of the loader, so load -> save keeps the three rotation vectors of every prop.
     matrix[0][0] = 1.0f - yy2 - zz2;
-    matrix[0][1] = wz2 + xy2;
-    matrix[0][2] = xz2 - wy2;
+    matrix[0][1] = xy2 - wz2;
+    matrix[0][2] = xz2 + wy2;
 
-    matrix[1][0] = xy2 - wz2;
+    matrix[1][0] = xy2 + wz2;
     matrix[1][1] = 1.0f - xx2 - zz2;
-    matrix[1][2] = yz2 + wx2;
+    matrix[1][2] = yz2 - wx2;
 
-    matrix[2][0] = wy2 + xz2;
-    matrix[2][1] = yz2 - wx2;
+    matrix[2][0] = xz2 - wy2;
+    matrix[2][1] = yz2 + wx2;
     matrix[2][2] = 1.0f - xx2 - yy2;
   }
 
@@ -989,6 +992,7 @@ namespace
     defaultEntry.mBlueprintPath.tidy(false, 0U);
     defaultEntry.mTransform.orient_ = Wm3::Quatf{1.0f, 0.0f, 0.0f, 0.0f};
     defaultEntry.mTransform.pos_ = Wm3::Vec3f{0.0f, 0.0f, 0.0f};
+    defaultEntry.mScale = Wm3::Vec3f{1.0f, 1.0f, 1.0f};
     return defaultEntry;
   }
 
@@ -1000,10 +1004,16 @@ namespace
    * storage record.
    */
   moho::CWldPropEntry*
-  PackWldPropEntry(moho::CWldPropEntry& outEntry, const moho::VTransform& transform, const msvc8::string& path)
+  PackWldPropEntry(
+    moho::CWldPropEntry& outEntry,
+    const moho::VTransform& transform,
+    const msvc8::string& path,
+    const Wm3::Vec3f& scale = Wm3::Vec3f{1.0f, 1.0f, 1.0f}
+  )
   {
     outEntry.mBlueprintPath.assign_owned(path.c_str());
     outEntry.mTransform = transform;
+    outEntry.mScale = scale;
     return &outEntry;
   }
 
@@ -1196,7 +1206,7 @@ namespace moho
    * What it does:
    * Reads world-prop entries from stream, converts matrix orientation to a
    * normalized quaternion lane, and stores packed 7-float transform data for
-   * each entry.
+   * each entry. Editor build: the per-prop scale lanes are stored as well.
    */
   bool CWldProps::Load(gpg::BinaryReader& reader, CBackgroundTaskControl& loadControl)
   {
@@ -1232,18 +1242,19 @@ namespace moho
       reader.ReadExact(matrix[2][1]);
       reader.ReadExact(matrix[2][2]);
 
-      float ignoredLane0 = 0.0f;
-      float ignoredLane1 = 0.0f;
-      float ignoredLane2 = 0.0f;
-      reader.ReadExact(ignoredLane0);
-      reader.ReadExact(ignoredLane1);
-      reader.ReadExact(ignoredLane2);
+      // The three scale lanes retail reads and drops (EDITOR DIVERGENCE: kept, see CWldPropEntry::mScale).
+      float scaleX = 1.0f;
+      float scaleY = 1.0f;
+      float scaleZ = 1.0f;
+      reader.ReadExact(scaleX);
+      reader.ReadExact(scaleY);
+      reader.ReadExact(scaleZ);
 
       QuaternionLanes orientation = QuaternionFromMatrixRows(matrix);
       NormalizeQuaternionLanes(orientation);
       transform.orient_ = Wm3::Quatf{orientation.w, orientation.x, orientation.y, orientation.z};
 
-      PackWldPropEntry(mEntries[index], transform, blueprintPath);
+      PackWldPropEntry(mEntries[index], transform, blueprintPath, Wm3::Vec3f{scaleX, scaleY, scaleZ});
     }
 
     return true;
@@ -1254,7 +1265,7 @@ namespace moho
    *
    * What it does:
    * Saves all prop entries as blueprint path + position + rotation matrix
-   * lanes in the world-map binary format.
+   * lanes + scale lanes in the world-map binary format (retail writes 1,1,1).
    */
   bool CWldProps::Save(gpg::BinaryWriter& writer) const
   {
@@ -1284,10 +1295,9 @@ namespace moho
       writer.Write(matrix[2][1]);
       writer.Write(matrix[2][2]);
 
-      constexpr float kScaleIdentity = 1.0f;
-      writer.Write(kScaleIdentity);
-      writer.Write(kScaleIdentity);
-      writer.Write(kScaleIdentity);
+      writer.Write(entry.mScale.x);
+      writer.Write(entry.mScale.y);
+      writer.Write(entry.mScale.z);
     }
 
     return true;
diff --git a/src/sdk/moho/sim/CWldMap.h b/src/sdk/moho/sim/CWldMap.h
index 1c99df0..069ceda 100644
--- a/src/sdk/moho/sim/CWldMap.h
+++ b/src/sdk/moho/sim/CWldMap.h
@@ -61,10 +61,14 @@ namespace moho
   {
     msvc8::string mBlueprintPath; // +0x00
     VTransform mTransform;        // +0x1C
+    // EDITOR DIVERGENCE (prop-scale compat layer; retail record is 0x38 bytes and drops the three scale lanes of the
+    // .scmap prop record, CWldProps::Load/Save). Kept per prop so the editor reads, edits and writes them.
+    Wm3::Vec3f mScale{1.0f, 1.0f, 1.0f}; // +0x38
   };
   static_assert(offsetof(CWldPropEntry, mBlueprintPath) == 0x00, "CWldPropEntry::mBlueprintPath offset must be 0x00");
   static_assert(offsetof(CWldPropEntry, mTransform) == 0x1C, "CWldPropEntry::mTransform offset must be 0x1C");
-  static_assert(sizeof(CWldPropEntry) == 0x38, "CWldPropEntry size must be 0x38");
+  static_assert(offsetof(CWldPropEntry, mScale) == 0x38, "CWldPropEntry::mScale offset must be 0x38");
+  static_assert(sizeof(CWldPropEntry) == 0x44, "CWldPropEntry size must be 0x44 (0x38 retail + editor scale)");
 
   struct CWldProps
   {
@@ -93,7 +97,7 @@ namespace moho
      * The whole object is one vector head: the proxy at `+0x00` and
      * `{_Myfirst, _Mylast, _Myend}` at `+0x04`, `+0x08`, `+0x0C`. The growth
      * cap the resize at 0x008922F0 checks is 0x04924924, which is
-     * `0xFFFFFFFF / 0x38` for this element. 0x008916A0 tidies it and frees
+     * `0xFFFFFFFF / 0x38` for the retail element (0x44 in the editor build). 0x008916A0 tidies it and frees
      * the object: `delete props`.
      */
     msvc8::vector<CWldPropEntry> mEntries; // +0x00
diff --git a/src/sdk/moho/sim/Sim.cpp b/src/sdk/moho/sim/Sim.cpp
index 1c4dc0a..bd4c863 100644
--- a/src/sdk/moho/sim/Sim.cpp
+++ b/src/sdk/moho/sim/Sim.cpp
@@ -7063,7 +7063,21 @@ void Sim::Setup(LaunchInfoNew* const info)
     if (props != nullptr && !props->mEntries.empty()) {
       propCount = static_cast<int>(props->mEntries.size());
       for (const CWldPropEntry* entry = props->mEntries.begin(); entry != props->mEntries.end(); ++entry) {
-        (void)PROP_Create(this, entry->mTransform, entry->mBlueprintPath.c_str());
+        Prop* const prop = PROP_Create(this, entry->mTransform, entry->mBlueprintPath.c_str());
+        // EDITOR DIVERGENCE (prop-scale compat layer), same contract as the patched retail exe's MapPropScale
+        // (FA-Binary-Patches-mesh/section/MapPropScale.cpp): the record's scale multiplies the draw scale the
+        // blueprint gave the new prop (Display.UniformScale), per axis; 1,1,1, a lane that is not positive and a
+        // lane above 1000 leave the prop as it is.
+        const Wm3::Vec3f& scale = entry->mScale;
+        const bool scaleUsable = std::isfinite(scale.x) && std::isfinite(scale.y) && std::isfinite(scale.z) &&
+                                 scale.x > 0.0f && scale.y > 0.0f && scale.z > 0.0f && scale.x <= 1000.0f &&
+                                 scale.y <= 1000.0f && scale.z <= 1000.0f;
+        if (prop != nullptr && scaleUsable && (scale.x != 1.0f || scale.y != 1.0f || scale.z != 1.0f)) {
+          prop->mVarDat.mScale.x *= scale.x;
+          prop->mVarDat.mScale.y *= scale.y;
+          prop->mVarDat.mScale.z *= scale.z;
+          prop->ListLinkBefore(&mCoordEntities);
+        }
       }
     }
     gpg::Warnf(" NUM PROPS = %d", propCount);
