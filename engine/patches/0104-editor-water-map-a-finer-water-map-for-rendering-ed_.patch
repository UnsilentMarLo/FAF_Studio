+    const boost::shared_ptr<CD3DDynamicTextureSheet> fine = WaterHiResSheet(*this);
+    if (fine.get() != nullptr) {
+      return boost::static_pointer_cast<ID3DTextureSheet>(fine);
+    }
     return boost::static_pointer_cast<ID3DTextureSheet>(mWaterMapTexture);
   }
 
