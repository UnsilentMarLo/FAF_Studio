+    GradientAt(x, z, gx, gz);
+    float s = P.amount * SmoothStep(P.lineLo, P.lineHi, ground[i]) * (1.0f - SmoothStep(P.steepLo, P.steepHi, sqrt(gx * gx + gz * gz)));
+    if (P.hasMask != 0u) s *= saturate(mask[i]);
+    snow[i] = s;
