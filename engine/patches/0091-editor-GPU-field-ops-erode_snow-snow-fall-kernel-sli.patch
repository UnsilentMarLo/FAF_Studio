+DEFINE_GRADIENT_AT(ground)
+
+NUMTHREADS(16, 16, 1)
+void CSMain(KERNEL_IDS)
+{
+    if (dtid.x >= P.w || dtid.y >= P.h) return;
+    int x = int(dtid.x);
+    int z = int(dtid.y);
+    uint i = dtid.y * P.w + dtid.x;
+    float gx;
