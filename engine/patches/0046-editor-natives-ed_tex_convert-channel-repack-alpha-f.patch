--- /dev/null
+++ b/src/sdk/moho/editor/EdDdsEncode.h
@@ -0,0 +1,297 @@
+// EDITOR: DXT5 DDS encoding for the editor natives that write textures (EdTexConv.cpp: ed_tex_convert, ed_tex_atlas), header-only and free of engine types so it can be tested on its own
+// (moho/editor/tests/EdTexConvTest.cpp). The decoder is EdDdsDecode.h; EdIcon.cpp (ed_dds_write) still has its own older copy of this encoder.
+//
+//   EncodeDxt5(image, levels)   the DDS file bytes of an image as DXT5 with `levels` mip levels (1 = none; a number above the possible count gives the whole chain down to 1 x 1)
+//   Dxt5MapAlpha(data, lut)     rewrites only the alpha blocks of a DXT5 file (every level) through a 256 entry table: the colour bytes stay exactly as they are
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "moho/editor/EdDdsDecode.h"
+
+namespace moho::editor::dds
+{
+  struct Image
+  {
+    int w = 0;
+    int h = 0;
+    std::vector<Px> px;
+  };
+
+  inline std::uint16_t Pack565(const int r, const int g, const int b)
+  {
+    return static_cast<std::uint16_t>(((r * 31 + 127) / 255 << 11) | ((g * 63 + 127) / 255 << 5) | ((b * 31 + 127) / 255));
+  }
+
+  inline void Unpack565(const std::uint16_t c, int& r, int& g, int& b)
+  {
+    r = ((c >> 11) & 31) * 255 / 31;
+    g = ((c >> 5) & 63) * 255 / 63;
+    b = (c & 31) * 255 / 31;
+  }
+
+  /** The 8 byte alpha half of a DXT5 block from 16 values (0..255): the extremes as end points, the 8 value mode (a0 > a1); a block of one value keeps a0 == a1 and index 0. */
+  inline void EncodeAlphaBlock(const int* const a, std::uint8_t* const out)
+  {
+    int amin = 255;
+    int amax = 0;
+    for (int i = 0; i < 16; ++i) {
+      amin = std::min(amin, a[i]);
+      amax = std::max(amax, a[i]);
+    }
+    int pal[8];
+    pal[0] = amax;
+    pal[1] = amin;
+    for (int i = 1; i < 7; ++i) {
+      pal[1 + i] = ((7 - i) * amax + i * amin) / 7;
+    }
+    std::uint64_t bits = 0;
+    for (int i = 0; i < 16; ++i) {
+      int best = 0;
+      int bestErr = 1 << 30;
+      for (int k = 0; k < 8; ++k) {
+        const int e = std::abs(a[i] - pal[k]);
+        if (e < bestErr) {
+          bestErr = e;
+          best = k;
+        }
+      }
+      if (amax == amin) {
+        best = 0;
+      }
+      bits |= static_cast<std::uint64_t>(best) << (3 * i);
+    }
+    out[0] = static_cast<std::uint8_t>(amax);
+    out[1] = static_cast<std::uint8_t>(amin);
+    for (int i = 0; i < 6; ++i) {
+      out[2 + i] = static_cast<std::uint8_t>((bits >> (8 * i)) & 0xFF);
+    }
+  }
+
+  /** One DXT5 block (16 bytes) from 16 pixels (row major, 4 x 4): the alpha as above, the colour as end points along the principal axis of the pixels that carry alpha. */
+  inline void EncodeBlockDxt5(const Px* const px, std::uint8_t* const out)
+  {
+    int alpha[16];
+    for (int i = 0; i < 16; ++i) {
+      alpha[i] = px[i].a;
+    }
+    EncodeAlphaBlock(alpha, out);
+
+    float mean[3] = {0, 0, 0};
+    float weight = 0;
+    for (int i = 0; i < 16; ++i) {
+      const float w = static_cast<float>(px[i].a) + 1.0f;
+      mean[0] += w * px[i].r;
+      mean[1] += w * px[i].g;
+      mean[2] += w * px[i].b;
+      weight += w;
+    }
+    for (float& m : mean) {
+      m /= weight;
+    }
+    float cov[6] = {0, 0, 0, 0, 0, 0};
+    for (int i = 0; i < 16; ++i) {
+      const float w = static_cast<float>(px[i].a) + 1.0f;
+      const float d[3] = {px[i].r - mean[0], px[i].g - mean[1], px[i].b - mean[2]};
+      cov[0] += w * d[0] * d[0];
+      cov[1] += w * d[0] * d[1];
+      cov[2] += w * d[0] * d[2];
+      cov[3] += w * d[1] * d[1];
+      cov[4] += w * d[1] * d[2];
+      cov[5] += w * d[2] * d[2];
+    }
+    float axis[3] = {1.0f, 1.0f, 1.0f};
+    for (int it = 0; it < 8; ++it) {
+      const float nx = cov[0] * axis[0] + cov[1] * axis[1] + cov[2] * axis[2];
+      const float ny = cov[1] * axis[0] + cov[3] * axis[1] + cov[4] * axis[2];
+      const float nz = cov[2] * axis[0] + cov[4] * axis[1] + cov[5] * axis[2];
+      const float len = std::sqrt(nx * nx + ny * ny + nz * nz);
+      if (len < 1e-6f) {
+        break;
+      }
+      axis[0] = nx / len;
+      axis[1] = ny / len;
+      axis[2] = nz / len;
+    }
+    float tmin = 1e30f;
+    float tmax = -1e30f;
+    for (int i = 0; i < 16; ++i) {
+      const float t = (px[i].r - mean[0]) * axis[0] + (px[i].g - mean[1]) * axis[1] + (px[i].b - mean[2]) * axis[2];
+      tmin = std::min(tmin, t);
+      tmax = std::max(tmax, t);
+    }
+    const auto clamp255 = [](const float v) { return static_cast<int>(std::max(0.0f, std::min(255.0f, v + 0.5f))); };
+    std::uint16_t c0 = Pack565(clamp255(mean[0] + axis[0] * tmax), clamp255(mean[1] + axis[1] * tmax), clamp255(mean[2] + axis[2] * tmax));
+    std::uint16_t c1 = Pack565(clamp255(mean[0] + axis[0] * tmin), clamp255(mean[1] + axis[1] * tmin), clamp255(mean[2] + axis[2] * tmin));
+    if (c0 < c1) {
+      std::swap(c0, c1);
+    }
+    int col[4][3];
+    Unpack565(c0, col[0][0], col[0][1], col[0][2]);
+    Unpack565(c1, col[1][0], col[1][1], col[1][2]);
+    for (int k = 0; k < 3; ++k) {
+      col[2][k] = (2 * col[0][k] + col[1][k]) / 3;
+      col[3][k] = (col[0][k] + 2 * col[1][k]) / 3;
+    }
+    std::uint32_t cbits = 0;
+    if (c0 != c1) {
+      for (int i = 0; i < 16; ++i) {
+        int best = 0;
+        int bestErr = 1 << 30;
+        for (int k = 0; k < 4; ++k) {
+          const int dr = px[i].r - col[k][0];
+          const int dg = px[i].g - col[k][1];
+          const int db = px[i].b - col[k][2];
+          const int e = dr * dr + dg * dg + db * db;
+          if (e < bestErr) {
+            bestErr = e;
+            best = k;
+          }
+        }
+        cbits |= static_cast<std::uint32_t>(best) << (2 * i);
+      }
+    }
+    std::memcpy(out + 8, &c0, 2);
+    std::memcpy(out + 10, &c1, 2);
+    std::memcpy(out + 12, &cbits, 4);
+  }
+
+  /** The next mip level: each texel the average of 2 x 2 (the edge texel repeats for an odd side). */
+  inline Image HalfSize(const Image& s)
+  {
+    Image d;
+    d.w = std::max(1, s.w / 2);
+    d.h = std::max(1, s.h / 2);
+    d.px.resize(static_cast<std::size_t>(d.w) * static_cast<std::size_t>(d.h));
+    for (int y = 0; y < d.h; ++y) {
+      for (int x = 0; x < d.w; ++x) {
+        int sum[4] = {0, 0, 0, 0};
+        for (int dy = 0; dy < 2; ++dy) {
+          for (int dx = 0; dx < 2; ++dx) {
+            const int sx = std::min(s.w - 1, x * 2 + dx);
+            const int sy = std::min(s.h - 1, y * 2 + dy);
+            const Px& p = s.px[static_cast<std::size_t>(sy) * static_cast<std::size_t>(s.w) + static_cast<std::size_t>(sx)];
+            sum[0] += p.r;
+            sum[1] += p.g;
+            sum[2] += p.b;
+            sum[3] += p.a;
+          }
+        }
+        d.px[static_cast<std::size_t>(y) * static_cast<std::size_t>(d.w) + static_cast<std::size_t>(x)] =
+          Px{static_cast<std::uint8_t>((sum[0] + 2) / 4), static_cast<std::uint8_t>((sum[1] + 2) / 4), static_cast<std::uint8_t>((sum[2] + 2) / 4), static_cast<std::uint8_t>((sum[3] + 2) / 4)};
+      }
+    }
+    return d;
+  }
+
+  /** The bytes of a DXT5 DDS file with `levels` mip levels (at least 1; more than the chain has gives the whole chain). */
+  inline std::string EncodeDxt5(const Image& base, const int levels)
+  {
+    std::vector<Image> chain;
+    chain.push_back(base);
+    while (static_cast<int>(chain.size()) < levels && (chain.back().w > 1 || chain.back().h > 1)) {
+      chain.push_back(HalfSize(chain.back()));
+    }
+    const int count = static_cast<int>(chain.size());
+
+    std::string out;
+    out.resize(128, '\0');
+    const auto put = [&](const std::size_t at, const std::uint32_t v) { std::memcpy(&out[at], &v, 4); };
+    std::memcpy(&out[0], "DDS ", 4);
+    put(4, 124);
+    // DDSD_CAPS | HEIGHT | WIDTH | PIXELFORMAT | LINEARSIZE, plus MIPMAPCOUNT when there are levels
+    put(8, 0x00081007u | (count > 1 ? 0x00020000u : 0u));
+    put(12, static_cast<std::uint32_t>(base.h));
+    put(16, static_cast<std::uint32_t>(base.w));
+    put(20, static_cast<std::uint32_t>(std::max(1, (base.w + 3) / 4) * std::max(1, (base.h + 3) / 4) * 16));
+    put(28, count > 1 ? static_cast<std::uint32_t>(count) : 0u);
+    put(76, 32);                          // DDS_PIXELFORMAT.dwSize
+    put(80, 0x4);                         // DDPF_FOURCC
+    std::memcpy(&out[84], "DXT5", 4);
+    put(108, count > 1 ? 0x00401008u : 0x00001000u);
+
+    for (const Image& level : chain) {
+      const int bw = std::max(1, (level.w + 3) / 4);
+      const int bh = std::max(1, (level.h + 3) / 4);
+      for (int by = 0; by < bh; ++by) {
+        for (int bx = 0; bx < bw; ++bx) {
+          Px block[16];
+          for (int i = 0; i < 16; ++i) {
+            const int x = std::min(level.w - 1, bx * 4 + (i & 3));
+            const int y = std::min(level.h - 1, by * 4 + (i >> 2));
+            block[i] = level.px[static_cast<std::size_t>(y) * static_cast<std::size_t>(level.w) + static_cast<std::size_t>(x)];
+          }
+          std::uint8_t encoded[16];
+          EncodeBlockDxt5(block, encoded);
+          out.append(reinterpret_cast<const char*>(encoded), 16);
+        }
+      }
+    }
+    return out;
+  }
+
+  /** Decodes the 16 alpha values of the alpha half (8 bytes) of a DXT5 block. */
+  inline void DecodeAlphaBlock(const std::uint8_t* const blk, int* const a)
+  {
+    const int a0 = blk[0];
+    const int a1 = blk[1];
+    std::uint64_t bits = 0;
+    for (int i = 0; i < 6; ++i) {
+      bits |= static_cast<std::uint64_t>(blk[2 + i]) << (8 * i);
+    }
+    int pal[8];
+    pal[0] = a0;
+    pal[1] = a1;
+    if (a0 > a1) {
+      for (int i = 1; i < 7; ++i) {
+        pal[1 + i] = ((7 - i) * a0 + i * a1) / 7;
+      }
+    } else {
+      for (int i = 1; i < 5; ++i) {
+        pal[1 + i] = ((5 - i) * a0 + i * a1) / 5;
+      }
+      pal[6] = 0;
+      pal[7] = 255;
+    }
+    for (int i = 0; i < 16; ++i) {
+      a[i] = pal[(bits >> (3 * i)) & 7];
+    }
+  }
+
+  /** Rewrites the alpha of a DXT5 file in place: every alpha value v of every mip level becomes lut[v]; the colour half of every block is not touched, so the colours stay bit for bit as they were.
+   *  False (nothing changed) when the file is not DXT5 or is too short. */
+  inline bool Dxt5MapAlpha(std::string& data, const std::uint8_t* const lut)
+  {
+    Header hd;
+    if (!ParseHeader(data, hd) || hd.format != Format::Dxt5) {
+      return false;
+    }
+    const int levels = Levels(hd);
+    if (data.size() < LevelOffset(hd, levels - 1) + LevelBytes(hd.format, std::max(1, hd.w >> (levels - 1)), std::max(1, hd.h >> (levels - 1)))) {
+      return false;
+    }
+    auto* const bytes = reinterpret_cast<std::uint8_t*>(&data[0]);
+    for (int level = 0; level < levels; ++level) {
+      int w = 0;
+      int h = 0;
+      LevelSize(hd, level, w, h);
+      const std::size_t blocks = static_cast<std::size_t>(std::max(1, (w + 3) / 4)) * static_cast<std::size_t>(std::max(1, (h + 3) / 4));
+      std::uint8_t* blk = bytes + LevelOffset(hd, level);
+      for (std::size_t b = 0; b < blocks; ++b, blk += 16) {
+        int a[16];
+        DecodeAlphaBlock(blk, a);
+        for (int& v : a) {
+          v = lut[v];
+        }
+        EncodeAlphaBlock(a, blk);
+      }
+    }
+    return true;
+  }
+} // namespace moho::editor::dds
diff --git a/src/sdk/moho/editor/EdTexConv.cpp b/src/sdk/moho/editor/EdTexConv.cpp
new file mode 100644
index 0000000..c0574ec
--- /dev/null
+++ b/src/sdk/moho/editor/EdTexConv.cpp
@@ -0,0 +1,373 @@
+// EDITOR: Lua natives of the layer converter's texture work (faf_studio editor/runtime/lua/editor/texconv.lua; maths in EdTexConv.h, tests in tests/EdTexConvTest.cpp). Whole textures are
+// processed here, because a 1024 x 1024 picture is four million numbers as a Lua table.
+//
+//   ed_tex_convert(src, dst, spec)   -> bytes, width, height, lossless | nil, message
+//        Reads the DDS `src` (a disk path or a VFS path: entries inside the game's archives work), builds a new picture from its channels and writes it as a DXT5 DDS to `dst`.
+//        spec (all optional): size (a square) or width + height (default: the source's size; the source is resampled), mips (levels, default the whole chain),
+//        r / g / b / a = a channel table { from, value, scale, bias, invert, center, lo, hi }:
+//          from  'keep' (default: the channel as it is), 'r' 'g' 'b' 'a', 'lum', 'const' (value), 'atlas' (atlas = { src, tile, ch }: channel ch of tile 1..8 of a roughness / height atlas)
+//          v = source value; invert: 1 - v; center: (v - mean) * scale + 0.5 + bias; otherwise v * scale + bias; then clamped to lo .. hi (defaults 0 .. 1; scale 1, bias 0)
+//        When the source is DXT5 at the result's size and only the alpha changes (keep / r-less: 'a' or 'const', no centring), the alpha blocks of every mip level are rewritten and the colour is
+//        copied bit for bit (lossless = true).
+//   ed_tex_atlas(dst, spec)          -> bytes, report | nil, message
+//        Builds the roughness / height atlas of the PBR terrain shaders (EdTexConv.h: 2 x 2 tiles, eight layers, R G / B A) and writes it as a DXT5 DDS with mip maps.
+//        spec: size (multiple of 8, default 1024), rough / height (the value of a tile with no picture: 0.65 / 0.5), mips, tiles = { [1] = { src, rough = chan, height = chan }, ... [8] }
+//        (tile 1 = base layer, 2..8 = layers 1..7; the channels read channels of that tile's own texture). report[k] = 'ok' | 'no texture' | 'cannot read: ...' per tile 1..8.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <windows.h>
+
+#include "lua/LuaPrimitives.h"
+#include "lua/LuaRuntimeTypes.h"
+#include "moho/editor/EdIcon.h"
+#include "moho/editor/EdTexConv.h"
+#include "moho/lua/CScrLuaBinder.h"
+#include "moho/lua/CScrLuaInitForm.h"
+
+namespace
+{
+  namespace tc = moho::editor::texconv;
+  namespace dds = moho::editor::dds;
+
+  int Fail(lua_State* const L, const std::string& message)
+  {
+    lua_pushnil(L);
+    lua_pushstring(L, message.c_str());
+    return 2;
+  }
+
+  // ---- reading tables (Lua 5.0: absolute indices) ---------------------------------------------------------------------------------------
+
+  /** Pushes t[key] and returns its Lua type (the caller pops with lua_settop(L, -2)). */
+  int Push(lua_State* const L, const int table, const char* const key)
+  {
+    lua_pushstring(L, key);
+    lua_gettable(L, table);
+    return lua_type(L, -1);
+  }
+
+  double Num(lua_State* const L, const int table, const char* const key, const double fallback)
+  {
+    double v = fallback;
+    if (Push(L, table, key) == LUA_TNUMBER) {
+      v = lua_tonumber(L, -1);
+    }
+    lua_settop(L, -2);
+    return v;
+  }
+
+  std::string Str(lua_State* const L, const int table, const char* const key)
+  {
+    std::string v;
+    if (Push(L, table, key) == LUA_TSTRING) {
+      v = lua_tostring(L, -1);
+    }
+    lua_settop(L, -2);
+    return v;
+  }
+
+  bool Flag(lua_State* const L, const int table, const char* const key)
+  {
+    const int type = Push(L, table, key);
+    const bool on = type == LUA_TBOOLEAN && lua_toboolean(L, -1) != 0;
+    lua_settop(L, -2);
+    return on;
+  }
+
+  // ---- channels ---------------------------------------------------------------------------------------------------------------------------
+
+  struct AtlasRef
+  {
+    std::string path;
+    int tile = 1;
+    int channel = 0;
+  };
+
+  /** Reads a channel table at stack index `table` (0 = none: keep). `atlas` gets the atlas reference of from = 'atlas' (c.from stays Keep until the caller has the plane). */
+  tc::Chan ReadChan(lua_State* const L, const int table, bool& wantsAtlas, AtlasRef& atlas)
+  {
+    tc::Chan c;
+    wantsAtlas = false;
+    if (table == 0 || lua_type(L, table) != LUA_TTABLE) {
+      return c;
+    }
+    const std::string from = Str(L, table, "from");
+    if (from == "r") c.from = tc::From::R;
+    else if (from == "g") c.from = tc::From::G;
+    else if (from == "b") c.from = tc::From::B;
+    else if (from == "a") c.from = tc::From::A;
+    else if (from == "lum") c.from = tc::From::Lum;
+    else if (from == "const") c.from = tc::From::Const;
+    else if (from == "atlas") {
+      wantsAtlas = true;
+      if (Push(L, table, "atlas") == LUA_TTABLE) {
+        const int at = lua_gettop(L);
+        atlas.path = Str(L, at, "src");
+        atlas.tile = static_cast<int>(Num(L, at, "tile", 1));
+        const std::string ch = Str(L, at, "ch");
+        atlas.channel = ch == "g" ? 1 : ch == "b" ? 2 : ch == "a" ? 3 : 0;
+      }
+      lua_settop(L, -2);
+    }
+    c.value = static_cast<float>(Num(L, table, "value", 0.0));
+    c.scale = static_cast<float>(Num(L, table, "scale", 1.0));
+    c.bias = static_cast<float>(Num(L, table, "bias", 0.0));
+    c.lo = static_cast<float>(Num(L, table, "lo", 0.0));
+    c.hi = static_cast<float>(Num(L, table, "hi", 1.0));
+    c.invert = Flag(L, table, "invert");
+    c.center = Flag(L, table, "center");
+    return c;
+  }
+
+  // ---- files ------------------------------------------------------------------------------------------------------------------------------
+
+  /** Decodes level `minSide`-picked of an already parsed DDS (`minSide` > 0 picks the smallest mip level whose shorter side is at least that: a big texture reduced to a small tile does not need
+   *  its base level). */
+  bool DecodeData(const std::string& data, const dds::Header& header, const int minSide, dds::Image& out, const std::string& path, std::string& why)
+  {
+    const int level = minSide > 0 ? dds::PickLevel(header, minSide) : 0;
+    if (!dds::DecodeLevel(data, header, level, out.px, out.w, out.h) && (level == 0 || !dds::DecodeLevel(data, header, 0, out.px, out.w, out.h))) {
+      why = "the DDS is damaged: " + path;
+      return false;
+    }
+    return true;
+  }
+
+  /** Reads and decodes a DDS file. */
+  bool LoadDds(const std::string& path, const int minSide, dds::Image& out, std::string& why)
+  {
+    std::string data;
+    dds::Header header;
+    if (!moho::edicon::ReadAllBytes(path, data)) {
+      why = "cannot read " + path;
+      return false;
+    }
+    if (!dds::ParseHeader(data, header)) {
+      why = "not a DDS this editor can read (DXT1 / DXT3 / DXT5 / 32 bit): " + path;
+      return false;
+    }
+    return DecodeData(data, header, minSide, out, path, why);
+  }
+
+  void CreateParents(const std::string& path)
+  {
+    for (std::size_t i = 0; i < path.size(); ++i) {
+      if ((path[i] == '/' || path[i] == '\\') && i > 2) {
+        CreateDirectoryA(path.substr(0, i).c_str(), nullptr);
+      }
+    }
+  }
+
+  bool WriteBytes(const std::string& path, const std::string& bytes, std::string& why)
+  {
+    CreateParents(path);
+    HANDLE f = CreateFileA(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (f == INVALID_HANDLE_VALUE) {
+      why = "cannot create " + path;
+      return false;
+    }
+    DWORD written = 0;
+    const BOOL ok = WriteFile(f, bytes.data(), static_cast<DWORD>(bytes.size()), &written, nullptr);
+    CloseHandle(f);
+    if (!ok || written != bytes.size()) {
+      why = "writing failed: " + path;
+      return false;
+    }
+    return true;
+  }
+
+  // ---- ed_tex_convert ---------------------------------------------------------------------------------------------------------------------
+
+  int __cdecl cfunc_TexConvert(lua_State* const L)
+  {
+    const char* const srcPath = lua_tostring(L, 1);
+    const char* const dstPath = lua_tostring(L, 2);
+    if (srcPath == nullptr || dstPath == nullptr) {
+      return Fail(L, "ed_tex_convert(src, dst, spec): bad arguments");
+    }
+    const bool hasSpec = lua_type(L, 3) == LUA_TTABLE;
+    const int spec = hasSpec ? 3 : 0;
+
+    dds::Image src;
+    std::string data;
+    dds::Header header;
+    std::string why;
+    // the colour and size of the result decide whether the file can be edited block by block: read the channels first
+    tc::Chan chans[4];
+    bool wantsAtlas[4] = {false, false, false, false};
+    AtlasRef atlasRef[4];
+    static const char* const names[4] = {"r", "g", "b", "a"};
+    for (int c = 0; c < 4; ++c) {
+      if (hasSpec && Push(L, spec, names[c]) == LUA_TTABLE) {
+        chans[c] = ReadChan(L, lua_gettop(L), wantsAtlas[c], atlasRef[c]);
+      }
+      if (hasSpec) {
+        lua_settop(L, -2);
+      }
+    }
+    int width = 0;
+    int height = 0;
+    int levels = 32;
+    if (hasSpec) {
+      const int side = static_cast<int>(Num(L, spec, "size", 0));
+      width = static_cast<int>(Num(L, spec, "width", side));
+      height = static_cast<int>(Num(L, spec, "height", side));
+      levels = static_cast<int>(Num(L, spec, "mips", 32));
+    }
+
+    if (!moho::edicon::ReadAllBytes(srcPath, data) || !dds::ParseHeader(data, header)) {
+      return Fail(L, std::string("cannot read the DDS ") + srcPath);
+    }
+    if (width < 1 || height < 1) {
+      width = header.w;
+      height = header.h;
+    }
+    if (width > 4096 || height > 4096) {
+      return Fail(L, "the size is at most 4096");
+    }
+
+    // alpha only: the colour blocks stay as they are
+    std::uint8_t lut[256];
+    const bool colourKept = chans[0].from == tc::From::Keep && chans[1].from == tc::From::Keep && chans[2].from == tc::From::Keep;
+    if (header.format == dds::Format::Dxt5 && width == header.w && height == header.h && colourKept && !wantsAtlas[3] && tc::AlphaTable(chans[3], lut) && levels >= dds::Levels(header)) {
+      std::string out = data;
+      if (dds::Dxt5MapAlpha(out, lut)) {
+        if (!WriteBytes(dstPath, out, why)) {
+          return Fail(L, why);
+        }
+        lua_pushnumber(L, static_cast<lua_Number>(out.size()));
+        lua_pushnumber(L, width);
+        lua_pushnumber(L, height);
+        lua_pushboolean(L, 1);
+        return 4;
+      }
+    }
+
+    if (!DecodeData(data, header, 0, src, srcPath, why)) {
+      return Fail(L, why);
+    }
+    // planes from atlases
+    std::vector<tc::Plane> external;
+    external.reserve(4);
+    for (int c = 0; c < 4; ++c) {
+      if (!wantsAtlas[c]) {
+        continue;
+      }
+      dds::Image atlas;
+      if (!LoadDds(atlasRef[c].path, 0, atlas, why)) {
+        return Fail(L, why);
+      }
+      external.push_back(tc::AtlasTilePlane(atlas, std::max(1, std::min(8, atlasRef[c].tile)) - 1, atlasRef[c].channel, width, height));
+      chans[c].from = tc::From::Ext;
+      chans[c].ext = &external.back();
+    }
+    const dds::Image out = tc::Convert(src, width, height, chans);
+    const std::string bytes = dds::EncodeDxt5(out, std::max(1, levels));
+    if (!WriteBytes(dstPath, bytes, why)) {
+      return Fail(L, why);
+    }
+    lua_pushnumber(L, static_cast<lua_Number>(bytes.size()));
+    lua_pushnumber(L, width);
+    lua_pushnumber(L, height);
+    lua_pushboolean(L, 0);
+    return 4;
+  }
+
+  // ---- ed_tex_atlas -----------------------------------------------------------------------------------------------------------------------
+
+  int __cdecl cfunc_TexAtlas(lua_State* const L)
+  {
+    const char* const dstPath = lua_tostring(L, 1);
+    if (dstPath == nullptr || lua_type(L, 2) != LUA_TTABLE) {
+      return Fail(L, "ed_tex_atlas(dst, spec): bad arguments");
+    }
+    const int spec = 2;
+    int size = static_cast<int>(Num(L, spec, "size", 1024));
+    size = std::max(64, std::min(4096, size)) / 8 * 8;
+    const float roughDefault = static_cast<float>(Num(L, spec, "rough", 0.65));
+    const float heightDefault = static_cast<float>(Num(L, spec, "height", 0.5));
+    const int levels = static_cast<int>(Num(L, spec, "mips", 32));
+    const int D = size / 4;
+
+    std::vector<tc::Plane> rough(tc::kAtlasTiles);
+    std::vector<tc::Plane> height(tc::kAtlasTiles);
+    std::vector<std::string> report(tc::kAtlasTiles, "no texture");
+    if (Push(L, spec, "tiles") == LUA_TTABLE) {
+      const int tiles = lua_gettop(L);
+      for (int k = 0; k < tc::kAtlasTiles; ++k) {
+        lua_rawgeti(L, tiles, k + 1);
+        if (lua_type(L, -1) == LUA_TTABLE) {
+          const int tile = lua_gettop(L);
+          const std::string path = Str(L, tile, "src");
+          bool unusedAtlas = false;
+          AtlasRef unusedRef;
+          tc::Chan chanRough;
+          tc::Chan chanHeight;
+          if (Push(L, tile, "rough") == LUA_TTABLE) chanRough = ReadChan(L, lua_gettop(L), unusedAtlas, unusedRef);
+          lua_settop(L, -2);
+          if (Push(L, tile, "height") == LUA_TTABLE) chanHeight = ReadChan(L, lua_gettop(L), unusedAtlas, unusedRef);
+          lua_settop(L, -2);
+          dds::Image image;
+          std::string why;
+          const bool loaded = !path.empty() && LoadDds(path, D * 2, image, why);
+          if (loaded) {
+            report[k] = "ok";
+          } else if (!path.empty()) {
+            report[k] = "cannot read: " + why;
+          }
+          // a channel that reads the texture needs it; a constant does not (and a tile whose texture is missing keeps the defaults for the rest)
+          tc::Plane p;
+          if ((loaded || chanRough.from == tc::From::Const) && tc::MakePlane(chanRough, image.px, image.w, image.h, D, D, p)) {
+            rough[k] = p;
+          }
+          if ((loaded || chanHeight.from == tc::From::Const) && tc::MakePlane(chanHeight, image.px, image.w, image.h, D, D, p)) {
+            height[k] = p;
+          }
+        }
+        lua_settop(L, -2);
+      }
+    }
+    lua_settop(L, -2);
+
+    const dds::Image atlas = tc::BuildAtlas(size, rough.data(), height.data(), roughDefault, heightDefault);
+    const std::string bytes = dds::EncodeDxt5(atlas, std::max(1, levels));
+    std::string why;
+    if (!WriteBytes(dstPath, bytes, why)) {
+      return Fail(L, why);
+    }
+    lua_pushnumber(L, static_cast<lua_Number>(bytes.size()));
+    lua_newtable(L);
+    for (int k = 0; k < tc::kAtlasTiles; ++k) {
+      lua_pushnumber(L, static_cast<lua_Number>(k + 1));
+      lua_pushstring(L, report[static_cast<std::size_t>(k)].c_str());
+      lua_settable(L, -3);
+    }
+    return 2;
+  }
+
+  [[nodiscard]] moho::CScrLuaInitFormSet& UserLuaInitSet()
+  {
+    if (moho::CScrLuaInitFormSet* const set = moho::SCR_FindLuaInitFormSet("User"); set != nullptr) {
+      return *set;
+    }
+    static moho::CScrLuaInitFormSet fallbackSet("User");
+    return fallbackSet;
+  }
+
+  struct EdTexConvLuaBootstrap
+  {
+    EdTexConvLuaBootstrap()
+    {
+      auto& set = UserLuaInitSet();
+      (void)new moho::CScrLuaBinder(set, "ed_tex_convert", &cfunc_TexConvert, nullptr, "<global>", "ed_tex_convert(src, dst, spec) -> bytes, width, height, lossless | nil, message");
+      (void)new moho::CScrLuaBinder(set, "ed_tex_atlas", &cfunc_TexAtlas, nullptr, "<global>", "ed_tex_atlas(dst, spec) -> bytes, report | nil, message");
+    }
+  };
+
+  const EdTexConvLuaBootstrap gEdTexConvLuaBootstrap{};
+} // namespace
