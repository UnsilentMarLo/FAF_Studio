         float amp = s.amps[o];
@@ -116,12 +110,30 @@ namespace moho::editor::field
           const float f = Clamp01(steep * 0.6f);
           amp *= std::max(0.0f, 1.0f + s.slopeDetail * (2.0f * f - 1.0f));
         }
+        if (erosive && o > 0 && eroAmp > 0.0f) {
