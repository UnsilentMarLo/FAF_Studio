+++ b/src/sdk/moho/editor/EdRenderStats.cpp
@@ -0,0 +1,136 @@
+// EDITOR: the render-side console variables and the ed_render_stats() native (see EdRenderStats.h).
+#include "moho/editor/EdRenderStats.h"
+
+#include "lua/LuaPrimitives.h"
+#include "lua/LuaRuntimeTypes.h"
+#include "moho/console/CConCommand.h"
+#include "moho/editor/EdShadowCache.h"
+#include "moho/lua/CScrLuaBinder.h"
+#include "moho/lua/CScrLuaInitForm.h"
+
+namespace moho
+{
+  bool ren_ShadowCache = true;
+  bool ren_ShadowCacheTrees = false;
+  int ren_ShadowCacheMaxAge = 300;
+  bool ren_WaterSkipDisabled = true;
+  bool ui_CullOffscreen = true;
+  bool ui_SkipTransparent = true;
+  bool ren_AtlasFastLookup = true;
+} // namespace moho
+
+namespace
+{
+  moho::TConVar<bool> gTConVar_ren_ShadowCache(
+    "ren_ShadowCache",
+    "Skip the shadow pass while the light camera, the shadow settings and the scene are the same as when the shadow map was drawn (1 = on, 0 = draw it every frame)",
+    &moho::ren_ShadowCache
+  );
+  moho::TConVar<bool> gTConVar_ren_ShadowCacheTrees(
+    "ren_ShadowCacheTrees",
+    "1 = a shadow map drawn with wind swaying trees may be reused too (the sway moves less than a texel); 0 = such a map is drawn every frame",
+    &moho::ren_ShadowCacheTrees
+  );
+  moho::TConVar<int> gTConVar_ren_ShadowCacheMaxAge(
+    "ren_ShadowCacheMaxAge",
+    "A reused shadow map is drawn again after this many frames, whatever the checks say (0 = never)",
+    &moho::ren_ShadowCacheMaxAge
+  );
+  moho::TConVar<bool> gTConVar_ren_WaterSkipDisabled(
+    "ren_WaterSkipDisabled",
+    "1 = a map with its water switched off skips the reflection pass, the water mask, the refraction copy and the water surface",
+    &moho::ren_WaterSkipDisabled
+  );
+  moho::TConVar<bool> gTConVar_ui_CullOffscreen(
+    "ui_CullOffscreen",
+    "1 = Maui bitmaps, borders and texts that lie completely outside the window are not built and queued",
+    &moho::ui_CullOffscreen
+  );
+  moho::TConVar<bool> gTConVar_ui_SkipTransparent(
+    "ui_SkipTransparent",
+    "1 = Maui bitmaps and borders with alpha 0 are not drawn",
+    &moho::ui_SkipTransparent
+  );
+  moho::TConVar<bool> gTConVar_ren_AtlasFastLookup(
+    "ren_AtlasFastLookup",
+    "1 = the texture atlas of the prim batcher finds a texture it holds by its address before it walks its ordered set",
+    &moho::ren_AtlasFastLookup
+  );
+
+  void Put(lua_State* const L, const char* const key, const double value)
+  {
+    lua_pushstring(L, key);
+    lua_pushnumber(L, static_cast<lua_Number>(value));
+    lua_settable(L, -3);
+  }
+
+  // ed_render_stats() -> table of the last complete frame (counts are per frame, ms are CPU time on the render thread):
+  //   drawCalls, primitives, vertices                  every draw the graphics backend got (whatever issued it)
+  //   batcherFlushes, batcherVertices, batcherIndices  the prim batcher (UI, text, overlay): one flush is one draw call; vertices / 4 = quads
+  //   overlayMs, overlayFlushes, overlayVertices       the editor's native overlay (slope view, grids, lines, icons): its share of the above
+  //   uiMs                                             Maui: CUIManager::RenderFrames + DrawUI
+  //   uiBitmapsDrawn / Culled / Transparent, uiBordersDrawn / Culled, uiTextsDrawn / Culled
+  //   atlasLookups, atlasFastHits, atlasAdds, atlasResets
+  //   shadowMs, shadowSceneMs, shadowRendered, shadowReused     the shadow pass of the frame (1 / 0)
+  //   waterSkipped                                     1 when the water passes were left out
+  //   renderMs                                         WRenViewport::Render, all heads
+  // and since the start: frames, shadowHits, shadowMisses, waterSkippedFrames
+  int __cdecl cfunc_EdRenderStats(lua_State* const L)
+  {
+    namespace rs = moho::editor::renderstats;
+    const rs::Frame& f = rs::gLast;
+    lua_newtable(L);
+    Put(L, "frames", static_cast<double>(rs::gFrames));
+    Put(L, "drawCalls", f.drawCalls);
+    Put(L, "primitives", f.primitives);
+    Put(L, "vertices", f.vertices);
+    Put(L, "batcherFlushes", f.batcherFlushes);
+    Put(L, "batcherVertices", f.batcherVertices);
+    Put(L, "batcherIndices", f.batcherIndices);
+    Put(L, "overlayMs", f.overlayMs);
+    Put(L, "overlayFlushes", f.overlayFlushes);
+    Put(L, "overlayVertices", f.overlayVertices);
+    Put(L, "uiMs", f.uiMs);
+    Put(L, "uiBitmapsDrawn", f.uiBitmapsDrawn);
+    Put(L, "uiBitmapsCulled", f.uiBitmapsCulled);
+    Put(L, "uiBitmapsTransparent", f.uiBitmapsTransparent);
+    Put(L, "uiBordersDrawn", f.uiBordersDrawn);
+    Put(L, "uiBordersCulled", f.uiBordersCulled);
+    Put(L, "uiTextsDrawn", f.uiTextsDrawn);
+    Put(L, "uiTextsCulled", f.uiTextsCulled);
+    Put(L, "atlasLookups", f.atlasLookups);
+    Put(L, "atlasFastHits", f.atlasFastHits);
+    Put(L, "atlasAdds", f.atlasAdds);
+    Put(L, "atlasResets", f.atlasResets);
+    Put(L, "shadowMs", f.shadowMs);
+    Put(L, "shadowSceneMs", f.shadowSceneMs);
+    Put(L, "shadowRendered", f.shadowRendered);
+    Put(L, "shadowReused", f.shadowReused);
+    Put(L, "waterSkipped", f.waterSkipped);
+    Put(L, "renderMs", f.renderMs);
+    Put(L, "shadowHits", static_cast<double>(rs::gShadowHits));
+    Put(L, "shadowMisses", static_cast<double>(rs::gShadowMisses));
+    Put(L, "waterSkippedFrames", static_cast<double>(rs::gWaterSkippedFrames));
+    return 1;
+  }
+
+  [[nodiscard]] moho::CScrLuaInitFormSet& UserLuaInitSet()
+  {
+    if (moho::CScrLuaInitFormSet* const set = moho::SCR_FindLuaInitFormSet("User"); set != nullptr) {
+      return *set;
+    }
+    static moho::CScrLuaInitFormSet fallbackSet("User");
+    return fallbackSet;
+  }
+
+  struct EdRenderStatsLuaBootstrap
+  {
+    EdRenderStatsLuaBootstrap()
+    {
+      (void)new moho::CScrLuaBinder(UserLuaInitSet(), "ed_render_stats", &cfunc_EdRenderStats, nullptr, "<global>",
+                                    "ed_render_stats() -> table: draw calls, batcher flushes, UI controls drawn / culled, atlas lookups, shadow cache, water skip, CPU ms of the last frame");
+    }
+  };
+
+  const EdRenderStatsLuaBootstrap gEdRenderStatsLuaBootstrap{};
+} // namespace
diff --git a/src/sdk/moho/editor/EdRenderStats.h b/src/sdk/moho/editor/EdRenderStats.h
new file mode 100644
index 0000000..c86e842
--- /dev/null
+++ b/src/sdk/moho/editor/EdRenderStats.h
@@ -0,0 +1,117 @@
+// EDITOR: render-side switches and per-frame counters of the editor (docs/projects/editor/PERFORMANCE.md, section "GPU and render").
+//
+// Console variables (all default to the setting that gives the same picture as before, only with less work; 0 switches an optimisation off):
+//   ren_ShadowCache         1    skip the shadow pass when the light camera, the settings and the scene are the same as when the map in the render target was drawn (EdShadowCache.h)
+//   ren_ShadowCacheTrees    0    1: a map drawn with wind swaying trees (UndulatingDepthClip) may be reused too (the sway is a fraction of a texel; changes the picture by that much)
+//   ren_ShadowCacheMaxAge   300  the held shadow map is drawn again after this many reused frames (0: never)
+//   ren_WaterSkipDisabled   1    a map with water switched off (water_on 0) skips the reflection pass, the water mask, the refraction copy and the water surface
+//   ui_CullOffscreen        1    Maui bitmaps / borders / texts that lie completely outside the window are not built and queued (EdUiCull.h)
+//   ui_SkipTransparent      1    Maui bitmaps / borders whose alpha is 0 are not drawn
+//   ren_AtlasFastLookup     1    the texture atlas finds a texture it holds by pointer (hash) before it walks its ordered set
+// Lua: ed_render_stats() -> table (see EdRenderStats.cpp).
+//
+// All counters are plain integers: everything that writes them runs on the main thread (the render pass, the UI pass and the Lua natives are the same thread).
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+
+namespace moho
+{
+  extern bool ren_ShadowCache;
+  extern bool ren_ShadowCacheTrees;
+  extern int ren_ShadowCacheMaxAge;
+  extern bool ren_WaterSkipDisabled;
+  extern bool ui_CullOffscreen;
+  extern bool ui_SkipTransparent;
+  extern bool ren_AtlasFastLookup;
+}
+
+namespace moho::editor::renderstats
+{
+  /** What one frame did. Counters of the frame that is being built are in `Cur()`, the numbers of the last complete frame in `Last()`. */
+  struct Frame
+  {
+    // from the graphics backend (every DrawPrimitive / DrawIndexedPrimitive of the frame, whatever issued it)
+    std::uint32_t drawCalls = 0;
+    std::uint32_t primitives = 0;
+    std::uint32_t vertices = 0;
+    // the prim batcher (UI, text, editor overlay, ranges ...): one flush is one draw call
+    std::uint32_t batcherFlushes = 0;
+    std::uint32_t batcherVertices = 0;
+    std::uint32_t batcherIndices = 0;
+    // texture lookups of the batcher
+    std::uint32_t atlasLookups = 0;
+    std::uint32_t atlasFastHits = 0;
+    std::uint32_t atlasAdds = 0;
+    std::uint32_t atlasResets = 0;
+    // Maui controls
+    std::uint32_t uiBitmapsDrawn = 0;
+    std::uint32_t uiBitmapsCulled = 0;       // outside the window
+    std::uint32_t uiBitmapsTransparent = 0;  // alpha 0
+    std::uint32_t uiBordersDrawn = 0;
+    std::uint32_t uiBordersCulled = 0;
+    std::uint32_t uiTextsDrawn = 0;
+    std::uint32_t uiTextsCulled = 0;
+    // the editor's native overlay (EdOverlay.cpp edoverlay::Render): its share of the batcher's work
+    std::uint32_t overlayFlushes = 0;
+    std::uint32_t overlayVertices = 0;
+    // shadow map
+    std::uint32_t shadowRendered = 0;        // 1 when this frame drew the map
+    std::uint32_t shadowReused = 0;          // 1 when it was reused
+    // water
+    std::uint32_t waterSkipped = 0;          // 1 when the water passes were left out (water switched off)
+    // CPU milliseconds on the render thread (submission, not GPU time)
+    double uiMs = 0.0;                       // CUIManager::RenderFrames + DrawUI
+    double shadowMs = 0.0;                   // Shadow::RenderFrameShadows (cache check, batch, depth pass, blur)
+    double shadowSceneMs = 0.0;              // of that: the signature of the scene
+    double renderMs = 0.0;                   // WRenViewport::Render (all heads)
+    double overlayMs = 0.0;                  // edoverlay::Render (building and queueing the quads, and the flushes it causes)
+  };
+
+  inline Frame gCur;
+  inline Frame gLast;
+  inline std::uint64_t gFrames = 0;
+
+  /** Cumulative since start (not per frame). */
+  inline std::uint64_t gShadowHits = 0;
+  inline std::uint64_t gShadowMisses = 0;
+  inline std::uint64_t gWaterSkippedFrames = 0;
+
+  inline double NowMs() noexcept
+  {
+    using Clock = std::chrono::steady_clock;
+    return std::chrono::duration<double, std::milli>(Clock::now().time_since_epoch()).count();
+  }
+
+  /** Adds the time between construction and destruction to a counter. */
+  class ScopedMs
+  {
+  public:
+    explicit ScopedMs(double& sink) noexcept
+      : sink_(sink)
+      , start_(NowMs())
+    {}
+    ~ScopedMs() { sink_ += NowMs() - start_; }
+    ScopedMs(const ScopedMs&) = delete;
+    ScopedMs& operator=(const ScopedMs&) = delete;
+
+  private:
+    double& sink_;
+    double start_;
+  };
+
+  /**
+   * Called once per frame, right before the graphics backend's draw statistics are taken (WRenViewport::D3DWindowOnDeviceRender): `backend*` are the submissions since the
+   * last call, i.e. those of the frame that has just ended. The counters of that frame become `Last()`, the new frame starts at zero.
+   */
+  inline void NextFrame(const std::uint32_t backendDrawCalls, const std::uint32_t backendPrimitives, const std::uint32_t backendVertices) noexcept
+  {
+    gLast = gCur;
+    gLast.drawCalls = backendDrawCalls;
+    gLast.primitives = backendPrimitives;
+    gLast.vertices = backendVertices;
+    gCur = Frame{};
+    ++gFrames;
+  }
+} // namespace moho::editor::renderstats
diff --git a/src/sdk/moho/editor/EdShadowCache.h b/src/sdk/moho/editor/EdShadowCache.h
new file mode 100644
index 0000000..a204436
--- /dev/null
+++ b/src/sdk/moho/editor/EdShadowCache.h
@@ -0,0 +1,168 @@
+// EDITOR: the logic of the shadow map cache (engine independent, tested on its own: moho/editor/tests/EdShadowCacheTest.cpp).
+//
+// The shadow pass of a frame (Shadow::RenderShadowMap) draws every mesh in the light's frustum into a depth map and blurs it twice. In an editor the scene is still most of the time
+// (the user looks at it, moves the mouse, types in a panel), and then the map of this frame is the map of the last one. The pass is skipped when everything that decides what it draws
+// is the same as when the map in the render target was made:
+//   * the light camera (view projection matrix, bit for bit: it follows from the view camera, the sun and the terrain extent),
+//   * the shadow settings and the render targets (size, fidelity, blur, and the target objects themselves: a device reset or a changed setting builds new ones),
+//   * the scene as MeshRenderer::Batch collected it for the light camera: which instances, with which transform, scale, colour, parameters, dissolve, scroll, and the bones of the
+//     skinned ones (a signature over all of them, see Shadow.cpp ShadowSceneSignature),
+//   * time: a depth technique that moves with the clock (the wind of the trees: UndulatingDepthClip) makes the map different every frame, such a map is never reused (unless the
+//     user asks for it with ren_ShadowCacheTrees: the sway is a fraction of a texel).
+// A map is also made again after `maxAge` frames whatever the checks say (a safety net: a stale map can never stay for long).
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace moho::editor::shadowcache
+{
+  /** 64 bit mixing hash over 32 bit words (not cryptographic: the aim is that two different scenes do not give the same value). */
+  class Hasher
+  {
+  public:
+    void Add(const std::uint32_t word) noexcept
+    {
+      state_ ^= word + 0x9E3779B9u + (state_ << 6) + (state_ >> 2);
+      state_ *= 0xFF51AFD7ED558CCDull;
+      state_ ^= state_ >> 32;
+    }
+
+    void AddFloat(const float value) noexcept
+    {
+      std::uint32_t bits = 0;
+      std::memcpy(&bits, &value, sizeof(bits));
+      Add(bits);
+    }
+
+    void AddPointer(const void* const pointer) noexcept
+    {
+      const auto value = reinterpret_cast<std::uintptr_t>(pointer);
+      Add(static_cast<std::uint32_t>(value & 0xFFFFFFFFu));
+      Add(static_cast<std::uint32_t>(static_cast<std::uint64_t>(value) >> 32));
+    }
+
+    void AddBytes(const void* const data, const std::size_t size) noexcept
+    {
+      const auto* bytes = static_cast<const unsigned char*>(data);
+      std::size_t i = 0;
+      for (; i + 4 <= size; i += 4) {
+        std::uint32_t word = 0;
+        std::memcpy(&word, bytes + i, 4);
+        Add(word);
+      }
+      std::uint32_t tail = 0;
+      std::size_t n = 0;
+      for (; i < size; ++i, ++n) {
+        tail |= static_cast<std::uint32_t>(bytes[i]) << (8u * static_cast<unsigned>(n));
+      }
+      if (n != 0) {
+        Add(tail ^ 0xA5000000u);
+      }
+    }
+
+    [[nodiscard]] std::uint64_t Value() const noexcept { return state_; }
+
+  private:
+    std::uint64_t state_ = 0x243F6A8885A308D3ull;
+  };
+
+  /** Everything the map in the render target depends on. */
+  struct Key
+  {
+    std::uint64_t scene = 0;       // signature of the batched instances and their bones (sum of per instance hashes: the order the spatial db lists them in does not matter)
+    float lightViewProjection[16] = {};
+    int size = 0;
+    int fidelity = 0;
+    bool blur = false;
+    const void* owner = nullptr;   // the Shadow object
+    const void* targets[3] = {};   // shadow map, blur targets A and B (rebuilt targets are other objects)
+  };
+
+  [[nodiscard]] inline bool SameKey(const Key& a, const Key& b) noexcept
+  {
+    return a.scene == b.scene && std::memcmp(a.lightViewProjection, b.lightViewProjection, sizeof(a.lightViewProjection)) == 0 && a.size == b.size && a.fidelity == b.fidelity &&
+           a.blur == b.blur && a.owner == b.owner && a.targets[0] == b.targets[0] && a.targets[1] == b.targets[1] && a.targets[2] == b.targets[2];
+  }
+
+  struct State
+  {
+    bool valid = false;
+    Key key;
+    std::uint8_t timeMask = 0;     // the map that is held was drawn with depth techniques that depend on the clock (kTimeWind, kTimeOther)
+    int age = 0;                   // frames the held map has been reused
+    // counters for ed_render_stats (since the start)
+    std::uint32_t hits = 0;
+    std::uint32_t misses = 0;
+  };
+
+  constexpr std::uint8_t kTimeWind = 1;    // UndulatingDepthClip: trees that sway in the wind
+  constexpr std::uint8_t kTimeOther = 2;   // a technique this code does not know
+
+  /**
+   * Hooks of the mesh code (render thread only). `gPassTimeMask`: MeshRenderer::RenderDepth ORs in the kTime bits of every depth technique it draws with; the shadow pass clears it
+   * before the call and reads it after. `gAccumulateBones` / `gBoneSum`: while the flag is set, the bone palette code adds one hash of every instance's bones to the sum (the shadow
+   * pass sets the flag around its MeshRenderer::Batch call, which writes the bones of all skinned instances it collects).
+   */
+  inline std::uint8_t gPassTimeMask = 0;
+  inline bool gAccumulateBones = false;
+  inline std::uint64_t gBoneSum = 0;
+
+  enum class Decision
+  {
+    Render,   // draw the map (and Store the result)
+    Reuse,    // the render target still holds the right map
+  };
+
+  /**
+   * Whether this frame's map can be the held one. `enabled` is ren_ShadowCache, `treesStatic` ren_ShadowCacheTrees, `maxAge` ren_ShadowCacheMaxAge (<= 0: no limit).
+   * A hit counts one more frame of age; every other outcome leaves the held map as it is (Store replaces it after the pass).
+   */
+  [[nodiscard]] inline Decision Decide(State& state, const Key& now, const bool enabled, const bool treesStatic, const int maxAge) noexcept
+  {
+    const std::uint8_t blocking = static_cast<std::uint8_t>(state.timeMask & static_cast<std::uint8_t>(treesStatic ? kTimeOther : (kTimeWind | kTimeOther)));
+    const bool timeBlocks = blocking != 0;
+    if (enabled && state.valid && !timeBlocks && SameKey(state.key, now) && (maxAge <= 0 || state.age < maxAge)) {
+      ++state.age;
+      ++state.hits;
+      return Decision::Reuse;
+    }
+    ++state.misses;
+    return Decision::Render;
+  }
+
+  /** The pass has just drawn the map for `key`; `timeMask`: the kTime... bits of the depth techniques it used. */
+  inline void Store(State& state, const Key& key, const std::uint8_t timeMask) noexcept
+  {
+    state.valid = true;
+    state.key = key;
+    state.timeMask = timeMask;
+    state.age = 0;
+  }
+
+  /** The held map is gone or can no longer be trusted (targets released, settings changed). */
+  inline void Invalidate(State& state) noexcept
+  {
+    state.valid = false;
+    state.age = 0;
+  }
+
+  /**
+   * The kTime... bits of one depth technique of mesh.fx. `Depth`, `DepthClip` (transform and albedo alpha only) and `SeraphimBuildDepth` (also the instance's fraction complete
+   * parameter, which the signature holds) look the same in every frame of a still scene: 0. `UndulatingDepthClip` moves with the clock (wind): kTimeWind. Any other name: kTimeOther.
+   */
+  [[nodiscard]] inline std::uint8_t ClassifyDepthTechnique(const char* const name) noexcept
+  {
+    if (name == nullptr) {
+      return kTimeOther;
+    }
+    if (std::strcmp(name, "Depth") == 0 || std::strcmp(name, "DepthClip") == 0 || std::strcmp(name, "SeraphimBuildDepth") == 0) {
+      return 0;
+    }
+    if (std::strcmp(name, "UndulatingDepthClip") == 0) {
+      return kTimeWind;
+    }
+    return kTimeOther;
+  }
+} // namespace moho::editor::shadowcache
