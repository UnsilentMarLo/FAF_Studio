+      return cur;
+    };
+    const std::vector<std::uint16_t> plain = stroke(0.0f), varied = stroke(0.9f), again = stroke(0.9f);
+    CHECK(varied == again, "the brush with variation is not repeatable");
+    CHECK(varied != plain, "the brush variation changed nothing");
+  }
+}
