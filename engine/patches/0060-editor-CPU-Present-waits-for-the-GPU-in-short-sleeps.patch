diff --git a/src/sdk/moho/editor/EdPerf.cpp b/src/sdk/moho/editor/EdPerf.cpp
new file mode 100644
index 0000000..1f2e328
--- /dev/null
+++ b/src/sdk/moho/editor/EdPerf.cpp
@@ -0,0 +1,533 @@
+// EDITOR: main loop frame pacing and CPU statistics, see EdPerf.h and EdPerfPolicy.h.
+//
+// Thread model: everything here runs on the main thread (the wx loop in WinApp.cpp, CD3DDevice::Paint, the UI Lua state). No D3D, no Lua and no engine state is touched from
+// any other thread; the one worker-free trick is a waitable timer the main thread sleeps on.
+
+#include "moho/editor/EdPerf.h"
+#include "moho/editor/EdPerfPolicy.h"
+
+#include <Windows.h>
+#include <TlHelp32.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "gpg/gal/Device.hpp"
+#include "gpg/gal/DeviceContext.hpp"
+#include "lua/LuaPrimitives.h"
+#include "lua/LuaRuntimeTypes.h"
+#include "moho/console/CConCommand.h"
+#include "moho/core/Thread.h"
+#include "moho/lua/CScrLuaBinder.h"
+#include "moho/lua/CScrLuaInitForm.h"
+#include "moho/sim/CWldSession.h"
+
+namespace gpg::gal
+{
+  extern bool (*gPresentWaitSleep)();   // D3D9Interfaces.cpp
+}
+
+namespace moho::editor::perf
+{
+  namespace
+  {
+    // ---- console variables ---------------------------------------------------------------------------------------------------------------------
+
+    bool gThrottleOn = true;
+    float gFpsLimit = 300.0f;
+    float gFpsLoading = 60.0f;
+    float gFpsBackground = 60.0f;
+    float gFpsIdle = 0.0f;
+    float gIdleSeconds = 10.0f;
+
+    TConVar<bool> gConThrottle("ed_fps_throttle", "Editor: 1 = the frame rate limiter of the main loop is on (ed_fps_limit, ed_fps_loading, ed_fps_background, ed_fps_idle)", &gThrottleOn);
+    TConVar<float> gConLimit("ed_fps_limit", "Editor: frames per second cap while the editor is in use, 0 = none (default 300)", &gFpsLimit);
+    TConVar<float> gConLoading("ed_fps_loading", "Editor: frames per second cap while a map loads, 0 = none (default 60)", &gFpsLoading);
+    TConVar<float> gConBackground("ed_fps_background", "Editor: frames per second cap while another program has the focus, 0 = none (default 60)", &gFpsBackground);
+    TConVar<float> gConIdle("ed_fps_idle", "Editor: frames per second cap after ed_idle_seconds without keyboard or mouse input, 0 = none (default 0)", &gFpsIdle);
+    bool gPresentWait = true;
+    TConVar<bool> gConPresentWait("ed_present_wait", "Editor: 1 = Present waits for the GPU in short sleeps instead of a spin that keeps a core at 100 percent (default 1)", &gPresentWait);
+    bool gParallelNormalMap = true;
+    TConVar<bool> gConParNormalMap("ed_par_normalmap", "Editor: 1 = big normal map updates (map load, whole map edits) use the worker pool (default 1)", &gParallelNormalMap);
+    TConVar<float> gConIdleSeconds("ed_idle_seconds", "Editor: seconds without input before ed_fps_idle applies (default 10)", &gIdleSeconds);
+
+    // ---- clock ----------------------------------------------------------------------------------------------------------------------------------
+
+    std::int64_t Elapsed(const std::int64_t startNs) noexcept
+    {
+      return NowNs() - startNs;
+    }
+
+    // ---- what the system says (sampled a few times a second, not every frame) -------------------------------------------------------------------
+
+    struct Sampled
+    {
+      std::int64_t at = 0;
+      bool foreground = true;
+      double idleSeconds = 0.0;
+    } gSampled;
+
+    constexpr std::int64_t kSampleIntervalNs = 200 * 1000 * 1000;
+
+    void RefreshSampled(const std::int64_t now) noexcept
+    {
+      if (gSampled.at != 0 && now - gSampled.at < kSampleIntervalNs) {
+        return;
+      }
+      gSampled.at = now;
+
+      // The editor owns the foreground window when any of its windows (main window, pop-outs, dialogs) does.
+      HWND const fg = ::GetForegroundWindow();
+      DWORD pid = 0;
+      if (fg != nullptr) {
+        (void)::GetWindowThreadProcessId(fg, &pid);
+      }
+      gSampled.foreground = fg != nullptr && pid == ::GetCurrentProcessId();
+
+      LASTINPUTINFO info{};
+      info.cbSize = sizeof(info);
+      gSampled.idleSeconds = ::GetLastInputInfo(&info) != FALSE ? static_cast<double>(::GetTickCount() - info.dwTime) / 1000.0 : 0.0;
+    }
+
+    // ---- the wait --------------------------------------------------------------------------------------------------------------------------------
+
+    /**
+     * Sleeps without a core: a high resolution waitable timer for all but the last fraction of a millisecond, a short spin for the rest (a plain Sleep wakes up to 15 ms late,
+     * which at 300 frames per second would be a visible stutter). Without high resolution timers (before Windows 10 1803) the timer resolution is raised to 1 ms instead.
+     */
+    class Waiter
+    {
+    public:
+      /** Waits until `untilNs`. With `interruptible` any new window message ends the wait early and true is returned. */
+      bool Wait(const std::int64_t untilNs, const bool interruptible)
+      {
+        Init();
+        const std::int64_t lead = highRes_ ? 600 * 1000 : 1500 * 1000;
+        const std::int64_t coarse = untilNs - lead - NowNs();
+        if (timer_ != nullptr && coarse > 200 * 1000) {
+          LARGE_INTEGER due;
+          due.QuadPart = -(coarse / 100);   // relative, 100 ns units
+          if (::SetWaitableTimer(timer_, &due, 0, nullptr, nullptr, FALSE) != FALSE) {
+            const DWORD result = interruptible ? ::MsgWaitForMultipleObjectsEx(1, &timer_, INFINITE, QS_ALLINPUT, 0) : ::WaitForSingleObject(timer_, INFINITE);
+            if (result != WAIT_OBJECT_0) {
+              (void)::CancelWaitableTimer(timer_);
+              return interruptible && result == WAIT_OBJECT_0 + 1;
+            }
+          }
+        }
+        while (NowNs() < untilNs) {
+          ::YieldProcessor();
+        }
+        return false;
+      }
+
+    private:
+      void Init()
+      {
+        if (inited_) {
+          return;
+        }
+        inited_ = true;
+        HMODULE const kernel = ::GetModuleHandleW(L"kernel32.dll");
+        using CreateExFn = HANDLE(WINAPI*)(LPSECURITY_ATTRIBUTES, LPCWSTR, DWORD, DWORD);
+        const auto createEx = kernel != nullptr ? reinterpret_cast<CreateExFn>(reinterpret_cast<void*>(::GetProcAddress(kernel, "CreateWaitableTimerExW"))) : nullptr;
+        if (createEx != nullptr) {
+          timer_ = createEx(nullptr, nullptr, 0x00000002 /* CREATE_WAITABLE_TIMER_HIGH_RESOLUTION */, 0x1F0003 /* TIMER_ALL_ACCESS */);
+        }
+        highRes_ = timer_ != nullptr;
+        if (timer_ == nullptr) {
+          timer_ = ::CreateWaitableTimerW(nullptr, FALSE, nullptr);
+          if (HMODULE const winmm = ::LoadLibraryW(L"winmm.dll"); winmm != nullptr) {
+            using BeginFn = UINT(WINAPI*)(UINT);
+            if (const auto begin = reinterpret_cast<BeginFn>(reinterpret_cast<void*>(::GetProcAddress(winmm, "timeBeginPeriod"))); begin != nullptr) {
+              (void)begin(1);
+            }
+          }
+        }
+      }
+
+      HANDLE timer_ = nullptr;
+      bool highRes_ = false;
+      bool inited_ = false;
+    } gWaiter;
+
+    Pacer gPacer;
+    int gInterrupts = 0;   // wait interruptions since the last frame: bounded so a stuck message can never keep the frame from running
+    constexpr int kMaxInterrupts = 3;
+    float gLastCap = 0.0f;
+    const char* gLastState = "active";
+
+    // ---- statistics ------------------------------------------------------------------------------------------------------------------------------
+
+    struct Window
+    {
+      std::int64_t startNs = 0;
+      int frames = 0;
+      double mainNs = 0;
+      double waitNs = 0;
+      double idleNs = 0;
+      double presentNs = 0;
+      double renderNs = 0;
+      double intervalNs = 0;
+      double maxIntervalNs = 0;
+      int intervals = 0;
+    };
+    Window gAcc;
+    struct Published
+    {
+      std::int64_t atNs = 0;
+      double fps = 0, frameMs = 0, maxFrameMs = 0, mainMs = 0, dispatchMs = 0, waitMs = 0, idleMs = 0, presentMs = 0, renderMs = 0;
+      long frames = 0;
+    } gLast;
+    double gRunningMaxMs = 0;
+    std::int64_t gLastBeginNs = 0;
+    std::int64_t gMainStartNs = 0;
+    long gTotalFrames = 0;
+
+    void Publish(const std::int64_t now)
+    {
+      const double seconds = static_cast<double>(now - gAcc.startNs) / 1e9;
+      if (gAcc.frames > 0 && seconds > 0.0) {
+        const double n = static_cast<double>(gAcc.frames);
+        const double ms = 1.0 / 1e6;
+        gLast.atNs = now;
+        gLast.frames = gTotalFrames;
+        gLast.fps = n / seconds;
+        gLast.mainMs = gAcc.mainNs / n * ms;
+        gLast.waitMs = gAcc.waitNs / n * ms;
+        gLast.idleMs = gAcc.idleNs / n * ms;
+        gLast.presentMs = gAcc.presentNs / n * ms;
+        gLast.renderMs = gAcc.renderNs / n * ms;
+        gLast.frameMs = gAcc.intervals > 0 ? gAcc.intervalNs / static_cast<double>(gAcc.intervals) * ms : 0.0;
+        gLast.maxFrameMs = gAcc.maxIntervalNs * ms;
+        // everything between two frames that is not the frame's own logic, a wait or the OS wait: message handling, the paint with its Present and the render pass
+        gLast.dispatchMs = std::max(0.0, gLast.frameMs - gLast.mainMs - gLast.waitMs - gLast.idleMs);
+        gRunningMaxMs = std::max(gRunningMaxMs, gLast.maxFrameMs);
+      }
+      gAcc = Window{};
+      gAcc.startNs = now;
+    }
+  } // namespace
+
+  std::int64_t NowNs() noexcept
+  {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+  }
+
+  namespace
+  {
+    /**
+     * `DeviceD3D9::Present` (gpg/gal/backends/d3d9/D3D9Interfaces.cpp) waits for the GPU to reach the frame's start marker (an event query) before it presents the frame. The
+     * original polls with a flush flag as fast as it can: a core at 100 percent for as long as the GPU is behind (a frame, or the vsync wait of the one before it). The library
+     * calls this hook after 100 microseconds of spinning: it sleeps about 0.3 ms on a high resolution timer and the poll goes on. Returning false (switched off with
+     * `ed_present_wait 0`, or no high resolution timer: before Windows 10 1803) keeps the original loop.
+     */
+    bool PresentSleep()
+    {
+      if (!gPresentWait) {
+        return false;
+      }
+      // One high resolution timer per thread (Present is the main thread's, but nothing here assumes it).
+      thread_local HANDLE timer = [] {
+        HMODULE const kernel = ::GetModuleHandleW(L"kernel32.dll");
+        using CreateExFn = HANDLE(WINAPI*)(LPSECURITY_ATTRIBUTES, LPCWSTR, DWORD, DWORD);
+        const auto createEx = kernel != nullptr ? reinterpret_cast<CreateExFn>(reinterpret_cast<void*>(::GetProcAddress(kernel, "CreateWaitableTimerExW"))) : nullptr;
+        return createEx != nullptr ? createEx(nullptr, nullptr, 0x00000002 /* CREATE_WAITABLE_TIMER_HIGH_RESOLUTION */, 0x1F0003 /* TIMER_ALL_ACCESS */) : HANDLE(nullptr);
+      }();
+      if (timer == nullptr) {
+        return false;
+      }
+      LARGE_INTEGER due;
+      due.QuadPart = -3000;   // 0.3 ms, relative, 100 ns units
+      if (::SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE) == FALSE) {
+        return false;
+      }
+      (void)::WaitForSingleObject(timer, 100);   // the 100 ms is a guard, the timer fires after about 0.3 to 1 ms
+      return true;
+    }
+
+    struct PresentSleepInstaller
+    {
+      PresentSleepInstaller() { gpg::gal::gPresentWaitSleep = &PresentSleep; }
+    };
+    const PresentSleepInstaller gPresentSleepInstaller{};
+  } // namespace
+
+  bool ParallelNormalMapEnabled() noexcept
+  {
+    return gParallelNormalMap;
+  }
+
+  bool ThrottleBeforeFrame(void* const mainWindow)
+  {
+    if (!gThrottleOn) {
+      gPacer.Reset();
+      gLastCap = 0.0f;
+      return false;
+    }
+
+    const std::int64_t now = NowNs();
+    RefreshSampled(now);
+
+    Situation s;
+    s.minimized = mainWindow != nullptr && ::IsIconic(static_cast<HWND>(mainWindow)) != FALSE;
+    s.foreground = gSampled.foreground;
+    s.idleSeconds = gSampled.idleSeconds;
+    const EWldFrameAction action = WLD_GetFrameAction();
+    s.loading = action == EWldFrameAction::Preload || action == EWldFrameAction::Loading;
+
+    Caps caps;
+    caps.active = gFpsLimit;
+    caps.loading = gFpsLoading;
+    caps.background = gFpsBackground;
+    caps.idle = gFpsIdle;
+    caps.idleSeconds = gIdleSeconds;
+    const float cap = EffectiveCap(caps, s);
+    gLastCap = cap;
+    gLastState = StateName(s);
+
+    const std::int64_t remaining = gPacer.Remaining(now, cap);
+    if (remaining > 0) {
+      const bool arrived = gWaiter.Wait(now + remaining, gInterrupts < kMaxInterrupts);
+      gAcc.waitNs += static_cast<double>(Elapsed(now));
+      if (arrived) {
+        ++gInterrupts;
+        return true;   // input first; the loop calls again and the remaining time is recomputed
+      }
+    }
+    gInterrupts = 0;
+    gPacer.FrameStarted(NowNs(), cap);
+    return false;
+  }
+
+  void FrameBegin() noexcept
+  {
+    const std::int64_t now = NowNs();
+    if (gAcc.startNs == 0) {
+      gAcc.startNs = now;
+    }
+    if (gLastBeginNs != 0) {
+      const double interval = static_cast<double>(now - gLastBeginNs);
+      gAcc.intervalNs += interval;
+      gAcc.maxIntervalNs = std::max(gAcc.maxIntervalNs, interval);
+      ++gAcc.intervals;
+    }
+    gLastBeginNs = now;
+    gMainStartNs = now;
+    ++gAcc.frames;
+    ++gTotalFrames;
+  }
+
+  void FrameEnd() noexcept
+  {
+    const std::int64_t now = NowNs();
+    gAcc.mainNs += static_cast<double>(now - gMainStartNs);
+    if (now - gAcc.startNs >= 1000 * 1000 * 1000) {
+      Publish(now);
+    }
+  }
+
+  void NoteIdleWait(const std::int64_t startNs) noexcept
+  {
+    gAcc.idleNs += static_cast<double>(Elapsed(startNs));
+  }
+
+  void NotePresent(const std::int64_t startNs) noexcept
+  {
+    gAcc.presentNs += static_cast<double>(Elapsed(startNs));
+  }
+
+  void NoteRender(const std::int64_t startNs) noexcept
+  {
+    gAcc.renderNs += static_cast<double>(Elapsed(startNs));
+  }
+
+  // ---- Lua -------------------------------------------------------------------------------------------------------------------------------------
+
+  namespace
+  {
+    void SetNumber(lua_State* const L, const char* const key, const double value)
+    {
+      lua_pushstring(L, key);
+      lua_pushnumber(L, value);
+      lua_settable(L, -3);
+    }
+
+    void SetString(lua_State* const L, const char* const key, const char* const value)
+    {
+      lua_pushstring(L, key);
+      lua_pushstring(L, value);
+      lua_settable(L, -3);
+    }
+
+    void SetBool(lua_State* const L, const char* const key, const bool value)
+    {
+      lua_pushstring(L, key);
+      lua_pushboolean(L, value ? 1 : 0);
+      lua_settable(L, -3);
+    }
+
+    // ed_perf_loop([reset]) -> { fps, frameMs, maxFrameMs, mainMs, dispatchMs, waitMs, idleMs, presentMs, renderMs, cap, state, vsync, frames }
+    //   Averages per frame over the last full second (zeros while the loop did not run for two seconds: a minimized window). mainMs = the frame's logic (sim sync, UI Lua,
+    //   camera, the invalidate); dispatchMs = message handling + paint (Present + render submit, below); waitMs = what the limiter slept; idleMs = OS wait after the frame;
+    //   presentMs = time inside Present (the vsync wait); renderMs = CPU time recording the frame. maxFrameMs = the longest frame start to frame start since the last reset.
+    //   cap = frames per second cap now (0 = none), state = active | loading | background | minimized.
+    int __cdecl cfunc_EdPerfLoop(lua_State* const L)
+    {
+      if (lua_toboolean(L, 1) != 0) {
+        gRunningMaxMs = 0;
+      }
+      const bool fresh = gLast.atNs != 0 && NowNs() - gLast.atNs < 2LL * 1000 * 1000 * 1000;
+      lua_newtable(L);
+      SetNumber(L, "fps", fresh ? gLast.fps : 0.0);
+      SetNumber(L, "frameMs", fresh ? gLast.frameMs : 0.0);
+      SetNumber(L, "maxFrameMs", gRunningMaxMs);
+      SetNumber(L, "mainMs", fresh ? gLast.mainMs : 0.0);
+      SetNumber(L, "dispatchMs", fresh ? gLast.dispatchMs : 0.0);
+      SetNumber(L, "waitMs", fresh ? gLast.waitMs : 0.0);
+      SetNumber(L, "idleMs", fresh ? gLast.idleMs : 0.0);
+      SetNumber(L, "presentMs", fresh ? gLast.presentMs : 0.0);
+      SetNumber(L, "renderMs", fresh ? gLast.renderMs : 0.0);
+      SetNumber(L, "cap", gLastCap);
+      SetString(L, "state", gLastState);
+      bool vsync = false;
+      if (gpg::gal::Device::IsReady()) {
+        const gpg::gal::DeviceContext* const context = gpg::gal::Device::GetInstance()->GetDeviceContext();
+        vsync = context != nullptr && context->mVSync;
+      }
+      SetBool(L, "vsync", vsync);
+      SetNumber(L, "frames", static_cast<double>(gTotalFrames));
+      return 1;
+    }
+
+    struct ThreadRow
+    {
+      DWORD id = 0;
+      double cpu = 0;
+      double totalMs = 0;
+      std::string name;
+    };
+
+    std::map<DWORD, ULONGLONG> gPrevTimes;   // thread id -> user + kernel time (100 ns) at the last ed_perf_threads
+    std::int64_t gPrevThreadsAtNs = 0;
+
+    std::string ThreadName(HANDLE const thread)
+    {
+      using GetDescFn = HRESULT(WINAPI*)(HANDLE, PWSTR*);
+      static const GetDescFn getDesc = [] {
+        HMODULE const kernel = ::GetModuleHandleW(L"kernel32.dll");
+        return kernel != nullptr ? reinterpret_cast<GetDescFn>(reinterpret_cast<void*>(::GetProcAddress(kernel, "GetThreadDescription"))) : nullptr;
+      }();
+      if (getDesc == nullptr) {
+        return std::string();
+      }
+      PWSTR wide = nullptr;
+      if (FAILED(getDesc(thread, &wide)) || wide == nullptr) {
+        return std::string();
+      }
+      std::string out;
+      const int bytes = ::WideCharToMultiByte(CP_UTF8, 0, wide, -1, nullptr, 0, nullptr, nullptr);
+      if (bytes > 1) {
+        out.resize(static_cast<std::size_t>(bytes));
+        (void)::WideCharToMultiByte(CP_UTF8, 0, wide, -1, out.data(), bytes, nullptr, nullptr);
+        out.resize(static_cast<std::size_t>(bytes) - 1);
+      }
+      (void)::LocalFree(wide);
+      return out;
+    }
+
+    // ed_perf_threads() -> { { id, name, cpu, totalMs, main }, ... } sorted by cpu (at most 32).
+    //   cpu = percent of one core the thread used since the previous call (the first call has no interval and reports 0), totalMs = CPU time since the thread started.
+    //   Names come from SetThreadDescription (the engine names its threads: Sim, Issue, Map loader ...); the editor's field workers have none.
+    int __cdecl cfunc_EdPerfThreads(lua_State* const L)
+    {
+      const std::int64_t now = NowNs();
+      const double wallTicks = gPrevThreadsAtNs != 0 ? static_cast<double>(now - gPrevThreadsAtNs) / 100.0 : 0.0;   // 100 ns units
+      std::vector<ThreadRow> rows;
+      std::map<DWORD, ULONGLONG> times;
+
+      HANDLE const snapshot = ::CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+      if (snapshot != INVALID_HANDLE_VALUE) {
+        THREADENTRY32 entry{};
+        entry.dwSize = sizeof(entry);
+        const DWORD pid = ::GetCurrentProcessId();
+        for (BOOL ok = ::Thread32First(snapshot, &entry); ok != FALSE; ok = ::Thread32Next(snapshot, &entry)) {
+          if (entry.th32OwnerProcessID != pid) {
+            continue;
+          }
+          HANDLE const thread = ::OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, entry.th32ThreadID);
+          if (thread == nullptr) {
+            continue;
+          }
+          FILETIME created{}, exited{}, kernel{}, user{};
+          if (::GetThreadTimes(thread, &created, &exited, &kernel, &user) != FALSE) {
+            ULARGE_INTEGER k{}, u{};
+            k.LowPart = kernel.dwLowDateTime;
+            k.HighPart = kernel.dwHighDateTime;
+            u.LowPart = user.dwLowDateTime;
+            u.HighPart = user.dwHighDateTime;
+            const ULONGLONG total = k.QuadPart + u.QuadPart;
+            ThreadRow row;
+            row.id = entry.th32ThreadID;
+            row.totalMs = static_cast<double>(total) / 10000.0;
+            const auto prev = gPrevTimes.find(row.id);
+            row.cpu = (prev != gPrevTimes.end() && wallTicks > 0.0) ? static_cast<double>(total - prev->second) / wallTicks * 100.0 : 0.0;
+            row.name = ThreadName(thread);
+            times[row.id] = total;
+            rows.push_back(std::move(row));
+          }
+          (void)::CloseHandle(thread);
+        }
+        (void)::CloseHandle(snapshot);
+      }
+      gPrevTimes.swap(times);
+      gPrevThreadsAtNs = now;
+
+      std::sort(rows.begin(), rows.end(), [](const ThreadRow& a, const ThreadRow& b) { return a.cpu > b.cpu || (a.cpu == b.cpu && a.totalMs > b.totalMs); });
+      const DWORD mainId = static_cast<DWORD>(THREAD_GetMainThreadId());
+      lua_newtable(L);
+      int index = 0;
+      for (const ThreadRow& row : rows) {
+        if (index >= 32) {
+          break;
+        }
+        lua_pushnumber(L, static_cast<lua_Number>(++index));
+        lua_newtable(L);
+        SetNumber(L, "id", static_cast<double>(row.id));
+        SetString(L, "name", row.name.c_str());
+        SetNumber(L, "cpu", row.cpu);
+        SetNumber(L, "totalMs", row.totalMs);
+        SetBool(L, "main", row.id == mainId);
+        lua_settable(L, -3);
+      }
+      return 1;
+    }
+
+    [[nodiscard]] CScrLuaInitFormSet& UserLuaInitSet()
+    {
+      if (CScrLuaInitFormSet* const set = SCR_FindLuaInitFormSet("User"); set != nullptr) {
+        return *set;
+      }
+      static CScrLuaInitFormSet fallbackSet("User");
+      return fallbackSet;
+    }
+
+    struct EdPerfLuaBootstrap
+    {
+      EdPerfLuaBootstrap()
+      {
+        auto& set = UserLuaInitSet();
+        (void)new CScrLuaBinder(set, "ed_perf_loop", &cfunc_EdPerfLoop, nullptr, "<global>",
+                                "ed_perf_loop([reset]) -> { fps, frameMs, maxFrameMs, mainMs, dispatchMs, waitMs, idleMs, presentMs, renderMs, cap, state, vsync, frames }");
+        (void)new CScrLuaBinder(set, "ed_perf_threads", &cfunc_EdPerfThreads, nullptr, "<global>",
+                                "ed_perf_threads() -> { { id, name, cpu, totalMs, main }, ... } sorted by cpu (percent of one core since the last call)");
+      }
+    };
+
+    const EdPerfLuaBootstrap gEdPerfLuaBootstrap{};
+  } // namespace
+} // namespace moho::editor::perf
diff --git a/src/sdk/moho/editor/EdPerf.h b/src/sdk/moho/editor/EdPerf.h
new file mode 100644
index 0000000..21dcb0a
--- /dev/null
+++ b/src/sdk/moho/editor/EdPerf.h
@@ -0,0 +1,44 @@
+// EDITOR: main loop frame pacing and CPU statistics of the editor (docs/projects/editor/PERFORMANCE.md, section "Engine CPU"). Policy: EdPerfPolicy.h.
+//
+// All of it runs on the main thread (the loop in WinApp.cpp, CD3DDevice::Paint and the UI Lua natives are the same thread), so the state needs no locks.
+//
+// Console variables (switch any of them off with 0, the limiter as a whole with `ed_fps_throttle 0`):
+//   ed_fps_throttle   1      the limiter at all
+//   ed_fps_limit      300    frames per second while the editor is in use
+//   ed_fps_loading    60     while a map loads
+//   ed_fps_background 60     while another program has the focus
+//   ed_fps_idle       0      after `ed_idle_seconds` without input (power saving; off)
+//   ed_idle_seconds   10
+//   ed_present_wait   1      DeviceD3D9::Present waits for the GPU in short sleeps instead of a spin that keeps a core at 100 percent (EdPerf.cpp, PresentSleep)
+//   ed_par_normalmap  1      big normal map updates (map load, whole map edits) use the worker pool of the field engine (CWldMap.cpp, UpdateNormalMap)
+// Lua natives:
+//   ed_perf_loop([reset])  -> { fps, frameMs, maxFrameMs, mainMs, dispatchMs, waitMs, idleMs, presentMs, renderMs, cap, state, vsync, frames }
+//   ed_perf_threads()      -> { { id, name, cpu, totalMs, main }, ... }  cpu = percent of one core since the last call
+#pragma once
+
+#include <cstdint>
+
+namespace moho::editor::perf
+{
+  /** Nanoseconds of a steady clock. */
+  [[nodiscard]] std::int64_t NowNs() noexcept;
+
+  /**
+   * Called by the main loop right before a frame (`CScApp::Main`). Waits until the frame rate cap allows the frame. Returns true when a window message arrived during the
+   * wait: the caller dispatches it first and calls again, so input is never held back by the limiter. `mainWindow` is the HWND of the editor window (may be null).
+   */
+  [[nodiscard]] bool ThrottleBeforeFrame(void* mainWindow);
+
+  /** Brackets `CScApp::Main` (the frame's logic and the invalidate that causes the paint). */
+  void FrameBegin() noexcept;
+  void FrameEnd() noexcept;
+
+  /** `ed_par_normalmap` (default 1): CWldTerrainRes::UpdateNormalMap splits big updates over the field engine's worker pool. */
+  [[nodiscard]] bool ParallelNormalMapEnabled() noexcept;
+
+  /** Time the loop spent blocked in the OS wait after the frame (nothing to do). */
+  void NoteIdleWait(std::int64_t startNs) noexcept;
+  /** `device->Present()` and the render pass of `CD3DDevice::Paint`. */
+  void NotePresent(std::int64_t startNs) noexcept;
+  void NoteRender(std::int64_t startNs) noexcept;
+} // namespace moho::editor::perf
diff --git a/src/sdk/moho/editor/EdPerfPolicy.h b/src/sdk/moho/editor/EdPerfPolicy.h
new file mode 100644
index 0000000..19fa9e9
--- /dev/null
+++ b/src/sdk/moho/editor/EdPerfPolicy.h
@@ -0,0 +1,132 @@
+// EDITOR: frame pacing policy of the editor's main loop, engine independent so it is tested on its own (moho/editor/tests/EdPerfPolicyTest.cpp).
+//
+// Why a limiter at all (docs/projects/editor/PERFORMANCE.md, section "Engine CPU"): the recovered main loop (WinApp.cpp, `CScApp::Main`) invalidates the window at the end of
+// every iteration (`CD3DDevice::Refresh`), the WM_PAINT it causes presents the previous frame and renders the next one (`CD3DDevice::Paint`), and nothing in the loop sleeps
+// between two frames: the only pacing is the swap chain's vertical sync (`context.mVSync`, PresentationInterval ONE). With vsync off, or while the driver spins inside Present,
+// the main thread draws as fast as it can, a full core and a full GPU for a picture nobody can tell from one drawn 300 times a second.
+//
+// The rules (every number is a console variable, 0 switches a cap off):
+//   * active    `ed_fps_limit`       default 300: far above any monitor, so it never shows; it only stops an unbounded loop.
+//   * loading   `ed_fps_loading`     default 60 : while a map is being loaded the loader thread does the work, the main thread only draws the loading screen.
+//   * background `ed_fps_background` default 60 : the editor window is not the foreground window of the system (the user works in another program).
+//   * idle      `ed_fps_idle`        default 0 (off): no keyboard / mouse input anywhere for `ed_idle_seconds`. A power saving option; off by default because a test run
+//                                    that is only watched, or a camera animation, is "idle" too and must not lose smoothness.
+// The effective cap is the smallest non-zero cap that applies. Input never waits for a frame: the wait is interrupted by any message (see EdPerf.cpp).
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace moho::editor::perf
+{
+  /** The caps in frames per second (0 = no cap of this kind) and the idle delay. */
+  struct Caps
+  {
+    float active = 300.0f;
+    float loading = 60.0f;
+    float background = 60.0f;
+    float idle = 0.0f;
+    float idleSeconds = 10.0f;
+  };
+
+  /** What the main loop knows about the moment. */
+  struct Situation
+  {
+    bool minimized = false;    // a minimized window is not drawn at all: the loop's own wake-up timer paces it
+    bool foreground = true;    // the editor (any of its windows) is the foreground window
+    bool loading = false;      // a map is being loaded (world session preload / load phase)
+    double idleSeconds = 0.0;  // seconds since the last keyboard / mouse input of the whole system
+  };
+
+  /** Lowest cap anyone may ask for: a cap of 1 frame per second would make the editor look frozen. */
+  constexpr float kMinCap = 5.0f;
+
+  /** The frame rate cap that applies now, 0 = none. */
+  [[nodiscard]] inline float EffectiveCap(const Caps& caps, const Situation& s) noexcept
+  {
+    if (s.minimized) {
+      return 0.0f;
+    }
+    float cap = 0.0f;
+    const auto apply = [&cap](const float v) {
+      if (v > 0.0f) {
+        const float clamped = std::max(v, kMinCap);
+        if (cap <= 0.0f || clamped < cap) {
+          cap = clamped;
+        }
+      }
+    };
+    apply(caps.active);
+    if (s.loading) {
+      apply(caps.loading);
+    }
+    if (!s.foreground) {
+      apply(caps.background);
+    }
+    if (caps.idle > 0.0f && s.idleSeconds >= static_cast<double>(caps.idleSeconds)) {
+      apply(caps.idle);
+    }
+    return cap;
+  }
+
+  /** Name of the state that decides the cap, for the statistics. */
+  [[nodiscard]] inline const char* StateName(const Situation& s) noexcept
+  {
+    if (s.minimized) {
+      return "minimized";
+    }
+    if (s.loading) {
+      return "loading";
+    }
+    if (!s.foreground) {
+      return "background";
+    }
+    return "active";
+  }
+
+  /**
+   * Keeps a steady cadence without ever catching up: the start of a frame is scheduled `period` after the start of the one before; a frame that came late by less than a
+   * period keeps the grid (no drift), a later one restarts it (no burst of frames to make up for a stall).
+   * Times are in nanoseconds of any steady clock.
+   */
+  class Pacer
+  {
+  public:
+    static constexpr std::int64_t kNsPerSecond = 1000000000;
+
+    /** Nanoseconds to wait before the next frame may start; 0 = start now. `cap` <= 0 never waits. */
+    [[nodiscard]] std::int64_t Remaining(const std::int64_t now, const float cap) const noexcept
+    {
+      if (cap <= 0.0f || !started_) {
+        return 0;
+      }
+      const std::int64_t target = lastStart_ + Period(cap);
+      return target > now ? target - now : 0;
+    }
+
+    /** A frame starts at `now` (call once per frame, after any wait). */
+    void FrameStarted(const std::int64_t now, const float cap) noexcept
+    {
+      if (cap <= 0.0f || !started_) {
+        lastStart_ = now;
+        started_ = true;
+        return;
+      }
+      const std::int64_t period = Period(cap);
+      const std::int64_t target = lastStart_ + period;
+      // on time or late by less than one period: keep the grid; early (an interrupted wait) or very late: restart it
+      lastStart_ = (now >= target && now - target <= period) ? target : now;
+    }
+
+    void Reset() noexcept { started_ = false; }
+
+    [[nodiscard]] static std::int64_t Period(const float cap) noexcept
+    {
+      return static_cast<std::int64_t>(static_cast<double>(kNsPerSecond) / static_cast<double>(std::max(cap, kMinCap)));
+    }
+
+  private:
+    std::int64_t lastStart_ = 0;
+    bool started_ = false;
+  };
+} // namespace moho::editor::perf
diff --git a/src/sdk/moho/editor/tests/EdNormalMapParTest.cpp b/src/sdk/moho/editor/tests/EdNormalMapParTest.cpp
new file mode 100644
index 0000000..98ac28d
--- /dev/null
+++ b/src/sdk/moho/editor/tests/EdNormalMapParTest.cpp
@@ -0,0 +1,267 @@
+// Stand-alone test of the parallel normal map update (CWldTerrainRes::UpdateNormalMap in moho/sim/CWldMap.cpp, ed_par_normalmap).
+//   links: moho/editor/EdFieldCore.cpp (the worker pool) and moho/render/textures/DXTCodec.cpp (the engine's own DXT block encoders)
+//   g++ -std=c++20 -O2 -I src/sdk src/sdk/moho/editor/tests/EdNormalMapParTest.cpp src/sdk/moho/editor/EdFieldCore.cpp src/sdk/moho/render/textures/DXTCodec.cpp -o EdNormalMapParTest -pthread
+//
+// The engine function needs a CHeightField and a D3D texture; this test carries a MODEL of it (the same loops in the same order, GetElevation / GetNormal / EncodeNormalLaneByte copied
+// from moho/sim/STIMap.cpp and CWldMap.cpp, the encoders linked from the engine) and proves what the change claims: the bytes written by the batched, pool-parallel loop are
+// identical to the serial loop, for any thread count, any rectangle (aligned or not, clipped by the field edge) and any batch size, and rows never write outside their own span.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <chrono>
+#include <cstring>
+#include <random>
+#include <vector>
+
+#include "moho/editor/EdFieldCore.h"
+#include "moho/render/textures/DXTCodec.h"
+
+static int gFailures = 0;
+static int gChecks = 0;
+#define CHECK(cond, ...)                               \
+  do {                                                 \
+    ++gChecks;                                         \
+    if (!(cond)) {                                     \
+      ++gFailures;                                     \
+      std::printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+      std::printf(__VA_ARGS__);                        \
+      std::printf("\n");                               \
+    }                                                  \
+  } while (0)
+
+namespace
+{
+  struct Field
+  {
+    int width = 0;
+    int height = 0;
+    std::vector<std::uint16_t> data;
+
+    static int Clamp(int v, int hi) { return std::max(0, std::min(v, hi)); }
+
+    // CHeightField::GetElevation
+    float GetElevation(const float x, const float z) const
+    {
+      const int fx = static_cast<int>(std::floor(static_cast<double>(x)));
+      const int fz = static_cast<int>(std::floor(static_cast<double>(z)));
+      const float fracX = x - static_cast<float>(fx);
+      const float fracZ = z - static_cast<float>(fz);
+      const int wMax = width - 1;
+      const int hMax = height - 1;
+      const int x0 = Clamp(fx, wMax);
+      const int x1 = Clamp(fx + 1, wMax);
+      const int z0 = Clamp(fz, hMax);
+      const int z1 = Clamp(fz + 1, hMax);
+      const float h00 = static_cast<float>(data[x0 + z0 * width]) * 0.0078125f;
+      const float h01 = static_cast<float>(data[x0 + z1 * width]) * 0.0078125f;
+      const float h10 = static_cast<float>(data[x1 + z0 * width]) * 0.0078125f;
+      const float h11 = static_cast<float>(data[x1 + z1 * width]) * 0.0078125f;
+      const double row0 = static_cast<double>(h00) + (static_cast<double>(h01) - h00) * fracZ;
+      const double row1 = static_cast<double>(h10) + (static_cast<double>(h11) - h10) * fracZ;
+      return static_cast<float>(row0 + (row1 - row0) * fracX);
+    }
+
+    // CHeightField::GetNormal (x and z lanes)
+    void GetNormal(const float x, const float z, float& nx, float& nz) const
+    {
+      const float top = GetElevation(x, z - 0.5f);
+      const float left = GetElevation(x - 0.5f, z);
+      const float right = GetElevation(x + 0.5f, z);
+      const float bottom = GetElevation(x, z + 0.5f);
+      float vx = left - right;
+      float vy = 1.0f;
+      float vz = top - bottom;
+      const float len = std::sqrt(vx * vx + vy * vy + vz * vz);
+      vx /= len;
+      vy /= len;
+      vz /= len;
+      (void)vy;
+      nx = vx;
+      nz = vz;
+    }
+  };
+
+  std::uint8_t EncodeLane(const float lane)
+  {
+    int encoded = static_cast<int>((lane + 1.0f) * 128.0f);
+    encoded = std::max(0, std::min(encoded, 255));
+    return static_cast<std::uint8_t>(encoded);
+  }
+
+  struct Rect
+  {
+    int x0, z0, x1, z1;
+  };
+
+  int AlignDown4(const int v) { return v & ~3; }
+  int AlignUp4(const int v) { return (v + 3) & ~3; }
+
+  // One tile of CWldTerrainRes::UpdateNormalMap. `parallel` selects the new batched path (the engine's `blockCount >= threshold && enabled` test is the caller's).
+  void UpdateTile(const Field& field, const Rect lockRect, const int tileXBase, const int tileZBase, std::uint8_t* const locked, const std::size_t pitch, const bool parallel,
+                  const int batchRows, int* const ticks)
+  {
+    const auto encodeBlockRow = [&](const int localZ, std::uint8_t* const rowBytes) {
+      auto* out = reinterpret_cast<std::uint64_t*>(rowBytes);
+      for (int localX = lockRect.x0; localX < lockRect.x1; localX += 4) {
+        std::uint8_t nx[16];
+        std::uint8_t nz[16];
+        for (int r = 0; r < 4; ++r) {
+          for (int c = 0; c < 4; ++c) {
+            float fx = 0;
+            float fz = 0;
+            field.GetNormal(static_cast<float>(tileXBase + localX + c) + 0.5f, static_cast<float>(tileZBase + localZ + r) + 0.5f, fx, fz);
+            nx[r * 4 + c] = EncodeLane(fx);
+            nz[r * 4 + c] = EncodeLane(fz);
+          }
+        }
+        std::uint64_t a = moho::DXT_EncodeAlphaBlock(nx, 1, 4);
+        std::uint64_t g = moho::DXT_EncodeGreenBlock(nz);
+        std::memcpy(out, &a, 8);
+        std::memcpy(out + 1, &g, 8);
+        out += 2;
+      }
+    };
+
+    const int blockRows = (lockRect.z1 - lockRect.z0 + 3) / 4;
+    if (parallel) {
+      for (int start = 0; start < blockRows; start += batchRows) {
+        const int end = std::min(blockRows, start + batchRows);
+        moho::editor::field::ParallelFor(end - start, [&](const int index) {
+          const int row = start + index;
+          encodeBlockRow(lockRect.z0 + row * 4, locked + static_cast<std::size_t>(row) * pitch);
+        });
+        for (int row = start; row < end; ++row) {
+          ++*ticks;
+        }
+      }
+    } else {
+      std::uint8_t* rowBytes = locked;
+      for (int localZ = lockRect.z0; localZ < lockRect.z1; localZ += 4) {
+        encodeBlockRow(localZ, rowBytes);
+        ++*ticks;
+        rowBytes += pitch;
+      }
+    }
+  }
+
+  // The whole function: tiles, clipping, locking (a fresh zeroed texture per call), for a rectangle `rect` (x1 / z1 exclusive, like the engine).
+  std::vector<std::uint8_t> UpdateMap(const Field& field, const int tileW, const int tileH, const Rect rect, const bool parallel, const int batchRows, int* const ticks)
+  {
+    const int tilesX = (field.width - 1 + tileW - 1) / tileW;
+    const int tilesY = (field.height - 1 + tileH - 1) / tileH;
+    const std::size_t pitch = static_cast<std::size_t>(tileW / 4) * 16;
+    const std::size_t tileBytes = pitch * static_cast<std::size_t>(tileH / 4);
+    std::vector<std::uint8_t> texels(tileBytes * static_cast<std::size_t>(tilesX * tilesY), 0xCD);   // 0xCD: what an untouched byte looks like
+    std::size_t tileIndex = 0;
+    for (int tz = 0; tz < field.height - 1; tz += tileH) {
+      for (int tx = 0; tx < field.width - 1; tx += tileW, ++tileIndex) {
+        const int cx0 = std::max(tx, rect.x0);
+        const int cx1 = std::min(tx + tileW, rect.x1);
+        const int cz0 = std::max(tz, rect.z0);
+        const int cz1 = std::min(tz + tileH, rect.z1);
+        if (cx0 >= cx1 || cz0 >= cz1) {
+          continue;
+        }
+        Rect lock{AlignDown4(cx0 - tx), AlignDown4(cz0 - tz), AlignUp4(cx1 - tx), AlignUp4(cz1 - tz)};
+        // the engine's LockRect hands out the memory of the locked rectangle only: rows start at lock.z0, columns at lock.x0
+        std::uint8_t* tileBase = texels.data() + tileIndex * tileBytes;
+        std::uint8_t* locked = tileBase + static_cast<std::size_t>(lock.z0 / 4) * pitch + static_cast<std::size_t>(lock.x0 / 4) * 16;
+        UpdateTile(field, lock, tx, tz, locked, pitch, parallel, batchRows, ticks);
+      }
+    }
+    return texels;
+  }
+
+  Field MakeField(const int w, const int h, const unsigned seed)
+  {
+    Field f;
+    f.width = w;
+    f.height = h;
+    f.data.resize(static_cast<std::size_t>(w) * h);
+    std::mt19937 rng(seed);
+    for (int z = 0; z < h; ++z) {
+      for (int x = 0; x < w; ++x) {
+        const double smooth = 6000.0 + 2500.0 * std::sin(x * 0.07) * std::cos(z * 0.05);
+        f.data[static_cast<std::size_t>(z) * w + x] = static_cast<std::uint16_t>(smooth + static_cast<double>(rng() % 400));
+      }
+    }
+    return f;
+  }
+} // namespace
+
+int main(const int argc, char** const argv)
+{
+  if (argc > 1 && std::strcmp(argv[1], "--bench") == 0) {
+    // timing of the model on this machine (not a check): a 2049 x 2049 field, whole map
+    const Field field = MakeField(2049, 2049, 1);
+    const Rect rect{0, 0, 2048, 2048};
+    const auto time = [&](const bool parallel) {
+      int ticks = 0;
+      const auto t0 = std::chrono::steady_clock::now();
+      const std::vector<std::uint8_t> out = UpdateMap(field, 2048, 2048, rect, parallel, 64, &ticks);
+      return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count() + 0.0 * static_cast<double>(out.size());
+    };
+    moho::editor::field::SetThreads(1);
+    const double serial = time(false);
+    std::printf("serial %.0f ms\n", serial);
+    for (const int t : {2, 4, 8, 16}) {
+      moho::editor::field::SetThreads(t);
+      std::printf("%d threads %.0f ms\n", t, time(true));
+    }
+    return 0;
+  }
+  const int origThreads = moho::editor::field::Threads();
+  std::mt19937 rng(12345);
+
+  // sizes: one tile, several tiles (tile 64), a field edge that is not a multiple of 4
+  struct Case
+  {
+    int w, h, tile;
+  };
+  const Case cases[] = {{129, 129, 128}, {257, 193, 64}, {200, 131, 64}, {513, 513, 512}};
+  for (const Case& c : cases) {
+    const Field field = MakeField(c.w, c.h, 7u + static_cast<unsigned>(c.w));
+    const int tileW = c.tile;
+    const int tileH = c.tile;
+    for (int round = 0; round < 6; ++round) {
+      Rect rect{0, 0, field.width - 1, field.height - 1};
+      if (round > 0) {
+        rect.x0 = static_cast<int>(rng() % static_cast<unsigned>(field.width - 2));
+        rect.z0 = static_cast<int>(rng() % static_cast<unsigned>(field.height - 2));
+        rect.x1 = std::min(field.width - 1, rect.x0 + 1 + static_cast<int>(rng() % 150u));
+        rect.z1 = std::min(field.height - 1, rect.z0 + 1 + static_cast<int>(rng() % 150u));
+      }
+      int serialTicks = 0;
+      const std::vector<std::uint8_t> serial = UpdateMap(field, tileW, tileH, rect, false, 1, &serialTicks);
+      for (const int threads : {1, 2, 3, 8}) {
+        for (const int batch : {1, 7, 64}) {
+          moho::editor::field::SetThreads(threads);
+          int parTicks = 0;
+          const std::vector<std::uint8_t> par = UpdateMap(field, tileW, tileH, rect, true, batch, &parTicks);
+          CHECK(par == serial, "case %dx%d tile %d round %d threads %d batch %d: bytes differ", c.w, c.h, c.tile, round, threads, batch);
+          CHECK(parTicks == serialTicks, "ticks %d vs %d (one per block row either way)", parTicks, serialTicks);
+        }
+      }
+    }
+  }
+
+  // an untouched byte stays untouched: rows write only inside their rectangle (0xCD marks the texture before the update)
+  {
+    const Field field = MakeField(257, 257, 99);
+    int ticks = 0;
+    moho::editor::field::SetThreads(4);
+    const Rect rect{40, 52, 100, 120};
+    const std::vector<std::uint8_t> par = UpdateMap(field, 256, 256, rect, true, 3, &ticks);
+    std::size_t touched = 0;
+    for (const std::uint8_t b : par) {
+      touched += b != 0xCD ? 1u : 0u;
+    }
+    const std::size_t expected = static_cast<std::size_t>((AlignUp4(100) - AlignDown4(40)) / 4) * 16 * static_cast<std::size_t>((AlignUp4(120) - AlignDown4(52)) / 4);
+    CHECK(touched <= expected && touched > expected / 2, "touched %zu bytes, the blocks of the rectangle hold %zu", touched, expected);
+  }
+
+  moho::editor::field::SetThreads(origThreads);
+  std::printf("EdNormalMapParTest: %d checks, %d failures\n", gChecks, gFailures);
+  return gFailures == 0 ? 0 : 1;
+}
diff --git a/src/sdk/moho/editor/tests/EdPerfPolicyTest.cpp b/src/sdk/moho/editor/tests/EdPerfPolicyTest.cpp
new file mode 100644
index 0000000..e0026b1
--- /dev/null
+++ b/src/sdk/moho/editor/tests/EdPerfPolicyTest.cpp
@@ -0,0 +1,183 @@
+// Stand-alone test of the frame pacing policy of the editor's main loop (EdPerfPolicy.h; no engine needed).
+//   g++ -std=c++20 -O2 -I src/sdk src/sdk/moho/editor/tests/EdPerfPolicyTest.cpp -o EdPerfPolicyTest
+//   MSVC: cl /std:c++20 /EHsc /O2 /I src/sdk EdPerfPolicyTest.cpp
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+#include "moho/editor/EdPerfPolicy.h"
+
+using namespace moho::editor::perf;
+
+static int gFailures = 0;
+static int gChecks = 0;
+#define CHECK(cond, ...)                               \
+  do {                                                 \
+    ++gChecks;                                         \
+    if (!(cond)) {                                     \
+      ++gFailures;                                     \
+      std::printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+      std::printf(__VA_ARGS__);                        \
+      std::printf("\n");                               \
+    }                                                  \
+  } while (0)
+
+static constexpr std::int64_t kMs = 1000000;
+
+static void TestCaps()
+{
+  Caps caps;     // defaults: active 300, loading 60, background 60, idle off
+  Situation s;
+
+  CHECK(EffectiveCap(caps, s) == 300.0f, "active default cap is 300, got %f", EffectiveCap(caps, s));
+
+  s.loading = true;
+  CHECK(EffectiveCap(caps, s) == 60.0f, "loading caps to 60");
+  s.loading = false;
+
+  s.foreground = false;
+  CHECK(EffectiveCap(caps, s) == 60.0f, "background caps to 60");
+  s.foreground = true;
+
+  // idle is off by default, however long the user is away
+  s.idleSeconds = 3600.0;
+  CHECK(EffectiveCap(caps, s) == 300.0f, "idle cap is off by default");
+
+  caps.idle = 30.0f;
+  s.idleSeconds = 9.9;
+  CHECK(EffectiveCap(caps, s) == 300.0f, "not idle long enough");
+  s.idleSeconds = 10.0;
+  CHECK(EffectiveCap(caps, s) == 30.0f, "idle cap applies after the delay");
+
+  // the smallest cap wins, in any combination
+  s.foreground = false;
+  s.loading = true;
+  CHECK(EffectiveCap(caps, s) == 30.0f, "smallest of idle 30 / background 60 / loading 60");
+  caps.idle = 120.0f;
+  CHECK(EffectiveCap(caps, s) == 60.0f, "smallest of idle 120 / background 60 / loading 60");
+
+  // 0 switches a cap off
+  caps = Caps{};
+  caps.active = 0.0f;
+  s = Situation{};
+  CHECK(EffectiveCap(caps, s) == 0.0f, "active cap off: uncapped while active");
+  s.foreground = false;
+  CHECK(EffectiveCap(caps, s) == 60.0f, "the background cap still applies when the active cap is off");
+  caps.background = 0.0f;
+  CHECK(EffectiveCap(caps, s) == 0.0f, "every cap off: uncapped");
+
+  // minimized: never capped here (the loop's wake-up timer paces it)
+  caps = Caps{};
+  s = Situation{};
+  s.minimized = true;
+  s.foreground = false;
+  s.loading = true;
+  CHECK(EffectiveCap(caps, s) == 0.0f, "minimized has no cap");
+
+  // a silly cap is raised to the minimum, never a frozen editor
+  caps = Caps{};
+  caps.active = 1.0f;
+  s = Situation{};
+  CHECK(EffectiveCap(caps, s) == kMinCap, "cap below the minimum is raised to %f", kMinCap);
+}
+
+static void TestStateName()
+{
+  Situation s;
+  CHECK(std::string(StateName(s)) == "active", "active");
+  s.foreground = false;
+  CHECK(std::string(StateName(s)) == "background", "background");
+  s.loading = true;
+  CHECK(std::string(StateName(s)) == "loading", "loading wins over background");
+  s.minimized = true;
+  CHECK(std::string(StateName(s)) == "minimized", "minimized wins");
+}
+
+// A model of the loop: each frame takes `work` of CPU, then waits for the pacer.
+static std::vector<std::int64_t> Simulate(const float cap, const std::int64_t work, const int frames, const std::int64_t stallAt = -1, const std::int64_t stall = 0)
+{
+  Pacer pacer;
+  std::int64_t now = 1000 * kMs;
+  std::vector<std::int64_t> starts;
+  for (int i = 0; i < frames; ++i) {
+    now += pacer.Remaining(now, cap);          // the wait
+    pacer.FrameStarted(now, cap);
+    starts.push_back(now);
+    now += work + (i == stallAt ? stall : 0);   // the frame
+  }
+  return starts;
+}
+
+static void TestPacer()
+{
+  // a fast frame (1 ms) at a 100 fps cap: one frame every 10 ms exactly, no drift over 1000 frames
+  {
+    const auto s = Simulate(100.0f, 1 * kMs, 1000);
+    for (std::size_t i = 1; i < s.size(); ++i) {
+      CHECK(s[i] - s[i - 1] == 10 * kMs, "frame %zu: interval %lld ns", i, static_cast<long long>(s[i] - s[i - 1]));
+    }
+    CHECK(s.back() - s.front() == 999 * 10 * kMs, "no drift");
+  }
+  // a frame slower than the period is never delayed (the limiter adds no latency to a frame that already takes long)
+  {
+    const auto s = Simulate(100.0f, 25 * kMs, 50);
+    for (std::size_t i = 1; i < s.size(); ++i) {
+      CHECK(s[i] - s[i - 1] == 25 * kMs, "slow frame %zu: interval %lld ns", i, static_cast<long long>(s[i] - s[i - 1]));
+    }
+  }
+  // a stall (a 500 ms hitch) is not made up for with a burst of frames
+  {
+    const auto s = Simulate(100.0f, 1 * kMs, 40, 10, 500 * kMs);
+    int burst = 0;
+    for (std::size_t i = 12; i < s.size(); ++i) {
+      if (s[i] - s[i - 1] < 10 * kMs) {
+        ++burst;
+      }
+    }
+    CHECK(burst == 0, "no catch-up burst after a stall, %d short intervals", burst);
+    CHECK(s[12] - s[11] == 10 * kMs, "cadence resumes at once after the stall");
+  }
+  // cap 0 never waits
+  {
+    Pacer p;
+    p.FrameStarted(5 * kMs, 0.0f);
+    CHECK(p.Remaining(5 * kMs, 0.0f) == 0, "cap 0: no wait");
+  }
+  // the first frame never waits, whatever the cap
+  {
+    Pacer p;
+    CHECK(p.Remaining(123, 30.0f) == 0, "first frame: no wait");
+  }
+  // an interrupted wait (input arrived) starts a frame early; the grid restarts from there, it does not stack waits
+  {
+    Pacer p;
+    p.FrameStarted(0, 60.0f);
+    const std::int64_t early = 4 * kMs;
+    CHECK(p.Remaining(early, 60.0f) > 0, "still waiting after 4 ms");
+    p.FrameStarted(early, 60.0f);   // ran early
+    CHECK(p.Remaining(early, 60.0f) == Pacer::Period(60.0f), "next frame one period after the early one");
+  }
+  // switching the cap on the fly (focus lost): the new period applies to the next frame
+  {
+    Pacer p;
+    p.FrameStarted(0, 300.0f);
+    p.FrameStarted(Pacer::Period(300.0f), 300.0f);
+    const std::int64_t t = Pacer::Period(300.0f);
+    CHECK(p.Remaining(t + kMs, 60.0f) == Pacer::Period(60.0f) - kMs, "new period from the last start");
+  }
+  // period arithmetic
+  CHECK(Pacer::Period(100.0f) == 10 * kMs, "period of 100 fps");
+  CHECK(Pacer::Period(60.0f) == 16666666, "period of 60 fps, %lld", static_cast<long long>(Pacer::Period(60.0f)));
+  CHECK(Pacer::Period(1.0f) == Pacer::Period(kMinCap), "period is clamped to the minimum cap");
+}
+
+int main()
+{
+  TestCaps();
+  TestStateName();
+  TestPacer();
+  std::printf("EdPerfPolicyTest: %d checks, %d failures\n", gChecks, gFailures);
+  return gFailures == 0 ? 0 : 1;
+}
