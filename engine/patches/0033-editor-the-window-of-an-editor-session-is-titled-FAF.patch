From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marlo <playsxenon51@gmail.com>
Date: Mon, 19 Oct 2026 19:44:45 +0200
Subject: [PATCH] editor: the window of an editor session is titled FAF Studio
 from the start (CScApp::CreateDevice), EdWindow finds it by either title

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/src/sdk/moho/app/CScApp.cpp b/src/sdk/moho/app/CScApp.cpp
index 1a351d5..ae9bcd5 100644
--- a/src/sdk/moho/app/CScApp.cpp
+++ b/src/sdk/moho/app/CScApp.cpp
@@ -1166,7 +1166,8 @@ bool CScApp::CreateDevice()
   moho::sDeviceLock = true;
   DeviceLockGuard lockGuard{};
 
-  msvc8::string title("Forged Alliance");
+  // editor: an editor session names its window from the start (the loading screen shows it); ed_app_set_title changes it later
+  msvc8::string title(moho::CFG_GetArgOption("/editor", 0, nullptr) ? "FAF Studio" : "Forged Alliance");
   msvc8::vector<msvc8::string> options;
   moho::IUserPrefs* const preferences = moho::USER_GetPreferences();
 
diff --git a/src/sdk/moho/editor/EdWindow.cpp b/src/sdk/moho/editor/EdWindow.cpp
index 4c5b566..875809f 100644
--- a/src/sdk/moho/editor/EdWindow.cpp
+++ b/src/sdk/moho/editor/EdWindow.cpp
@@ -55,7 +55,7 @@ namespace
     }
     wchar_t title[256] = {};
     ::GetWindowTextW(h, title, 255);
-    const bool engineTitle = (std::wstring(title) == L"Forged Alliance");
+    const bool engineTitle = (std::wstring(title) == L"Forged Alliance") || (std::wstring(title) == L"FAF Studio");
     if (st->best == nullptr || (engineTitle && !st->bestIsEngineTitle)) {
       st->best = h;
       st->bestIsEngineTitle = engineTitle;
