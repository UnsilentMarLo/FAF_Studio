From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 11:46:01 +0000
Subject: [PATCH] editor GPU compute: per-op minimum field size (RegisterGpuOp
 minCells, GpuOpMinCells): iterated ops like erosion pay off on small fields

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01F37er45a7etRuMgEW1q3kY

diff --git a/src/sdk/moho/editor/EdGpuOps.cpp b/src/sdk/moho/editor/EdGpuOps.cpp
index 2e39706..d29103a 100644
--- a/src/sdk/moho/editor/EdGpuOps.cpp
+++ b/src/sdk/moho/editor/EdGpuOps.cpp
@@ -45,6 +45,11 @@ namespace moho::editor::gpu
       static std::map<std::string, GpuOpFn> ops;
       return ops;
     }
+    std::map<std::string, float>& OpMinCells()
+    {
+      static std::map<std::string, float> cells;
+      return cells;
+    }
     std::atomic<bool> gSelfTestPassed{false};
     std::atomic<BeforeUseFn> gHook{nullptr};
     std::atomic<bool> gHookDone{false};
@@ -63,10 +68,18 @@ namespace moho::editor::gpu
     return policy;
   }
 
-  void RegisterGpuOp(const char* const name, const GpuOpFn fn)
+  void RegisterGpuOp(const char* const name, const GpuOpFn fn, const float minCells)
   {
     const std::lock_guard<std::mutex> lock(gRegistryMutex);
     Ops()[name] = fn;
+    OpMinCells()[name] = minCells;
+  }
+
+  float GpuOpMinCells(const std::string& name)
+  {
+    const std::lock_guard<std::mutex> lock(gRegistryMutex);
+    const auto it = OpMinCells().find(name);
+    return it != OpMinCells().end() ? it->second : -1.0f;
   }
 
   std::vector<std::string> GpuOpNames()
@@ -119,6 +132,7 @@ namespace moho::editor::gpu
   {
     try {
       GpuOpFn fn = nullptr;
+      float opMin = -1.0f;
       {
         const std::lock_guard<std::mutex> lock(gRegistryMutex);
         const auto it = Ops().find(name);
@@ -126,9 +140,14 @@ namespace moho::editor::gpu
           return false;
         }
         fn = it->second;
+        const auto m = OpMinCells().find(name);
+        if (m != OpMinCells().end()) {
+          opMin = m->second;
+        }
       }
       const Policy& policy = GetPolicy();
-      if (!policy.enabled || CellsOf(args) < static_cast<double>(policy.minCells)) {
+      const float minCells = opMin >= 0.0f ? std::min(opMin, policy.minCells) : policy.minCells;
+      if (!policy.enabled || CellsOf(args) < static_cast<double>(minCells)) {
         return false;
       }
       Backend& backend = CurrentBackend();
diff --git a/src/sdk/moho/editor/EdGpuOps.h b/src/sdk/moho/editor/EdGpuOps.h
index d832ca5..0bdfbb7 100644
--- a/src/sdk/moho/editor/EdGpuOps.h
+++ b/src/sdk/moho/editor/EdGpuOps.h
@@ -34,8 +34,11 @@ namespace moho::editor::gpu
   };
   [[nodiscard]] Policy& GetPolicy();
 
-  /** Registers the GPU version of the CPU op `name` (once per name; a second call replaces the first). Static initialisers of op files call this. */
-  void RegisterGpuOp(const char* name, GpuOpFn fn);
+  /** Registers the GPU version of the CPU op `name` (once per name; a second call replaces the first). Static initialisers of op files call this.
+   *  `minCells` >= 0: this op's own threshold (iterated ops like erosion pay off on small fields); the op runs from min(minCells, policy.minCells) samples on. Negative = the policy's. */
+  void RegisterGpuOp(const char* name, GpuOpFn fn, float minCells = -1.0f);
+  /** The op's own threshold (negative = none). */
+  [[nodiscard]] float GpuOpMinCells(const std::string& name);
   [[nodiscard]] std::vector<std::string> GpuOpNames();
 
   /** Samples the op will produce, from its inputs (`a`, else `like`, else width * height). */
