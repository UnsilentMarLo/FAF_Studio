+    float ly;
+    float lz;
+    float dirx;       // azimuth direction on the ground (aspect: the facing direction)
+    float dirz;
+    float tanAlt;
+    float len;        // shadow length in samples
+    float flatK;      // aspect: slope below which the facing fades
+    float d2;         // curvature: (n * cell)^2
