 } // namespace moho::editor::gpu::hk
 
 namespace moho::editor::gpu
@@ -288,6 +290,134 @@ namespace moho::editor::gpu
       return Finish(ex, j, out, err);
     }
 
+    // ---- slope, curvature, aspect, hillshade, normal_map (cheap stencils) -----------------------------------------------------------------------------
+
+    /** Ops of a few operations per sample: the transfer of input and result costs more than the maths on a small field. Fields below 16 x ed_gpu_min_cells (default 1048576, 1024 x 1024) stay on the CPU. */
+    bool BigEnough(const OpArgs& a) { return CellsOf(a) >= static_cast<double>(GetPolicy().minCells) * 16.0; }
+
+    OpResult RunTerrain(Executor& ex, Job& j, hk::TerrainParams p, const double units, Grid& out, std::string& err)
+    {
+      const KernelInfo* k = FindKernel("filt_terrain");
+      if (k == nullptr) { err = "kernel filt_terrain is missing"; return OpResult::Failed; }
+      if (!Upload(ex, j, err)) return OpResult::Failed;
+      p.w = static_cast<std::uint32_t>(j.src->w);
+      p.h = static_cast<std::uint32_t>(j.src->h);
+      p.cell = j.src->cell;
+      Bindings b;
+      b.Srv(1, j.in.R()).Uav(0, j.res.R());
+      if (!DispatchBands(ex, *k, p.w, p.h, units, p, b, err)) return OpResult::Failed;
+      return Finish(ex, j, out, err);
+    }
+
+    OpResult OpSlopeGpu(Executor& ex, const OpArgs& a, Grid& out, std::string& err)
+    {
+      Job j;
+      if (!BigEnough(a) || !Begin(ex, a, 2, j)) return OpResult::Unsupported;
+      const std::string mode = a.p.S("mode", "degrees");
+      if (mode != "degrees" && mode != "gradient") return OpResult::Unsupported;   // rating / variation (window maximum) stay on the CPU
+      hk::TerrainParams p{};
+      p.op = 0;
+      p.n = static_cast<std::uint32_t>(std::max(1, std::min(16, static_cast<int>(a.p.N("radius", 1)))));
+      p.mode = mode == "degrees" ? 0u : 1u;
+      p.degK = 180.0f / kPi;
+      return RunTerrain(ex, j, p, 0.05, out, err);
+    }
+
+    OpResult OpCurvatureGpu(Executor& ex, const OpArgs& a, Grid& out, std::string& err)
+    {
+      Job j;
+      if (!BigEnough(a) || !Begin(ex, a, 2, j)) return OpResult::Unsupported;
+      const int n = std::max(1, std::min(32, static_cast<int>(a.p.N("radius", 1))));
+      hk::TerrainParams p{};
+      p.op = 1;
+      p.n = static_cast<std::uint32_t>(n);
+      p.gain = static_cast<float>(a.p.N("gain", 10.0));
+      p.mode = a.p.N("raw", 0) != 0 ? 1u : 0u;
+      p.d2 = static_cast<float>(n) * static_cast<float>(n) * j.src->cell * j.src->cell;
+      return RunTerrain(ex, j, p, 0.05, out, err);
+    }
+
+    OpResult OpAspectGpu(Executor& ex, const OpArgs& a, Grid& out, std::string& err)
+    {
+      Job j;
+      if (!BigEnough(a) || !Begin(ex, a, 2, j)) return OpResult::Unsupported;
+      const std::string mode = a.p.S("mode", "facing");
+      if (mode != "facing" && mode != "degrees") return OpResult::Unsupported;
+      const double ang = a.p.N("azimuth", 0.0) * 3.14159265358979 / 180.0;
+      hk::TerrainParams p{};
+      p.op = 2;
+      p.n = static_cast<std::uint32_t>(std::max(1, std::min(16, static_cast<int>(a.p.N("radius", 1)))));
+      p.mode = mode == "degrees" ? 1u : 0u;
+      p.dirx = static_cast<float>(std::cos(ang));
+      p.dirz = static_cast<float>(std::sin(ang));
+      p.flatK = std::max(1e-6f, static_cast<float>(a.p.N("flat", 0.05)));
+      p.degK = 180.0f / kPi;
+      return RunTerrain(ex, j, p, 0.06, out, err);
+    }
+
+    OpResult OpHillshadeGpu(Executor& ex, const OpArgs& a, Grid& out, std::string& err)
+    {
+      Job j;
+      if (!BigEnough(a) || !Begin(ex, a, 2, j)) return OpResult::Unsupported;
+      const std::string mode = a.p.S("mode", "shade");
+      if (mode != "shade" && mode != "lit" && mode != "shadow") return OpResult::Unsupported;
+      const int m = mode == "shade" ? 0 : (mode == "lit" ? 1 : 2);
+      const double kPiD = 3.14159265358979323846;
+      const double az = a.p.N("azimuth", 315.0) * kPiD / 180.0;
+      const double alt = std::max(1.0, std::min(89.0, a.p.N("altitude", 40.0))) * kPiD / 180.0;
+      hk::TerrainParams p{};
+      p.op = 3;
+      p.mode = static_cast<std::uint32_t>(m);
+      p.zf = static_cast<float>(a.p.N("z", 1.0));
+      p.ambient = std::max(0.0f, std::min(1.0f, static_cast<float>(a.p.N("ambient", 0.15))));
+      p.shadows = (m != 0 || a.p.N("shadows", 0) != 0) ? 1u : 0u;
+      const float cell = j.src->cell;
+      p.len = std::max(cell, static_cast<float>(a.p.N("shadow_len", 150.0))) / cell;
+      p.lx = static_cast<float>(std::cos(alt) * std::cos(az));
+      p.ly = static_cast<float>(std::sin(alt));
+      p.lz = static_cast<float>(std::cos(alt) * std::sin(az));
+      p.dirx = static_cast<float>(std::cos(az));
+      p.dirz = static_cast<float>(std::sin(az));
+      p.tanAlt = static_cast<float>(std::tan(alt));
+      return RunTerrain(ex, j, p, p.shadows != 0 ? 0.6 : 0.08, out, err);
+    }
+
+    OpResult OpNormalMapGpu(Executor& ex, const OpArgs& a, Grid& out, std::string& err)
+    {
+      Job j;
+      if (!BigEnough(a) || !Begin(ex, a, 4, j)) return OpResult::Unsupported;
+      const Grid& src = *j.src;
+      const float span = std::max(0.05f, static_cast<float>(a.p.N("span", 1.0)));
+      const float strength = static_cast<float>(a.p.N("strength", 1.0));
+      const float shiftUnits = static_cast<float>(a.p.N("shift", 0.0));
+      hk::NormalParams p{};
+      p.w = static_cast<std::uint32_t>(src.w);
+      p.h = static_cast<std::uint32_t>(src.h);
+      p.raw = a.p.N("signed", 0.0) != 0.0 ? 1u : 0u;
+      p.shift = shiftUnits / src.cell;
+      p.taps = 0.5f * span / src.cell;
+      p.scale = strength / span;
+      p.cell = src.cell;
+      const KernelInfo* k = FindKernel("filt_normal");
+      if (k == nullptr) { err = "kernel filt_normal is missing"; return OpResult::Failed; }
+      Field fy, fz;
+      if (!Upload(ex, j, err) || !MakeField(ex, src.w, src.h, fy, err) || !MakeField(ex, src.w, src.h, fz, err)) return OpResult::Failed;
+      Bindings b;
+      b.Srv(1, j.in.R()).Uav(0, j.res.R()).Uav(1, fy.R()).Uav(2, fz.R());
+      if (!DispatchBands(ex, *k, p.w, p.h, 0.25, p, b, err)) return OpResult::Failed;
+      Grid gx = NewGrid(j.shape);
+      gx.ox = src.ox + shiftUnits;                   // the result lies where it was computed (as on the CPU)
+      gx.oz = src.oz + shiftUnits;
+      Grid gy(gx.w, gx.h, gx.cell, gx.ox, gx.oz), gz = gy;
+      if (!DownloadGrid(ex, j.res, gx, err) || (a.extra != nullptr && (!DownloadGrid(ex, fy, gy, err) || !DownloadGrid(ex, fz, gz, err)))) return OpResult::Failed;
+      if (a.extra != nullptr) {
+        (*a.extra)["y"] = std::move(gy);
+        (*a.extra)["z"] = std::move(gz);
+      }
+      out = std::move(gx);
+      return OpResult::Done;
+    }
+
     struct Registrar
     {
       Registrar()
@@ -297,6 +427,11 @@ namespace moho::editor::gpu
         RegisterGpuOp("diffuse", &OpDiffuseGpu);
         RegisterGpuOp("blur_dir", &OpBlurDirGpu);
         RegisterGpuOp("dwarp", &OpDWarpGpu);
+        RegisterGpuOp("slope", &OpSlopeGpu);
+        RegisterGpuOp("curvature", &OpCurvatureGpu);
+        RegisterGpuOp("aspect", &OpAspectGpu);
+        RegisterGpuOp("hillshade", &OpHillshadeGpu);
+        RegisterGpuOp("normal_map", &OpNormalMapGpu);
       }
     };
     const Registrar gRegistrar;
diff --git a/src/sdk/moho/editor/gpu/filt_normal.hlsl b/src/sdk/moho/editor/gpu/filt_normal.hlsl
new file mode 100644
index 0000000..9962743
--- /dev/null
+++ b/src/sdk/moho/editor/gpu/filt_normal.hlsl
@@ -0,0 +1,34 @@
+// Op normal_map (EdFieldFilt.cpp OpNormalMap): the engine's map normal (left - right, 1, top - bottom) normalised, as three fields: x -> u0 (the op's result), y -> u1, z -> u2.
+#include "filt_common.hlsli"
+#include "filt_normal_params.hlsli"
+
+CBUFFER(NormalParams, P, 0)
+SRV_BUFFER(float, src, 1)
+UAV_BUFFER(float, dstX, 0)
+UAV_BUFFER(float, dstY, 1)
+UAV_BUFFER(float, dstZ, 2)
+
+DEFINE_BILINEAR_C(src)
+
+NUMTHREADS(16, 16, 1)
+void CSMain(KERNEL_IDS)
+{
+    if (dtid.x >= P.w || dtid.y >= P.rows) return;
+    uint row = dtid.y + P.z0;
+    float fx = float(dtid.x) + P.shift;
+    float fz = float(row) + P.shift;
+    float left = BilinearC(fx - P.taps, fz);
+    float right = BilinearC(fx + P.taps, fz);
+    float top = BilinearC(fx, fz - P.taps);
+    float bottom = BilinearC(fx, fz + P.taps);
+    float nx = (left - right) * P.scale;
+    float nz = (top - bottom) * P.scale;
+    float inv = 1.0f / sqrt(nx * nx + 1.0f + nz * nz);
+    float ex = nx * inv;
+    float ey = inv;
+    float ez = nz * inv;
+    uint idx = row * P.w + dtid.x;
+    dstX[idx] = P.raw != 0u ? ex : ex * 0.5f + 0.5f;
+    dstY[idx] = P.raw != 0u ? ey : ey * 0.5f + 0.5f;
+    dstZ[idx] = P.raw != 0u ? ez : ez * 0.5f + 0.5f;
+}
diff --git a/src/sdk/moho/editor/gpu/filt_normal_params.hlsli b/src/sdk/moho/editor/gpu/filt_normal_params.hlsli
new file mode 100644
index 0000000..6643478
--- /dev/null
+++ b/src/sdk/moho/editor/gpu/filt_normal_params.hlsli
@@ -0,0 +1,21 @@
+// Constant buffer of filt_normal.hlsl (op normal_map).
+#ifndef GPU_FILT_NORMAL_PARAMS_HLSLI
+#define GPU_FILT_NORMAL_PARAMS_HLSLI
+
+struct NormalParams
+{
+    uint w;
+    uint h;
+    uint z0;
+    uint rows;
+    uint raw;        // 1 = -1..1 instead of 0..1
+    uint pad0;
+    uint pad1;
+    uint pad2;
+    float taps;      // samples either side of the point (span / 2 / cell)
+    float scale;     // slope from a difference over the span: strength / span
+    float shift;     // samples added to the position
+    float cell;
+};
+
+#endif
diff --git a/src/sdk/moho/editor/gpu/filt_terrain.hlsl b/src/sdk/moho/editor/gpu/filt_terrain.hlsl
new file mode 100644
index 0000000..6a5e3df
--- /dev/null
+++ b/src/sdk/moho/editor/gpu/filt_terrain.hlsl
@@ -0,0 +1,113 @@
+// Ops slope (modes degrees and gradient), curvature, aspect and hillshade (EdFieldCore.cpp OpSlope / OpCurvature / OpAspect, EdFieldFilt.cpp OpHillshade): stencils over the height field, a few
+// operations per sample. The arithmetic is the CPU's, in the same order. They only pay off on big fields (the host op sends small ones to the CPU): see EdGpuGenFilt.cpp.
+#include "filt_common.hlsli"
+#include "filt_terrain_params.hlsli"
+
+CBUFFER(TerrainParams, P, 0)
+SRV_BUFFER(float, src, 1)
+UAV_BUFFER(float, dst, 0)
+
+DEFINE_BILINEAR_C(src)
+DEFINE_GRADIENT_AT(src)
+
+// Central difference over +-n samples with clamped edges (the slope and aspect ops).
+FN void GradientN(int x, int z, OUT(float) gx, OUT(float) gz)
+{
+    int n = int(P.n);
+    int x0 = max(0, x - n);
+    int x1 = min(int(P.w) - 1, x + n);
+    int z0 = max(0, z - n);
+    int z1 = min(int(P.h) - 1, z + n);
+    gx = 0.0f;
+    gz = 0.0f;
+    if (x1 > x0) gx = (src[uint(z) * P.w + uint(x1)] - src[uint(z) * P.w + uint(x0)]) / (float(x1 - x0) * P.cell);
+    if (z1 > z0) gz = (src[uint(z1) * P.w + uint(x)] - src[uint(z0) * P.w + uint(x)]) / (float(z1 - z0) * P.cell);
+}
+
+NUMTHREADS(16, 16, 1)
+void CSMain(KERNEL_IDS)
+{
+    if (dtid.x >= P.w || dtid.y >= P.rows) return;
+    int x = int(dtid.x);
+    int z = int(dtid.y + P.z0);
+    uint idx = uint(z) * P.w + uint(x);
+    float r = 0.0f;
+    if (P.op == 0u)
+    {
+        float gx = 0.0f;
+        float gz = 0.0f;
+        GradientN(x, z, gx, gz);
+        float g = sqrt(gx * gx + gz * gz);
+        r = P.mode == 0u ? atan(g) * P.degK : g;
+    }
+    else if (P.op == 1u)
+    {
+        int n = int(P.n);
+        float c = src[idx];
+        float lap = (src[uint(z) * P.w + uint(max(0, x - n))] + src[uint(z) * P.w + uint(min(int(P.w) - 1, x + n))] + src[uint(max(0, z - n)) * P.w + uint(x)] +
+                     src[uint(min(int(P.h) - 1, z + n)) * P.w + uint(x)] - 4.0f * c) / P.d2;
+        r = P.mode == 1u ? -lap : saturate(0.5f - P.gain * lap);
+    }
+    else if (P.op == 2u)
+    {
+        float gx = 0.0f;
+        float gz = 0.0f;
+        GradientN(x, z, gx, gz);
+        float g = sqrt(gx * gx + gz * gz);
+        if (P.mode == 1u)
+        {
+            r = 0.0f;
+            if (g > 0.000000001f)
+            {
+                r = atan2(-gz, -gx) * P.degK;
+                if (r < 0.0f) r += 360.0f;
+            }
+        }
+        else
+        {
+            r = 0.5f;
+            if (g > 0.000000001f)
+            {
+                float c = (-gx * P.dirx - gz * P.dirz) / g;
+                r = 0.5f + 0.5f * c * min(1.0f, g / P.flatK);
+            }
+        }
+    }
+    else
+    {
+        float gx = 0.0f;
+        float gz = 0.0f;
+        GradientAt(x, z, gx, gz);
+        gx *= P.zf;
+        gz *= P.zf;
+        float inv = 1.0f / sqrt(gx * gx + gz * gz + 1.0f);
+        float ndl = (-gx * P.lx + P.ly - gz * P.lz) * inv;
+        float lit = ndl > 0.0f ? 1.0f : 0.0f;
+        if (P.shadows != 0u)
+        {
+            float h0 = src[idx];
+            float t = 1.0f;
+            float shade = 1.0f;
+            LOOP while (t < P.len)
+            {
+                float hs = BilinearC(float(x) + P.dirx * t, float(z) + P.dirz * t);
+                float ray = h0 + t * P.cell * P.tanAlt;
+                if (hs > ray + 0.01f)
+                {
+                    shade = 0.0f;
+                    break;
+                }
+                t += 1.0f + t * 0.12f;
+            }
+            lit *= shade;
+            if (P.mode == 2u) r = 1.0f - shade;
+            else if (P.mode == 1u) r = lit * SmoothStep(0.0f, 0.25f, ndl);
+            else r = saturate(P.ambient + (1.0f - P.ambient) * max(0.0f, ndl) * shade);
+        }
+        else
+        {
+            r = saturate(P.ambient + (1.0f - P.ambient) * max(0.0f, ndl));
+        }
+    }
+    dst[idx] = r;
+}
diff --git a/src/sdk/moho/editor/gpu/filt_terrain_params.hlsli b/src/sdk/moho/editor/gpu/filt_terrain_params.hlsli
new file mode 100644
index 0000000..f76cdc1
--- /dev/null
+++ b/src/sdk/moho/editor/gpu/filt_terrain_params.hlsli
@@ -0,0 +1,33 @@
+// Constant buffer of filt_terrain.hlsl (ops slope, curvature, aspect, hillshade).
+#ifndef GPU_FILT_TERRAIN_PARAMS_HLSLI
+#define GPU_FILT_TERRAIN_PARAMS_HLSLI
+
+struct TerrainParams
+{
+    uint w;
+    uint h;
+    uint z0;
+    uint rows;
+    uint op;          // 0 slope, 1 curvature, 2 aspect, 3 hillshade
+    uint n;           // difference distance in samples (slope, curvature, aspect)
+    uint mode;        // slope: 0 degrees 1 gradient; aspect: 0 facing 1 degrees; curvature: 1 = raw; hillshade: 0 shade 1 lit 2 shadow
+    uint shadows;     // hillshade: cast shadows
+    float cell;
+    float gain;       // curvature gain
+    float degK;       // 180 / pi
+    float ambient;
+    float zf;         // vertical exaggeration
+    float lx;         // light direction
+    float ly;
+    float lz;
+    float dirx;       // azimuth direction on the ground (aspect: the facing direction)
+    float dirz;
+    float tanAlt;
+    float len;        // shadow length in samples
+    float flatK;      // aspect: slope below which the facing fades
+    float d2;         // curvature: (n * cell)^2
+    float pad0;
+    float pad1;
+};
+
+#endif
