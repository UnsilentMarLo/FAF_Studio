From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marlo <Plays.xenon@yahoo.de>
Date: Sat, 17 Oct 2026 16:05:50 +0200
Subject: [PATCH] Editor build: main_ed project, moho/editor natives,
 DirectWrite text backend, pop-out windows, editor fixes

Local editor branch on top of upstream master 13ce9e5 (not pushed). Contains the editor session's work (editor start, ed_* natives, terrain / map / props / decals
natives, GetDepositsAroundPoint in the user lane, Lua factory specialisations moved to one header, wx and D3D9 fixes) together with the text backend and pop-out
prototypes (docs/projects/editor_research/P1..P3 in the workspace repo; the same hunks are saved as editor/engine_patches/text-backend-and-popouts.patch).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

diff --git a/src/sdk/gpg/core/diagnostics/CrashHooks.cpp b/src/sdk/gpg/core/diagnostics/CrashHooks.cpp
index 8eaf75f..259ece3 100644
--- a/src/sdk/gpg/core/diagnostics/CrashHooks.cpp
+++ b/src/sdk/gpg/core/diagnostics/CrashHooks.cpp
@@ -270,7 +270,8 @@ namespace gpg::diag
       static int sFaultBudget = 0;
 
       if (code == kCppException) {
-        if (!sLogThrows || sThrowBudget >= 40) {
+        static const int sThrowLimit = [] { char v[16] = {}; const DWORD n = ::GetEnvironmentVariableA("FAF_LOGTHROW", v, sizeof(v)); const int lim = (n != 0u && n < sizeof(v)) ? std::atoi(v) : 0; return lim > 1 ? lim : 40; }();
+      if (!sLogThrows || sThrowBudget >= sThrowLimit) {
           return EXCEPTION_CONTINUE_SEARCH;
         }
         ++sThrowBudget;
