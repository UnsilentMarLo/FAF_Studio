+  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
+    <ClCompile>
+      <WarningLevel>Level3</WarningLevel>
+      <SDLCheck>true</SDLCheck>
+      <!-- Keep /Od - stepping and local-variable inspection are the whole point
+           of this configuration - but drop the three costs that buy nothing
+           here. The movie decoder is the worst case: it is built out of small
+           helpers, templates and lambdas, so with inlining off every 8-byte
+           std::memcpy and every per-row lambda becomes a real call, and /JMC
+           and /RTC1 then add their own prologue work to each of those calls.
+           Verified on the former movie decoder: the stock Debug flags emit
+           __CheckForDebuggerJustMyCode and _RTC_CheckStackVars throughout;
+           with these settings both are gone and the object is 26% smaller.
+           /Ob1 only expands functions already marked inline (or defined in a
+           class body), so nothing the debugger needs to step through moves. -->
+      <Optimization>Disabled</Optimization>
+      <InlineFunctionExpansion>OnlyExplicitInline</InlineFunctionExpansion>
+      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
+      <SupportJustMyCode>false</SupportJustMyCode>
+      <!-- _ITERATOR_DEBUG_LEVEL is not set by either configuration, so it
+           defaults to 2 here (from _DEBUG) and 0 in Release. Checked iterators
+           are not worth their cost in a build whose job is to run the engine,
+           and the mismatch is a hazard in its own right: it changes the size of
+           every std container, so any binary-layout struct holding one has a
+           different layout in the two configurations. Pinning it to 0 both
+           speeds Debug up across the whole engine and makes those layouts
+           agree.
+
+           This has to match every static library linked in below. Only one of
+           them carries std containers: WildMagic's Foundation.lib. Its project
+           lives outside the repo tree (dependencies\WildMagic3p8\Foundation\
+           Foundation.vcxproj is not tracked), so if you are setting this
+           checkout up fresh, add _ITERATOR_DEBUG_LEVEL=0 to that project's
+           Debug|Win32 PreprocessorDefinitions and rebuild it. You cannot get
+           this wrong silently - MSVC records the level per object and the
+           linker rejects a mismatch with LNK2038, naming Wm3System.obj,
+           Wm3Math.obj and Wm3Vector3.obj. -->
+      <PreprocessorDefinitions>WIN32;_DEBUG;_ITERATOR_DEBUG_LEVEL=0;_WINDOWS;WIN32_LEAN_AND_MEAN;NOMINMAX;LUAPLUS_LIB;BOOST_ALL_NO_LIB;BOOST_NO_AUTO_PTR;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
+      <ConformanceMode>true</ConformanceMode>
+      <LanguageStandard>stdcpp20</LanguageStandard>
+      <LanguageStandard_C>stdc17</LanguageStandard_C>
+      <ExceptionHandling>SyncCThrow</ExceptionHandling>
+      <AdditionalOptions>/MP4 /FS %(AdditionalOptions)</AdditionalOptions>
+      <DisableSpecificWarnings>4073;4244;4273;4834;4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
+      <AdditionalIncludeDirectories>$(FafFfmpegRoot)\include;$(FafRepoRoot)src\sdk;$(FafRepoRoot)dependencies\LuaPlus_Build1081\Src\LuaPlus\include;$(FafRepoRoot)dependencies\boost_1_34_1;$(FafRepoRoot)dependencies\zlib-1.2.3\include;$(FafRepoRoot)dependencies\wxWindows-2.4.2\include;$(FafRepoRoot)dependencies\wxWindows-2.4.2\lib\mswu;$(Wm3IncludePath);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
+    </ClCompile>
+    <Link>
+      <SubSystem>Windows</SubSystem>
+      <GenerateDebugInformation>true</GenerateDebugInformation>
+      <AdditionalLibraryDirectories>$(FafFfmpegRoot)\lib;$(DirectXLibX86);$(FafRepoRoot)dependencies\wxWindows-2.4.2\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
+      <AdditionalDependencies>avformat.lib;avcodec.lib;avutil.lib;swscale.lib;swresample.lib;ws2_32.lib;d3d9.lib;d3dx9.lib;d3d10.lib;dxgi.lib;dxguid.lib;dsound.lib;x3daudio.lib;legacy_stdio_definitions.lib;legacy_stdio_wide_specifiers.lib;dbghelp.lib;winmm.lib;version.lib;comctl32.lib;shlwapi.lib;faultrep.lib;zlib.lib;wxmswu.lib;regex.lib;png.lib;jpeg.lib;tiff.lib;%(AdditionalDependencies)</AdditionalDependencies>
+      <AdditionalOptions>/IGNORE:4006 %(AdditionalOptions)</AdditionalOptions>
+      <IgnoreSpecificDefaultLibraries>msvcrt.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
+      <ForceFileOutput>Enabled</ForceFileOutput>
+      <!-- Both taken from the shipped binary's PE header, read with
+           `dumpbin /HEADERS ForgedAlliance.exe`:
+
+             characteristics  0x123  (RELOCS_STRIPPED | EXECUTABLE_IMAGE |
+                                      LARGE_ADDRESS_AWARE | 32BIT_MACHINE)
+             stack reserve    0x1E8480  (2,000,000 - a round decimal, so the
+                                         original link was /STACK:2000000)
+
+           Ours were 0x102 and 0x100000: no LARGE_ADDRESS_AWARE, default 1 MB
+           stack. Without the flag this 32-bit process is capped at a 2 GB user
+           address space where retail gets 4 GB on a 64-bit host, and that
+           ceiling is what the allocator falls off - `AllocateFreeRegion`
+           (0x00958660) discards `VirtualAlloc`'s return value, faithfully to
+           the binary, so a failed commit is returned as a live pointer into
+           reserved-but-uncommitted memory. The observed fault address was
+           0x592B5600, already 1.49 GB in. -->
+      <LargeAddressAware>true</LargeAddressAware>
+      <StackReserveSize>2000000</StackReserveSize>
+    </Link>
+    <PostBuildEvent Condition="'$(FafStageToRunDir)' == 'true'">
+      <Message>Staging $(TargetFileName) into $(FafRunDir) for F5</Message>
+      <Command>if exist "$(FafRunDir)" xcopy /D /Y /Q "$(TargetPath)" "$(FafRunDir)" &gt;nul
+if exist "$(FafRunDir)" if exist "$(TargetDir)$(TargetName).pdb" xcopy /D /Y /Q "$(TargetDir)$(TargetName).pdb" "$(FafRunDir)" &gt;nul</Command>
+    </PostBuildEvent>
+  </ItemDefinitionGroup>
+  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
+    <ClCompile>
+      <WarningLevel>Level3</WarningLevel>
+      <FunctionLevelLinking>true</FunctionLevelLinking>
+      <IntrinsicFunctions>true</IntrinsicFunctions>
+      <SDLCheck>true</SDLCheck>
+      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;WIN32_LEAN_AND_MEAN;NOMINMAX;LUAPLUS_LIB;BOOST_ALL_NO_LIB;BOOST_NO_AUTO_PTR;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
+      <ConformanceMode>true</ConformanceMode>
+      <LanguageStandard>stdcpp20</LanguageStandard>
+      <LanguageStandard_C>stdc17</LanguageStandard_C>
+      <ExceptionHandling>SyncCThrow</ExceptionHandling>
+      <AdditionalOptions>/MP4 /FS %(AdditionalOptions)</AdditionalOptions>
+      <DisableSpecificWarnings>4073;4244;4273;4834;4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
+      <AdditionalIncludeDirectories>$(FafFfmpegRoot)\include;$(FafRepoRoot)src\sdk;$(FafRepoRoot)dependencies\LuaPlus_Build1081\Src\LuaPlus\include;$(FafRepoRoot)dependencies\boost_1_34_1;$(FafRepoRoot)dependencies\zlib-1.2.3\include;$(FafRepoRoot)dependencies\wxWindows-2.4.2\include;$(FafRepoRoot)dependencies\wxWindows-2.4.2\lib\mswu;$(Wm3IncludePath);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
+    </ClCompile>
+    <Link>
+      <SubSystem>Windows</SubSystem>
+      <GenerateDebugInformation>true</GenerateDebugInformation>
+      <AdditionalLibraryDirectories>$(FafFfmpegRoot)\lib;$(DirectXLibX86);$(FafRepoRoot)dependencies\wxWindows-2.4.2\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
+      <AdditionalDependencies>avformat.lib;avcodec.lib;avutil.lib;swscale.lib;swresample.lib;ws2_32.lib;d3d9.lib;d3dx9.lib;d3d10.lib;dxgi.lib;dxguid.lib;dsound.lib;x3daudio.lib;legacy_stdio_definitions.lib;legacy_stdio_wide_specifiers.lib;dbghelp.lib;winmm.lib;version.lib;comctl32.lib;shlwapi.lib;faultrep.lib;zlib.lib;wxmswu.lib;regex.lib;png.lib;jpeg.lib;tiff.lib;%(AdditionalDependencies)</AdditionalDependencies>
+      <AdditionalOptions>/IGNORE:4006 %(AdditionalOptions)</AdditionalOptions>
+      <!-- Mirror of the Debug link, which excludes the release CRT so nothing
+           can drag it in beside the debug one. This configuration uses the
+           release CRT, so it is the debug CRT that has to go: excluding
+           msvcrt.lib here removed this build's own CRT and left ~297
+           unresolved externals, most of them compiler EH helpers. -->
+      <IgnoreSpecificDefaultLibraries>msvcrtd.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
+      <ForceFileOutput>Enabled</ForceFileOutput>
+      <!-- See the Debug|Win32 link block above: both values come from the
+           shipped binary's PE header (characteristics 0x123, stack reserve
+           0x1E8480). -->
+      <LargeAddressAware>true</LargeAddressAware>
+      <StackReserveSize>2000000</StackReserveSize>
+    </Link>
+    <PostBuildEvent Condition="'$(FafStageToRunDir)' == 'true'">
+      <Message>Staging $(TargetFileName) into $(FafRunDir) for F5</Message>
+      <Command>if exist "$(FafRunDir)" xcopy /D /Y /Q "$(TargetPath)" "$(FafRunDir)" &gt;nul
+if exist "$(FafRunDir)" if exist "$(TargetDir)$(TargetName).pdb" xcopy /D /Y /Q "$(TargetDir)$(TargetName).pdb" "$(FafRunDir)" &gt;nul</Command>
+    </PostBuildEvent>
+  </ItemDefinitionGroup>
+  <!-- The x64 configurations mirror the Win32 ones above, with four
+       differences:
+
+         - platform\X64LayoutAsserts.h is force-included. It switches off the
+           Win32 layout static_asserts, which describe the x86 image and fail
+           on every pointer-bearing type once pointers are 8 bytes.
+         - wx and its png/jpeg/tiff/regex libraries come from
+           wxWindows-2.4.2\lib\x64 (the same patched Unicode build, compiled
+           for x64). zlib is the real 1.2.3 from dependencies\zlib-1.2.3, which
+           is x64-only and is the version the shipped binary carries.
+         - /LARGEADDRESSAWARE:NO keeps every address below 2 GB. The recovered
+           code still stores pointers in 32-bit words in places (reflection
+           serializer callbacks take the object as an int, the allocator's
+           page-owner map covers exactly 4 GB); below 2 GB those round-trip
+           exactly. FafX64LargeAddress=heap|full (above) builds the
+           large-address-aware main_x64_la.exe for finding the rest.
+         - 4 MB of stack instead of the binary's 2 MB: every frame that
+           holds pointers is bigger. -->
+  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
+    <ClCompile>
+      <WarningLevel>Level3</WarningLevel>
+      <SDLCheck>true</SDLCheck>
+      <Optimization>Disabled</Optimization>
+      <InlineFunctionExpansion>OnlyExplicitInline</InlineFunctionExpansion>
+      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
+      <SupportJustMyCode>false</SupportJustMyCode>
+      <PreprocessorDefinitions>WIN32;_DEBUG;_ITERATOR_DEBUG_LEVEL=0;_WINDOWS;WIN32_LEAN_AND_MEAN;NOMINMAX;LUAPLUS_LIB;BOOST_ALL_NO_LIB;BOOST_NO_AUTO_PTR;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
+      <ForcedIncludeFiles>platform\X64LayoutAsserts.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
+      <ConformanceMode>true</ConformanceMode>
+      <LanguageStandard>stdcpp20</LanguageStandard>
+      <LanguageStandard_C>stdc17</LanguageStandard_C>
+      <ExceptionHandling>SyncCThrow</ExceptionHandling>
+      <AdditionalOptions>/MP4 /FS %(AdditionalOptions)</AdditionalOptions>
+      <DisableSpecificWarnings>4073;4244;4273;4834;4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
+      <AdditionalIncludeDirectories>$(FafFfmpegRoot)\include;$(FafRepoRoot)src\sdk;$(FafRepoRoot)dependencies\LuaPlus_Build1081\Src\LuaPlus\include;$(FafRepoRoot)dependencies\boost_1_34_1;$(FafRepoRoot)dependencies\zlib-1.2.3\include;$(FafRepoRoot)dependencies\wxWindows-2.4.2\include;$(FafRepoRoot)dependencies\wxWindows-2.4.2\lib\mswu;$(Wm3IncludePath);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
+    </ClCompile>
+    <Link>
+      <SubSystem>Windows</SubSystem>
