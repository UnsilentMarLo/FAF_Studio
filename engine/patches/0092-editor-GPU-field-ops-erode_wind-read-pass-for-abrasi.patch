       return OpResult::Done;
     }
 
+    // ---- erode_wind ---------------------------------------------------------------------------------------------------------------------------------
+
+    OpResult OpWindGpu(Executor& ex, const OpArgs& a, Grid& out, std::string& err)
+    {
+      const Grid* src = Source(a);
+      const Grid* sand0 = In(a, "b");
+      if (src == nullptr || (sand0 != nullptr && !sand0->SameShape(*src))) return OpResult::Unsupported;
+      const std::string want = a.p.S("output", "height");
+      if (want != "height" && want != "sand" && want != "abrasion") return OpResult::Unsupported;
+      const int iterations = ItersOf(a, 40);
+      if (iterations == 0) return OpResult::Unsupported;
+      const int w = src->w, h = src->h;
+      const std::size_t n = src->Count();
+      if (!Fits(ex, n, 12)) return OpResult::Unsupported;
+      const KernelInfo* ka = FindKernel("field_wind_a");
+      const KernelInfo* kb = FindKernel("field_wind_b");
+      if (ka == nullptr || kb == nullptr) { err = "kernel field_wind_a / field_wind_b is missing"; return OpResult::Failed; }
+      const double az = a.p.N("azimuth", 0.0) * field::t7::kPiD / 180.0;
+      hk::WindParams p{};
+      p.w = static_cast<std::uint32_t>(w);
+      p.h = static_cast<std::uint32_t>(h);
+      p.cell = src->cell;
+      p.windx = static_cast<float>(std::cos(az));
+      p.windz = static_cast<float>(std::sin(az));
+      p.awx = std::fabs(p.windx);
+      p.awz = std::fabs(p.windz);
+      p.speed = std::max(0.0f, std::min(0.7f, static_cast<float>(a.p.N("speed", 0.5))));
+      p.abrade = std::max(0.0f, static_cast<float>(a.p.N("abrade", 0.02)));
+      p.drag = std::max(0.0f, static_cast<float>(a.p.N("drag", 1.5)));
+      const float repose = std::max(0.05f, static_cast<float>(a.p.N("repose", 0.62)));
+      const float sandConst = std::max(0.0f, static_cast<float>(a.p.N("sand", 0.5)));
+      std::vector<float> sandV(n), rockV(n);
+      for (std::size_t i = 0; i < n; ++i) {
+        sandV[i] = std::max(0.0f, sand0 != nullptr ? sand0->v[i] : sandConst);
+        rockV[i] = src->v[i] - sandV[i];
+      }
+      PingPong sand;
+      Field rock, wear, take, vel;
+      if (!MakeField(ex, w, h, sand.f[0], err) || !MakeField(ex, w, h, sand.f[1], err) || !MakeField(ex, w, h, rock, err) || !UploadField(ex, sand.f[0], sandV.data(), err) ||
+          !UploadField(ex, rock, rockV.data(), err) || !MakeField(ex, w, h, wear, err) || !FillBuffer(ex, wear.R(), 0u, err) || !MakeField(ex, w, h, take, err) || !MakeField(ex, w, h, vel, err)) {
+        return OpResult::Failed;
+      }
+      Slider sl;   // the sand slides at the angle of repose on the rock, always at rate 0.5 (as the CPU op)
+      if (!sl.Init(ex, w, h, err)) return OpResult::Failed;
+      sl.p.cell = src->cell;
+      sl.p.rate = 0.5f;
+      sl.p.talus = repose;
+      sl.p.hasRock = 1;
+      sl.rock = &rock.R();
+      const bool ok = RunIterations(ex, static_cast<u32>(iterations), 60.0, [&](const u32, std::string& e) {
+        Bindings ba;
+        ba.Srv(0, rock.R()).Srv(1, sand.Src().R()).Uav(0, take.R()).Uav(1, vel.R());
+        if (!DispatchGrid(ex, *ka, p.w, p.h, p, ba, e)) return false;
+        Bindings bb;
+        bb.Srv(0, sand.Src().R()).Srv(1, take.R()).Srv(2, vel.R()).Uav(0, sand.Dst().R()).Uav(1, rock.R()).Uav(2, wear.R());
+        if (!DispatchGrid(ex, *kb, p.w, p.h, p, bb, e)) return false;
+        sand.Flip();
+        if (!sl.Step(ex, sand.Src().R(), sand.Dst().R(), e)) return false;
+        sand.Flip();
+        return true;
+      }, err);
+      if (!ok) return OpResult::Failed;
+      Grid gSand = LikeOf(*src), gRock = LikeOf(*src), gWear = LikeOf(*src);
+      if (!DownloadGrid(ex, sand.Src(), gSand, err) || !DownloadGrid(ex, rock, gRock, err) || !DownloadGrid(ex, wear, gWear, err)) return OpResult::Failed;
+      std::map<std::string, Grid> all;
+      all["height"] = LikeOf(*src);
+      all["sand"] = LikeOf(*src);
+      all["abrasion"] = LikeOf(*src);
+      for (std::size_t i = 0; i < n; ++i) {
+        all["height"].v[i] = gRock.v[i] + gSand.v[i];
+        all["sand"].v[i] = gSand.v[i];
+        all["abrasion"].v[i] = Clamp01(gWear.v[i]);
+      }
+      Grid result;
+      if (!Emit(a, result, all, "height")) return OpResult::Unsupported;
+      out = std::move(result);
+      return OpResult::Done;
+    }
+
     struct Registrar
     {
       Registrar()
       {
+        RegisterGpuOp("erode_wind", &OpWindGpu, 16384.0f);
         RegisterGpuOp("erode_snow", &OpSnowGpu, 16384.0f);
         RegisterGpuOp("erode_rocksoil", &OpRockSoilGpu, 16384.0f);
         RegisterGpuOp("settle", &OpSettleGpu, 16384.0f);
diff --git a/src/sdk/moho/editor/EdGpuShaders.generated.h b/src/sdk/moho/editor/EdGpuShaders.generated.h
index f3c515a..429b3ba 100644
--- a/src/sdk/moho/editor/EdGpuShaders.generated.h
+++ b/src/sdk/moho/editor/EdGpuShaders.generated.h
@@ -4227,6 +4227,330 @@ void CSMain(KERNEL_IDS)
     soil[i] = soil[i] + d;
 }
 
+)HLSL";
+
+  // field_wind_a: 16x16x1 threads
+  inline constexpr char kSource_field_wind_a[] =
+    R"HLSL(// HLSL side of the kernel language (docs/projects/editor/GPU_COMPUTE.md). scripts/gen_gpu_shaders.py puts this file in front of every kernel it embeds; the C++ test shim
+// (hlsl_cpp_shim.h) defines the SAME macro names for g++ / MSVC. A kernel therefore never writes cbuffer, register(), StructuredBuffer, [numthreads], SV_ or groupshared itself.
+//
+// Resource slots: constant buffer b0 (one per kernel), shader resource views t0..t15, unordered access views u0..u7, samplers s0 (linear, clamp) and s1 (point, clamp).
+// The SRV slot numbers are shared between buffers and textures (SRV_BUFFER(.., 0) and SRV_TEX(.., 0) would collide), the same for UAVs.
+
+#define CBUFFER(Type, name, slot) cbuffer name##_cb : register(b##slot) { Type name; };
+#define SRV_BUFFER(T, name, slot) StructuredBuffer<T> name : register(t##slot);
+#define UAV_BUFFER(T, name, slot) RWStructuredBuffer<T> name : register(u##slot);
+#define SRV_TEX(name, slot) Texture2D<float> name : register(t##slot);
+#define UAV_TEX(name, slot) RWTexture2D<float> name : register(u##slot);
+#define SAMPLER(name, slot) SamplerState name : register(s##slot);
+#define GROUPSHARED(T, name, n) groupshared T name[n];
+#define NUMTHREADS(x, y, z) [numthreads(x, y, z)]
+#define KERNEL_IDS uint3 dtid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID, uint gidx : SV_GroupIndex
+
+// Kernels with group shared memory split their body into phases at top level: PHASES_BEGIN, code, BARRIER(); code, ..., PHASES_END. Every phase is its own scope (a local does not
+// live across a BARRIER, on the GPU as in the emulation).
+#define PHASES_BEGIN {
+#define BARRIER() GroupMemoryBarrierWithGroupSync(); } {
+#define PHASES_END }
+
+#define UNROLL [unroll]
+#define LOOP [loop]
+#define OUT(T) out T
+#define INOUT(T) inout T
+#define FN
+
+// Op erode_wind (EdFieldEro2.cpp OpWind), the read-only pass of one step: from the surface (rock + sand) the slope along the wind, the rock abraded where sand is thin and the wind blows
+// uphill (take) and the carrying speed (vel). Pass B applies and transports.
+// ---- begin filt_common.hlsli
+// Helpers of the filter kernels (filt_*.hlsl). Every filter kernel has a constant buffer P that starts with  uint w, h, z0, rows;  (field size, first row and number of rows of this dispatch) and
+// reads the source field from a structured buffer. Functions that read a buffer cannot take it as an argument in the kernel subset, so they are macros that define a function for the buffer
+// whose name is given (the function reads P.w / P.h, so define it after the CBUFFER).
+#ifndef GPU_FILT_COMMON_HLSLI
+#define GPU_FILT_COMMON_HLSLI
+
+// ---- begin common.hlsli
+// Helpers every kernel may use. Plain functions and constants only (this file is compiled as HLSL and as C++ by the test shim). Include it with #include "common.hlsli".
+#ifndef GPU_COMMON_HLSLI
+#define GPU_COMMON_HLSLI
+
+// Row-major index of sample (x, z) in a field of width w.
+FN uint FieldIndex(uint x, uint z, uint w)
+{
+    return z * w + x;
+}
+
+// Integer clamp of a lookup coordinate to 0..n-1 (the CPU ops' "clamp" edge mode).
+FN int ClampIndex(int i, int n)
+{
+    return max(0, min(n - 1, i));
+}
+
+// 32 bit integer hash (lowbias32): equal bits on the CPU and on the GPU.
+FN uint Hash32(uint x)
+{
+    x ^= x >> 16;
+    x *= 0x7feb352du;
+    x ^= x >> 15;
+    x *= 0x846ca68bu;
+    x ^= x >> 16;
+    return x;
+}
+
+// A hash as a float in 0..1 (24 bit steps, exact in float32).
+FN float HashToUnit(uint h)
+{
+    return float(h >> 8) * (1.0f / 16777216.0f);
+}
+
+#endif
+// ---- end common.hlsli
+
+// EdFieldUtil.h SmoothStep (an empty edge range is a step).
+FN float SmoothStep(float e0, float e1, float v)
+{
+    if (e1 == e0) return v < e0 ? 0.0f : 1.0f;
+    float t = saturate((v - e0) / (e1 - e0));
+    return t * t * (3.0f - 2.0f * t);
+}
+
+// BilinearC(gx, gz): bilinear sample of buffer BUF at fractional sample coordinates, clamped edges (EdFieldUtil.h BilinearC).
+#define DEFINE_BILINEAR_C(BUF)                                                                  \
+    FN float BilinearC(float gx, float gz)                                                      \
+    {                                                                                           \
+        float mx = float(P.w - 1u);                                                             \
+        float mz = float(P.h - 1u);                                                             \
+        float cx = gx < 0.0f ? 0.0f : (gx > mx ? mx : gx);                                      \
+        float cz = gz < 0.0f ? 0.0f : (gz > mz ? mz : gz);                                      \
+        int ix = int(cx);                                                                       \
+        int iz = int(cz);                                                                       \
+        if (ix >= int(P.w) - 1) ix = max(0, int(P.w) - 2);                                      \
+        if (iz >= int(P.h) - 1) iz = max(0, int(P.h) - 2);                                      \
+        float tx = cx - float(ix);                                                              \
+        float tz = cz - float(iz);                                                              \
+        int ix1 = min(int(P.w) - 1, ix + 1);                                                    \
+        int iz1 = min(int(P.h) - 1, iz + 1);                                                    \
+        uint r0 = uint(iz) * P.w;                                                               \
+        uint r1 = uint(iz1) * P.w;                                                              \
+        float a0 = BUF[r0 + uint(ix)];                                                          \
+        float a1 = BUF[r0 + uint(ix1)];                                                         \
+        float b0 = BUF[r1 + uint(ix)];                                                          \
+        float b1 = BUF[r1 + uint(ix1)];                                                         \
+        float top = a0 + (a1 - a0) * tx;                                                        \
+        float bottom = b0 + (b1 - b0) * tx;                                                     \
+        return top + (bottom - top) * tz;                                                       \
+    }
+
+// GradientAt(x, z, gx, gz): central difference gradient (rise per run, P.cell world units per sample) with clamped edges (EdFieldUtil.h GradientAt).
+#define DEFINE_GRADIENT_AT(BUF)                                                                 \
+    FN void GradientAt(int x, int z, OUT(float) gx, OUT(float) gz)                              \
+    {                                                                                           \
+        int x0 = max(0, x - 1);                                                                 \
+        int x1 = min(int(P.w) - 1, x + 1);                                                      \
+        int z0 = max(0, z - 1);                                                                 \
+        int z1 = min(int(P.h) - 1, z + 1);                                                      \
+        gx = 0.0f;                                                                              \
+        gz = 0.0f;                                                                              \
+        if (x1 > x0) gx = (BUF[uint(z) * P.w + uint(x1)] - BUF[uint(z) * P.w + uint(x0)]) / (float(x1 - x0) * P.cell); \
+        if (z1 > z0) gz = (BUF[uint(z1) * P.w + uint(x)] - BUF[uint(z0) * P.w + uint(x)]) / (float(z1 - z0) * P.cell); \
+    }
+
+#endif
+// ---- end filt_common.hlsli
+// ---- begin field_wind_params.hlsli
+// Constant buffer of field_wind_a.hlsl and field_wind_b.hlsl (op erode_wind).
+#ifndef GPU_FIELD_WIND_PARAMS_HLSLI
+#define GPU_FIELD_WIND_PARAMS_HLSLI
+
+struct WindParams
+{
+    uint w;
+    uint h;
+    uint pad0;
+    uint pad1;
+    float cell;
+    float windx;        // wind direction (cos, sin of the azimuth)
+    float windz;
+)HLSL"
+    R"HLSL(    float awx;       // |wx|, |wz|
+    float awz;
+    float speed;     // sand speed on level ground, cells per step
+    float abrade;    // most rock abraded per step
+    float drag;      // how fast uphill slows the sand
+};
+
+#endif
+// ---- end field_wind_params.hlsli
+
+CBUFFER(WindParams, P, 0)
+SRV_BUFFER(float, rock, 0)
+SRV_BUFFER(float, sand, 1)
+UAV_BUFFER(float, take, 0)
+UAV_BUFFER(float, vel, 1)
+
+FN float Surf(int x, int z)
+{
+    uint j = uint(z) * P.w + uint(x);
+    return rock[j] + sand[j];
+}
+
+NUMTHREADS(16, 16, 1)
+void CSMain(KERNEL_IDS)
+{
+    if (dtid.x >= P.w || dtid.y >= P.h) return;
+    int x = int(dtid.x);
+    int z = int(dtid.y);
+    int w = int(P.w);
+    int h = int(P.h);
+    uint i = dtid.y * P.w + dtid.x;
+    int xl = max(0, x - 1);
+    int xr = min(w - 1, x + 1);
+    int zu = max(0, z - 1);
+    int zd = min(h - 1, z + 1);
+    float gx = (Surf(xr, z) - Surf(xl, z)) / (2.0f * P.cell);
+    float gz = (Surf(x, zd) - Surf(x, zu)) / (2.0f * P.cell);
+    float ds = gx * P.windx + gz * P.windz;
+    float up = max(0.0f, ds);
+    float bare = 1.0f - SmoothStep(0.0f, 0.5f, sand[i]);
+    take[i] = min(P.abrade * up * bare, P.abrade);
+    vel[i] = P.speed * saturate(1.0f - P.drag * up);
+}
+
+)HLSL";
+
+  // field_wind_b: 16x16x1 threads
+  inline constexpr char kSource_field_wind_b[] =
+    R"HLSL(// HLSL side of the kernel language (docs/projects/editor/GPU_COMPUTE.md). scripts/gen_gpu_shaders.py puts this file in front of every kernel it embeds; the C++ test shim
+// (hlsl_cpp_shim.h) defines the SAME macro names for g++ / MSVC. A kernel therefore never writes cbuffer, register(), StructuredBuffer, [numthreads], SV_ or groupshared itself.
+//
+// Resource slots: constant buffer b0 (one per kernel), shader resource views t0..t15, unordered access views u0..u7, samplers s0 (linear, clamp) and s1 (point, clamp).
+// The SRV slot numbers are shared between buffers and textures (SRV_BUFFER(.., 0) and SRV_TEX(.., 0) would collide), the same for UAVs.
+
+#define CBUFFER(Type, name, slot) cbuffer name##_cb : register(b##slot) { Type name; };
+#define SRV_BUFFER(T, name, slot) StructuredBuffer<T> name : register(t##slot);
+#define UAV_BUFFER(T, name, slot) RWStructuredBuffer<T> name : register(u##slot);
+#define SRV_TEX(name, slot) Texture2D<float> name : register(t##slot);
+#define UAV_TEX(name, slot) RWTexture2D<float> name : register(u##slot);
+#define SAMPLER(name, slot) SamplerState name : register(s##slot);
+#define GROUPSHARED(T, name, n) groupshared T name[n];
+#define NUMTHREADS(x, y, z) [numthreads(x, y, z)]
+#define KERNEL_IDS uint3 dtid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID, uint gidx : SV_GroupIndex
+
+// Kernels with group shared memory split their body into phases at top level: PHASES_BEGIN, code, BARRIER(); code, ..., PHASES_END. Every phase is its own scope (a local does not
+// live across a BARRIER, on the GPU as in the emulation).
+#define PHASES_BEGIN {
+#define BARRIER() GroupMemoryBarrierWithGroupSync(); } {
+#define PHASES_END }
+
+#define UNROLL [unroll]
+#define LOOP [loop]
+#define OUT(T) out T
+#define INOUT(T) inout T
+#define FN
+
+// Op erode_wind (EdFieldEro2.cpp OpWind), the update pass of one step: the abraded rock becomes sand (rock -= take, wear += take, in place), then the sand is carried one step downwind,
+// conservatively: next = sand - (|wx| + |wz|) * vel * sand + what the upwind neighbours (x - sign(wx), z - sign(wz)) send; nothing enters from outside the field. `sand` is the sand
+// before the abrasion, the abraded amount is added here (the same sum the CPU op stores).
+// ---- begin common.hlsli
+// Helpers every kernel may use. Plain functions and constants only (this file is compiled as HLSL and as C++ by the test shim). Include it with #include "common.hlsli".
+#ifndef GPU_COMMON_HLSLI
+#define GPU_COMMON_HLSLI
+
+// Row-major index of sample (x, z) in a field of width w.
+FN uint FieldIndex(uint x, uint z, uint w)
+{
+    return z * w + x;
+}
+
+// Integer clamp of a lookup coordinate to 0..n-1 (the CPU ops' "clamp" edge mode).
+FN int ClampIndex(int i, int n)
+{
+    return max(0, min(n - 1, i));
+}
+
+// 32 bit integer hash (lowbias32): equal bits on the CPU and on the GPU.
+FN uint Hash32(uint x)
+{
+    x ^= x >> 16;
+    x *= 0x7feb352du;
+    x ^= x >> 15;
+    x *= 0x846ca68bu;
+    x ^= x >> 16;
+    return x;
+}
+
+// A hash as a float in 0..1 (24 bit steps, exact in float32).
+FN float HashToUnit(uint h)
+{
+    return float(h >> 8) * (1.0f / 16777216.0f);
+}
+
+#endif
+// ---- end common.hlsli
+// ---- begin field_wind_params.hlsli
+// Constant buffer of field_wind_a.hlsl and field_wind_b.hlsl (op erode_wind).
+#ifndef GPU_FIELD_WIND_PARAMS_HLSLI
+#define GPU_FIELD_WIND_PARAMS_HLSLI
+
+struct WindParams
+{
+    uint w;
+    uint h;
+    uint pad0;
+    uint pad1;
+    float cell;
+    float windx;        // wind direction (cos, sin of the azimuth)
+    float windz;
+    float awx;       // |wx|, |wz|
+    float awz;
+    float speed;     // sand speed on level ground, cells per step
+    float abrade;    // most rock abraded per step
+    float drag;      // how fast uphill slows the sand
+};
+
+#endif
+// ---- end field_wind_params.hlsli
+
+CBUFFER(WindParams, P, 0)
+SRV_BUFFER(float, sand, 0)
+SRV_BUFFER(float, take, 1)
+SRV_BUFFER(float, vel, 2)
+UAV_BUFFER(float, nxt, 0)
+UAV_BUFFER(float, rock, 1)
+UAV_BUFFER(float, wear, 2)
+
+FN float SandAt(uint j)
+{
+    return sand[j] + take[j];
+}
+
+NUMTHREADS(16, 16, 1)
+void CSMain(KERNEL_IDS)
+{
+    if (dtid.x >= P.w || dtid.y >= P.h) return;
+    int x = int(dtid.x);
+    int z = int(dtid.y);
+    int w = int(P.w);
+    int h = int(P.h);
+    uint i = dtid.y * P.w + dtid.x;
+    float inflow = 0.0f;
+    int ux = P.windx > 0.0f ? x - 1 : x + 1;
+    int uz = P.windz > 0.0f ? z - 1 : z + 1;
+    if (P.awx > 0.0f && ux >= 0 && ux < w)
+    {
+        uint j = uint(z) * P.w + uint(ux);
+        inflow += P.awx * vel[j] * SandAt(j);
+    }
+    if (P.awz > 0.0f && uz >= 0 && uz < h)
+    {
+        uint j = uint(uz) * P.w + uint(x);
+        inflow += P.awz * vel[j] * SandAt(j);
+    }
+    float s = SandAt(i);
+    nxt[i] = s - (P.awx + P.awz) * vel[i] * s + inflow;
+    rock[i] = rock[i] - take[i];
+    wear[i] = wear[i] + take[i];
+}
+
 )HLSL";
 
   // filt_bilateral: 16x16x1 threads
@@ -9008,6 +9332,8 @@ void CSMain(KERNEL_IDS)
     {"field_sub", kSource_field_sub, "CSMain", 16u, 16u, 1u, 0x3u, 0x1u, 0x0u, 0x0u, 0x0u, 1u, 0x101759797F1D7EACULL},
